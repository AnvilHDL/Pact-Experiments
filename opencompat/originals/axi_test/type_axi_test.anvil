// AXI test infrastructure (pulp-platform/axi, axi_test.sv; changelog v0.15.1).

// Earlier driver: W only after AW is accepted. The subordinate takes W before AW.
pool axi_test_aw_then_w_pool {
    ep_le -- ep_ri : ch;
    idrv : ep.aw ; ep.w ; ep.b ; #1,
    isub : ep.w ; ep.aw ; ep.b ; #1
}

// Fixed driver: AW and W are independent.
pool axi_test_fixed_pool {
    ep_le -- ep_ri : ch;
    idrv : (ep.aw || ep.w) ; ep.b ; #1,
    isub : ep.w ; ep.aw ; ep.b ; #1
}
