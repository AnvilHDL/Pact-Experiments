// AXI debug BIU (adv_dbg_if, adbg_axi_biu.sv, lines 509-545; pulpino issue #182).
// In S_AXIADDR the manager drives aw_valid and w_valid, but leaves the state only on aw_ready:
// a W accepted before AW is not recorded, so the manager offers W only after AW.

// A legal subordinate that takes W before AW.
pool adbg_axi_biu_pool {
    ep_le -- ep_ri : ch;
    i1 : rec X . ^(
        #ep.aw_req : rec Y . ^(#ep.w_req, * : #1;Y),
        * : #1;X
    );#1,
    i2 : ep.w_req;#1;ep.aw_req;#1
}

// A subordinate that takes AW first.
pool adbg_axi_biu_aw_first_pool {
    ep_le -- ep_ri : ch;
    i1 : rec X . ^(
        #ep.aw_req : rec Y . ^(#ep.w_req, * : #1;Y),
        * : #1;X
    );#1,
    i2 : ep.aw_req;#1;ep.w_req;#1
}
