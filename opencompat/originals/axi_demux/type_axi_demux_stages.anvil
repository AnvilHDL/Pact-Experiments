// AXI demux (pulp-platform/axi), router stages of src/compat/type_demux_write.anvil added one at a time.
// A client sends W before AW; the stages not yet present are left open.
// The client is rejected once 4 of the router pool's 10 participants are present.
import "../../../src/compat/mux_commons.anvilh"

// Legal AXI client: W before AW.
interface client_w_first_itfc(slv_ep_aw : left slv_ch<aw_ch>, slv_ep_w : left slv_ch<w_pack_t>, slv_ep_b : left slv_res_ch<b_pack_t>) =
        F slv_ep_w.req;slv_ep_w.gnt; slv_ep_aw.req;slv_ep_aw.gnt; slv_ep_b.res;#1

// The benchmark's client: AW before W.
interface client_aw_first_itfc(slv_ep_aw : left slv_ch<aw_ch>, slv_ep_w : left slv_ch<w_pack_t>, slv_ep_b : left slv_res_ch<b_pack_t>) =
        F slv_ep_aw.req;slv_ep_aw.gnt; slv_ep_w.req;slv_ep_w.gnt; slv_ep_b.res;#1

// Demux stages, as in src/compat/type_demux_write.anvil.
interface demux_aw_main (
    w_fifo_ep : left fifo_insert_ch<select_t>,
    slv_ep : right slv_ch<aw_ch>,
    mst_ep1 : left mast_ch<aw_pack_t>,
    mst_ep2 : left mast_ch<aw_pack_t>,
    mst_ep3 : left mast_ch<aw_pack_t>,
    mst_ep4 : left mast_ch<aw_pack_t>
) = slv_ep.req ; ((mst_ep1.rdy; rec X . ^(#w_fifo_ep.full : #1;X, * : #w_fifo_ep.push;#mst_ep1.req;#slv_ep.gnt)) ++
                 (mst_ep2.rdy; rec Y . ^(#w_fifo_ep.full : #1;Y, * : #w_fifo_ep.push;#mst_ep2.req;#slv_ep.gnt)) ++
                 (mst_ep3.rdy; rec Z . ^(#w_fifo_ep.full : #1;Z, * : #w_fifo_ep.push;#mst_ep3.req;#slv_ep.gnt)) ++
                 (mst_ep4.rdy; rec W . ^(#w_fifo_ep.full : #1;W, * : #w_fifo_ep.push;#mst_ep4.req;#slv_ep.gnt))

    ) ; #1

interface demux_w_main (
    w_fifo_ep : left fifo_dequeue_ch<select_t>,
    b_fifo_ep : left fifo_insert_ch<select_t>,
    slv_ep : right slv_ch<w_pack_t>,
    mst_ep1 : left mast_ch<w_pack_t>,
    mst_ep2 : left mast_ch<w_pack_t>,
    mst_ep3 : left mast_ch<w_pack_t>,
    mst_ep4 : left mast_ch<w_pack_t>
) = &(
        #w_fifo_ep.empty,
        #b_fifo_ep.full,
              * : ^(#slv_ep.req : #w_fifo_ep.pop ; #b_fifo_ep.push; rec X . ^(
                                #mst_ep1.rdy : (#mst_ep1.req;#slv_ep.gnt) ++ (#1;X),
                                #mst_ep2.rdy : (#mst_ep2.req;#slv_ep.gnt) ++ (#1;X),
                                #mst_ep3.rdy : (#mst_ep3.req;#slv_ep.gnt) ++ (#1;X),
                                #mst_ep4.rdy : (#mst_ep4.req;#slv_ep.gnt) ++ (#1;X),
                                * : #1;X
                            ),
                    *)
    ) ; #1

pool demux_w_first_2 {
    slv_ep_aw -- slv_ep_aw_ri : slv_ch<aw_ch>,
    slv_ep_w -- slv_ep_w_ri : slv_ch<w_pack_t>,
    slv_ep_b -- slv_ep_b_ri : slv_res_ch<b_pack_t>,
    mst_ep1_aw -- mst_ep1_aw_ri : mast_ch<aw_pack_t>,
    mst_ep2_aw -- mst_ep2_aw_ri : mast_ch<aw_pack_t>,
    mst_ep3_aw -- mst_ep3_aw_ri : mast_ch<aw_pack_t>,
    mst_ep4_aw -- mst_ep4_aw_ri : mast_ch<aw_pack_t>,
    mst_ep1_w -- mst_ep1_w_ri : mast_ch<w_pack_t>,
    mst_ep2_w -- mst_ep2_w_ri : mast_ch<w_pack_t>,
    mst_ep3_w -- mst_ep3_w_ri : mast_ch<w_pack_t>,
    mst_ep4_w -- mst_ep4_w_ri : mast_ch<w_pack_t>,
    w_fifo_push -- w_fifo_push_ri : fifo_insert_ch<select_t>,
    w_fifo_pop -- w_fifo_pop_ri : fifo_dequeue_ch<select_t>,
    b_fifo_push -- b_fifo_push_ri : fifo_insert_ch<select_t>;

    iclient : client_w_first_itfc(slv_ep_aw, slv_ep_w, slv_ep_b),
    iaw : demux_aw_main(w_fifo_push, slv_ep_aw_ri, mst_ep1_aw, mst_ep2_aw, mst_ep3_aw, mst_ep4_aw)
}

pool demux_w_first_3 {
    slv_ep_aw -- slv_ep_aw_ri : slv_ch<aw_ch>,
    slv_ep_w -- slv_ep_w_ri : slv_ch<w_pack_t>,
    slv_ep_b -- slv_ep_b_ri : slv_res_ch<b_pack_t>,
    mst_ep1_aw -- mst_ep1_aw_ri : mast_ch<aw_pack_t>,
    mst_ep2_aw -- mst_ep2_aw_ri : mast_ch<aw_pack_t>,
    mst_ep3_aw -- mst_ep3_aw_ri : mast_ch<aw_pack_t>,
    mst_ep4_aw -- mst_ep4_aw_ri : mast_ch<aw_pack_t>,
    mst_ep1_w -- mst_ep1_w_ri : mast_ch<w_pack_t>,
    mst_ep2_w -- mst_ep2_w_ri : mast_ch<w_pack_t>,
    mst_ep3_w -- mst_ep3_w_ri : mast_ch<w_pack_t>,
    mst_ep4_w -- mst_ep4_w_ri : mast_ch<w_pack_t>,
    w_fifo_push -- w_fifo_push_ri : fifo_insert_ch<select_t>,
    w_fifo_pop -- w_fifo_pop_ri : fifo_dequeue_ch<select_t>,
    b_fifo_push -- b_fifo_push_ri : fifo_insert_ch<select_t>;

    iclient : client_w_first_itfc(slv_ep_aw, slv_ep_w, slv_ep_b),
    iaw : demux_aw_main(w_fifo_push, slv_ep_aw_ri, mst_ep1_aw, mst_ep2_aw, mst_ep3_aw, mst_ep4_aw),
    iw : demux_w_main(w_fifo_pop, b_fifo_push, slv_ep_w_ri, mst_ep1_w, mst_ep2_w, mst_ep3_w, mst_ep4_w)
}

pool demux_w_first_4 {
    slv_ep_aw -- slv_ep_aw_ri : slv_ch<aw_ch>,
    slv_ep_w -- slv_ep_w_ri : slv_ch<w_pack_t>,
    slv_ep_b -- slv_ep_b_ri : slv_res_ch<b_pack_t>,
    mst_ep1_aw -- mst_ep1_aw_ri : mast_ch<aw_pack_t>,
    mst_ep2_aw -- mst_ep2_aw_ri : mast_ch<aw_pack_t>,
    mst_ep3_aw -- mst_ep3_aw_ri : mast_ch<aw_pack_t>,
    mst_ep4_aw -- mst_ep4_aw_ri : mast_ch<aw_pack_t>,
    mst_ep1_w -- mst_ep1_w_ri : mast_ch<w_pack_t>,
    mst_ep2_w -- mst_ep2_w_ri : mast_ch<w_pack_t>,
    mst_ep3_w -- mst_ep3_w_ri : mast_ch<w_pack_t>,
    mst_ep4_w -- mst_ep4_w_ri : mast_ch<w_pack_t>,
    w_fifo_push -- w_fifo_push_ri : fifo_insert_ch<select_t>,
    w_fifo_pop -- w_fifo_pop_ri : fifo_dequeue_ch<select_t>,
    b_fifo_push -- b_fifo_push_ri : fifo_insert_ch<select_t>;

    iclient : client_w_first_itfc(slv_ep_aw, slv_ep_w, slv_ep_b),
    iaw : demux_aw_main(w_fifo_push, slv_ep_aw_ri, mst_ep1_aw, mst_ep2_aw, mst_ep3_aw, mst_ep4_aw),
    iw : demux_w_main(w_fifo_pop, b_fifo_push, slv_ep_w_ri, mst_ep1_w, mst_ep2_w, mst_ep3_w, mst_ep4_w),
    iwf : fifo_itfc(w_fifo_push_ri, w_fifo_pop_ri)
}

pool demux_aw_first_4 {
    slv_ep_aw -- slv_ep_aw_ri : slv_ch<aw_ch>,
    slv_ep_w -- slv_ep_w_ri : slv_ch<w_pack_t>,
    slv_ep_b -- slv_ep_b_ri : slv_res_ch<b_pack_t>,
    mst_ep1_aw -- mst_ep1_aw_ri : mast_ch<aw_pack_t>,
    mst_ep2_aw -- mst_ep2_aw_ri : mast_ch<aw_pack_t>,
    mst_ep3_aw -- mst_ep3_aw_ri : mast_ch<aw_pack_t>,
    mst_ep4_aw -- mst_ep4_aw_ri : mast_ch<aw_pack_t>,
    mst_ep1_w -- mst_ep1_w_ri : mast_ch<w_pack_t>,
    mst_ep2_w -- mst_ep2_w_ri : mast_ch<w_pack_t>,
    mst_ep3_w -- mst_ep3_w_ri : mast_ch<w_pack_t>,
    mst_ep4_w -- mst_ep4_w_ri : mast_ch<w_pack_t>,
    w_fifo_push -- w_fifo_push_ri : fifo_insert_ch<select_t>,
    w_fifo_pop -- w_fifo_pop_ri : fifo_dequeue_ch<select_t>,
    b_fifo_push -- b_fifo_push_ri : fifo_insert_ch<select_t>;

    iclient : client_aw_first_itfc(slv_ep_aw, slv_ep_w, slv_ep_b),
    iaw : demux_aw_main(w_fifo_push, slv_ep_aw_ri, mst_ep1_aw, mst_ep2_aw, mst_ep3_aw, mst_ep4_aw),
    iw : demux_w_main(w_fifo_pop, b_fifo_push, slv_ep_w_ri, mst_ep1_w, mst_ep2_w, mst_ep3_w, mst_ep4_w),
    iwf : fifo_itfc(w_fifo_push_ri, w_fifo_pop_ri)
}

chan fifo_insert_ch<Tp : type> {
    right push : (Tp@#1),
    left full : (void@#1)
}

chan fifo_dequeue_ch<Tp : type> {
    left pop : (Tp@#1) ,
    left empty : (void@#1)
}

type prot_t = logic[3];
type resp_t = logic[2];
type strb_t = logic[4];

type select_t = logic[2];
type A = logic[32];
type T = logic[32];
type byte = logic[32];

struct aw_pack_t {
    addr : A,
    prot : prot_t
}

struct w_pack_t {
    data : T,
    strb : strb_t
}

struct b_pack_t {
    resp : resp_t
}

struct aw_ch {
    aw_pack : aw_pack_t,
    select : select_t
}

chan slv_ch<Tp : type> {
    right req : (Tp@gnt+1),
    left gnt : (void@#1)
}

chan slv_res_ch<Tp : type> {
    left res : (Tp@#1)
}

chan mast_ch<Tp : type> {
    left rdy : (void@#1),
    right req : (Tp@#1)
}

chan mast_res_ch<Tp : type> {
    right rdy : (void@#1),
    right res : (Tp@#1)
}
