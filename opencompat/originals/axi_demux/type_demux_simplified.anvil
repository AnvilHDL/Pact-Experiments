// AXI demux (pulp-platform/axi, axi_demux.sv): W is routed by the select decoded from AW.
// One type for the demux's write path; the four masters are left open.

// A client that sends W before AW.
pool demux_simplified_w_first_pool {
    ep_le -- ep_ri : ch;
    i1 : slv.awreq;#1;((mst1.aw_req;slv.wreq;mst1.wreq;#1;mst1.b_req)
                     + (mst2.aw_req;slv.wreq;mst2.wreq;#1;mst2.b_req)
                     + (mst3.aw_req;slv.wreq;mst3.wreq;#1;mst3.b_req)
                     + (mst4.aw_req;slv.wreq;mst4.wreq;#1;mst4.b_req));slv.b_res;#1,
    i2 : slv.wreq;slv.awreq;#1;#1;slv.b_res;#1
}

// A client that sends AW before W.
pool demux_simplified_aw_first_pool {
    ep_le -- ep_ri : ch;
    i1 : slv.awreq;#1;((mst1.aw_req;slv.wreq;mst1.wreq;#1;mst1.b_req)
                     + (mst2.aw_req;slv.wreq;mst2.wreq;#1;mst2.b_req)
                     + (mst3.aw_req;slv.wreq;mst3.wreq;#1;mst3.b_req)
                     + (mst4.aw_req;slv.wreq;mst4.wreq;#1;mst4.b_req));slv.b_res;#1,
    i2 : slv.awreq;slv.wreq;#1;#1;slv.b_res;#1
}
