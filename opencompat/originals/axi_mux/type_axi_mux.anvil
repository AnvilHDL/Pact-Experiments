// Structural PACT type for axi_mux.sv.
//
// This follows the same style as axi_demux/type_demux_simplified.anvil: model
// the component boundary with AW/W/B and AR/R channels, plus the internal
// arbitration/FIFO interfaces needed to express the mux protocol.
//
// The only value-sensitive part of the real RTL that is not directly expressible
// in this type language is "decode the top bits of b.id/r.id".  The b/r payloads
// below carry those id fields in b_pack_t/r_pack_t; mux_b_main and mux_r_main
// keep the real channel shape and expose the two possible selected slave ports.

interface fifo_itfc(push_ep : right fifo_insert_ch<select_t>, pop_ep : right fifo_dequeue_ch<select_t>) =
    (
        rec X . (^(push_ep.full, *); ^(
            pop_ep.pop : #1 ; (&(push_ep.push, pop_ep.pop) + (
                rec Z . (^(pop_ep.empty, *); ^(
                    push_ep.push,
                    * : #1 ; Z
                ))
            )) ; #1,
            * : #1 ; X
        ))
    )
  + (
        rec Y . (^(pop_ep.empty, *); ^(
            push_ep.push : #1 ; (&(push_ep.push, pop_ep.pop) + (
                rec K . (^(push_ep.full, *); ^(
                    pop_ep.pop,
                    * : #1 ; K
                ))
            )) ; #1,
            * : #1 ; Y
        ))
    )
  + (
        &(push_ep.push, pop_ep.pop) ; #1
    )

interface slave_write_itfc(
    aw_ep : left slv_addr_ch<aw_pack_t>,
    w_ep  : left slv_w_ch<w_pack_t>,
    b_ep  : left slv_resp_ch<b_pack_t>
) =
    F aw_ep.req ; aw_ep.gnt ;
      rec W . (w_ep.rdy ; ^(w_ep.data, * : #1 ; W)) ;
      rec B . (b_ep.rdy ; ^(b_ep.res, * : #1 ; B)) ; #1

interface master_write_itfc(
    aw_ep : right mst_req_ch<aw_pack_t>,
    w_ep  : right mst_req_ch<w_pack_t>,
    b_ep  : left mst_resp_ch<b_pack_t>
) =
    rec X . (
        (aw_ep.rdy ; aw_ep.req ; #1 ; X)
      + (w_ep.rdy ; w_ep.req ; #1 ; X)
      + (b_ep.rdy ; b_ep.res ; #1 ; X)
    )

interface aw_arbiter_itfc(
    slv_ep1 : right slv_addr_ch<aw_pack_t>,
    slv_ep2 : right slv_addr_ch<aw_pack_t>,
    aw_req_ep : left mux_addr_ch<aw_sel_pack_t>
) =
    ^(
        slv_ep1.req : aw_req_ep.req ; aw_req_ep.gnt ; #slv_ep1.gnt,
        slv_ep2.req : aw_req_ep.req ; aw_req_ep.gnt ; #slv_ep2.gnt,
        *
    ) ; #1

// AW pick pushes W ownership before the downstream AW ready/gnt is required.
interface mux_aw_main(
    aw_req_ep : right mux_addr_ch<aw_sel_pack_t>,
    aw_mst_ep : left mst_req_ch<aw_pack_t>,
    w_fifo_ep : left fifo_insert_ch<select_t>
) =
    ^(
        aw_req_ep.req : rec X . ^(
            w_fifo_ep.full : #1 ; X,
            * : #w_fifo_ep.push ; #aw_mst_ep.req ;
                rec Y . ^(
                    aw_mst_ep.rdy : #aw_req_ep.gnt,
                    * : #1 ; Y
                )
        ),
        *
    ) ; #1

interface mux_w_main(
    slv_ep1 : right slv_w_ch<w_pack_t>,
    slv_ep2 : right slv_w_ch<w_pack_t>,
    w_fifo_ep : left fifo_dequeue_ch<select_t>,
    w_mst_ep : left mst_req_ch<w_pack_t>
) =
    // The RTL pops only when the selected w_pack_t has last=1 and handshakes.
    // The payload carries last; the pop event below marks that last-beat close.
    ^(
        w_fifo_ep.empty,
        * : rec X . ^(
            slv_ep1.rdy : ((#slv_ep1.data ; w_mst_ep.req ; #w_fifo_ep.pop) + (#1 ; X)),
            slv_ep2.rdy : ((#slv_ep2.data ; w_mst_ep.req ; #w_fifo_ep.pop) + (#1 ; X)),
            * : #1 ; X
        )
    ) ; #1

// B is selected by b.id in the RTL.  The alternatives below are the two
// possible id-selected slave response ports, without introducing a response FIFO.
interface mux_b_main(
    b_mst_ep : right mst_resp_ch<b_pack_t>,
    slv_ep1 : right slv_resp_ch<b_pack_t>,
    slv_ep2 : right slv_resp_ch<b_pack_t>
) =
    rec X . ^(
        slv_ep1.rdy : b_mst_ep.rdy ; #b_mst_ep.res ; #slv_ep1.res ; #1 ; X,
        slv_ep2.rdy : b_mst_ep.rdy ; #b_mst_ep.res ; #slv_ep2.res ; #1 ; X,
        * : #1 ; X
    )

interface slave_read_itfc(
    ar_ep : left slv_addr_ch<ar_pack_t>,
    r_ep  : left slv_resp_ch<r_pack_t>
) =
    F ar_ep.req ; ar_ep.gnt ;
      rec R . (r_ep.rdy ; ^(r_ep.res, * : #1 ; R)) ; #1

interface master_read_itfc(
    ar_ep : right mst_req_ch<ar_pack_t>,
    r_ep  : left mst_resp_ch<r_pack_t>
) =
    rec X . (
        (ar_ep.rdy ; ar_ep.req ; #1 ; X)
      + (r_ep.rdy ; r_ep.res ; #1 ; X)
    )

interface ar_arbiter_itfc(
    slv_ep1 : right slv_addr_ch<ar_pack_t>,
    slv_ep2 : right slv_addr_ch<ar_pack_t>,
    ar_req_ep : left mux_addr_ch<ar_sel_pack_t>
) =
    ^(
        slv_ep1.req : ar_req_ep.req ; ar_req_ep.gnt ; #slv_ep1.gnt,
        slv_ep2.req : ar_req_ep.req ; ar_req_ep.gnt ; #slv_ep2.gnt,
        *
    ) ; #1

interface mux_ar_main(
    ar_req_ep : right mux_addr_ch<ar_sel_pack_t>,
    ar_mst_ep : left mst_req_ch<ar_pack_t>
) =
    ^(
        ar_req_ep.req : #ar_mst_ep.req ;
            rec X . ^(
                ar_mst_ep.rdy : #ar_req_ep.gnt,
                * : #1 ; X
            ),
        *
    ) ; #1

// R mirrors B: selection comes from r.id in the payload, not an AR FIFO.
interface mux_r_main(
    r_mst_ep : right mst_resp_ch<r_pack_t>,
    slv_ep1 : right slv_resp_ch<r_pack_t>,
    slv_ep2 : right slv_resp_ch<r_pack_t>
) =
    rec X . ^(
        slv_ep1.rdy : r_mst_ep.rdy ; #r_mst_ep.res ; #slv_ep1.res ; #1 ; X,
        slv_ep2.rdy : r_mst_ep.rdy ; #r_mst_ep.res ; #slv_ep2.res ; #1 ; X,
        * : #1 ; X
    )

pool axi_mux_structural_pool {
    slv1_aw -- arb1_aw : slv_addr_ch<aw_pack_t>,
    slv2_aw -- arb2_aw : slv_addr_ch<aw_pack_t>,
    slv1_w  -- mux1_w  : slv_w_ch<w_pack_t>,
    slv2_w  -- mux2_w  : slv_w_ch<w_pack_t>,
    slv1_b  -- mux1_b  : slv_resp_ch<b_pack_t>,
    slv2_b  -- mux2_b  : slv_resp_ch<b_pack_t>,

    slv1_ar -- arb1_ar : slv_addr_ch<ar_pack_t>,
    slv2_ar -- arb2_ar : slv_addr_ch<ar_pack_t>,
    slv1_r  -- mux1_r  : slv_resp_ch<r_pack_t>,
    slv2_r  -- mux2_r  : slv_resp_ch<r_pack_t>,

    aw_req -- mux_aw_req : mux_addr_ch<aw_sel_pack_t>,
    ar_req -- mux_ar_req : mux_addr_ch<ar_sel_pack_t>,

    mst_aw -- mux_mst_aw : mst_req_ch<aw_pack_t>,
    mst_w  -- mux_mst_w  : mst_req_ch<w_pack_t>,
    mst_b  -- mux_mst_b  : mst_resp_ch<b_pack_t>,
    mst_ar -- mux_mst_ar : mst_req_ch<ar_pack_t>,
    mst_r  -- mux_mst_r  : mst_resp_ch<r_pack_t>,

    w_fifo_push -- w_fifo_push_ri : fifo_insert_ch<select_t>,
    w_fifo_pop  -- w_fifo_pop_ri  : fifo_dequeue_ch<select_t>;

    islv1_w : slave_write_itfc(slv1_aw, slv1_w, slv1_b),
    islv2_w : slave_write_itfc(slv2_aw, slv2_w, slv2_b),
    imst_w  : master_write_itfc(mux_mst_aw, mux_mst_w, mst_b),

    iarb_aw : aw_arbiter_itfc(arb1_aw, arb2_aw, aw_req),
    imux_aw : mux_aw_main(mux_aw_req, mst_aw, w_fifo_push),
    imux_w  : mux_w_main(mux1_w, mux2_w, w_fifo_pop, mst_w),
    imux_b  : mux_b_main(mux_mst_b, mux1_b, mux2_b),
    iwfifo  : fifo_itfc(w_fifo_push_ri, w_fifo_pop_ri),

    islv1_r : slave_read_itfc(slv1_ar, slv1_r),
    islv2_r : slave_read_itfc(slv2_ar, slv2_r),
    imst_r  : master_read_itfc(mux_mst_ar, mst_r),

    iarb_ar : ar_arbiter_itfc(arb1_ar, arb2_ar, ar_req),
    imux_ar : mux_ar_main(mux_ar_req, mst_ar),
    imux_r  : mux_r_main(mux_mst_r, mux1_r, mux2_r)
}

chan fifo_insert_ch<Tp : type> {
    right push : (Tp@#1),
    left full : (void@#1)
}

chan fifo_dequeue_ch<Tp : type> {
    left pop : (Tp@#1),
    left empty : (void@#1)
}

chan slv_addr_ch<Tp : type> {
    right req : (Tp@#1),
    left gnt : (void@#1)
}

chan mux_addr_ch<Tp : type> {
    right req : (Tp@#1),
    left gnt : (void@#1)
}

chan slv_w_ch<Tp : type> {
    right rdy : (void@#1),
    right data : (Tp@#1)
}

chan mst_req_ch<Tp : type> {
    left rdy : (void@#1),
    right req : (Tp@#1)
}

chan slv_resp_ch<Tp : type> {
    right rdy : (void@#1),
    left res : (Tp@#1)
}

chan mst_resp_ch<Tp : type> {
    right rdy : (void@#1),
    right res : (Tp@#1)
}

type select_t = logic[1];
type id_t = logic[2];
type mst_id_t = logic[3];
type addr_t = logic[32];
type data_t = logic[32];
type prot_t = logic;
type resp_t = logic;
type strb_t = logic;

struct aw_pack_t {
    id : id_t,
    addr : addr_t,
    prot : prot_t
}

struct w_pack_t {
    data : data_t,
    strb : strb_t,
    last : logic
}

struct b_pack_t {
    id : mst_id_t,
    resp : resp_t
}

struct ar_pack_t {
    id : id_t,
    addr : addr_t,
    prot : prot_t
}

struct r_pack_t {
    id : mst_id_t,
    data : data_t,
    resp : resp_t,
    last : logic
}

struct aw_sel_pack_t {
    aw : aw_pack_t,
    select : select_t
}

struct ar_sel_pack_t {
    ar : ar_pack_t,
    select : select_t
}
