// AXI mux (pulp-platform/axi, axi_mux.sv): W is taken only from the client whose AW won arbitration.
// Client c2 and the manager m are left open.

// Client c1 sends W before AW.
pool mux_w_first_pool {
    ep_le -- ep_ri : ch;
    imux : ^(c1.aw : m.aw ; c1.w ; m.w ; m.b ; c1.b,
             c2.aw : m.aw ; c2.w ; m.w ; m.b ; c2.b) ; #1,
    iclient : c1.w ; c1.aw ; c1.b ; #1
}

// Client c1 sends AW before W.
pool mux_aw_first_pool {
    ep_le -- ep_ri : ch;
    imux : ^(c1.aw : m.aw ; c1.w ; m.w ; m.b ; c1.b,
             c2.aw : m.aw ; c2.w ; m.w ; m.b ; c2.b) ; #1,
    iclient : c1.aw ; c1.w ; c1.b ; #1
}
