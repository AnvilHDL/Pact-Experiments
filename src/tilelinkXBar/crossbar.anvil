import "arbiter.anvil"

// Assume we have 4 manager/client pairs
chan client_ch<T : type> {
    right req : (logic[2]@#1),
    left grant : (void@#1),
    right data : (T@#1)
}


proc tilelinkcrossbarChan<T : type>(client_ep[4] : right client_ch<T>, arb_cl_ep_le[4] : left arbiter_server_ch<T>){
    // TileLink Crossbar implementation goes here
    chan arb_cl_ep_le1 -- arb_cl_ep_ri1 : arbiter_client_ch<T>[4];
    chan arb_cl_ep_le2 -- arb_cl_ep_ri2 : arbiter_client_ch<T>[4];
    chan arb_cl_ep_le3 -- arb_cl_ep_ri3 : arbiter_client_ch<T>[4];
    chan arb_cl_ep_le4 -- arb_cl_ep_ri4 : arbiter_client_ch<T>[4];

 
    spawn priority_arbiter<T>(arb_cl_ep_ri1[0+:4], arb_cl_ep_le[0]);
    spawn priority_arbiter<T>(arb_cl_ep_ri2[0+:4], arb_cl_ep_le[1]);
    spawn priority_arbiter<T>(arb_cl_ep_ri3[0+:4], arb_cl_ep_le[2]);
    spawn priority_arbiter<T>(arb_cl_ep_ri4[0+:4], arb_cl_ep_le[3]);

    
    loop{
        offer{
            x1 = recv client_ep[0].req => (
                match x1 {
                    2'd0 => (
                        try send arb_cl_ep_le1[0].req(()) {                   
                            try _ = recv arb_cl_ep_le1[0].grant{
                                send client_ep[0].grant(()) >>
                                let data = recv client_ep[0].data >>
                                send arb_cl_ep_le1[0].data(data)
                            }
                            else{
                                ()
                            }
                        }
                        else{
                            ()
                        }
                    ),
                    2'd1 => (
                        try send arb_cl_ep_le2[0].req(()) {                   
                            try _ = recv arb_cl_ep_le2[0].grant{
                                send client_ep[0].grant(()) >>
                                let data = recv client_ep[0].data >>
                                send arb_cl_ep_le2[0].data(data)
                            }
                            else{
                                ()
                            }
                        }
                        else{
                            ()
                        }
                    ),
                    2'd2 => (
                        try send arb_cl_ep_le3[0].req(()) {                   
                            try _ = recv arb_cl_ep_le3[0].grant{
                                send client_ep[0].grant(()) >>
                                let data = recv client_ep[0].data >>
                                send arb_cl_ep_le3[0].data(data)
                            }
                            else{
                                ()
                            }
                        }
                        else{
                            ()
                        }
                    ),
                    _ => (
                        try send arb_cl_ep_le4[0].req(()) {                   
                            try _ = recv arb_cl_ep_le4[0].grant{
                                send client_ep[0].grant(()) >>
                                let data = recv client_ep[0].data >>
                                send arb_cl_ep_le4[0].data(data)
                            }
                            else{
                                ()
                            }
                        }
                        else{
                            ()
                        }
                    ) 
                }

            ),
            x2 = recv client_ep[1].req => (
                match x2 {
                    2'd0 => (
                        try send arb_cl_ep_le1[1].req(()) {                   
                            try _ = recv arb_cl_ep_le1[1].grant{
                                send client_ep[1].grant(()) >>
                                let data = recv client_ep[1].data >>
                                send arb_cl_ep_le1[1].data(data)
                            }
                            else{
                                ()
                            }
                        }
                        else{
                            ()
                        }
                    ),
                    2'd1 => (
                        try send arb_cl_ep_le2[1].req(()) {                   
                            try _ = recv arb_cl_ep_le2[1].grant{
                                send client_ep[1].grant(()) >>
                                let data = recv client_ep[1].data >>
                                send arb_cl_ep_le2[1].data(data)
                            }
                            else{
                                ()
                            }
                        }
                        else{
                            ()
                        }
                    ),
                    2'd2 => (
                        try send arb_cl_ep_le3[1].req(()) {                   
                            try _ = recv arb_cl_ep_le3[1].grant{
                                send client_ep[1].grant(()) >>
                                let data = recv client_ep[1].data >>
                                send arb_cl_ep_le3[1].data(data)
                            }
                            else{
                                ()
                            }
                        }
                        else{
                            ()
                        }
                    ),
                    _ => (
                        try send arb_cl_ep_le4[1].req(()) {                   
                            try _ = recv arb_cl_ep_le4[1].grant{
                                send client_ep[1].grant(()) >>
                                let data = recv client_ep[1].data >>
                                send arb_cl_ep_le4[1].data(data)
                            }
                            else{
                                ()
                            }
                        }
                        else{
                            ()
                        }
                    )
                }
            ),
            x3 = recv client_ep[2].req => (
                match x3 {
                    2'd0 => (
                        try send arb_cl_ep_le1[2].req(()) {                   
                            try _ = recv arb_cl_ep_le1[2].grant{
                                send client_ep[2].grant(()) >>
                                let data = recv client_ep[2].data >>
                                send arb_cl_ep_le1[2].data(data)
                            }
                            else{
                                ()
                            }
                        }
                        else{
                            ()
                        }
                    ),
                    2'd1 => (
                        try send arb_cl_ep_le2[2].req(()) {                   
                            try _ = recv arb_cl_ep_le2[2].grant{
                                send client_ep[2].grant(()) >>
                                let data = recv client_ep[2].data >>
                                send arb_cl_ep_le2[2].data(data)
                            }
                            else{
                                ()
                            }
                        }
                        else{
                            ()
                        }
                    ),
                    2'd2 => (
                        try send arb_cl_ep_le3[2].req(()) {
                            try _ = recv arb_cl_ep_le3[2].grant{
                                send client_ep[2].grant(()) >>
                                let data = recv client_ep[2].data >>
                                send arb_cl_ep_le3[2].data(data)
                            }
                            else{
                                ()
                            }
                        }
                        else{
                            ()
                        }
                    ),
                    _ => (
                        try send arb_cl_ep_le4[2].req(()) {                   
                            try _ = recv arb_cl_ep_le4[2].grant{
                                send client_ep[2].grant(()) >>
                                let data = recv client_ep[2].data >>
                                send arb_cl_ep_le4[2].data(data)
                            }
                            else{
                                ()
                            }
                        }
                        else{
                            ()
                        }
                    )
                }
            ),
            x4 = recv client_ep[3].req => (
                match x4 {
                    2'd0 => (
                        try send arb_cl_ep_le1[3].req(()) {                   
                            try _ = recv arb_cl_ep_le1[3].grant{
                                send client_ep[3].grant(()) >>
                                let data = recv client_ep[3].data >>
                                send arb_cl_ep_le1[3].data(data)
                            }
                            else{
                                ()
                            }
                        }
                        else{
                            ()
                        }
                    ),
                    2'd1 => (
                        try send arb_cl_ep_le2[3].req(()) {                   
                            try _ = recv arb_cl_ep_le2[3].grant{
                                send client_ep[3].grant(()) >>
                                let data = recv client_ep[3].data >>
                                send arb_cl_ep_le2[3].data(data)
                            }
                            else{
                                ()
                            }
                        }
                        else{
                            ()
                        }
                    ),
                    2'd2 => (
                        try send arb_cl_ep_le3[3].req(()) {                   
                            try _ = recv arb_cl_ep_le3[3].grant{
                                send client_ep[3].grant(()) >>
                                let data = recv client_ep[3].data >>
                                send arb_cl_ep_le3[3].data(data)
                            }
                            else{
                                ()
                            }
                        }
                        else{
                            ()
                        }
                    ),
                    _ => (
                        try send arb_cl_ep_le4[3].req(()) {                   
                            try _ = recv arb_cl_ep_le4[3].grant{
                                send client_ep[3].grant(()) >>
                                let data = recv client_ep[3].data >>
                                send arb_cl_ep_le4[3].data(data)
                            }
                            else{
                                ()
                            }
                        }
                        else{
                            ()
                        }
                    )
                }
            )
        } >>
        cycle 1
    }


}

proc crossbar(){
    chan client_ep_le -- client_ep_ri  : client_ch<logic[32]>[4];
    chan manager_ep_le -- manager_ep_ri : arbiter_server_ch<logic[32]>[4];
    spawn tilelinkcrossbarChan<logic[32]>(client_ep_ri[0+:4], manager_ep_le[0+:4]);
    loop{
        cycle 1
    }
}