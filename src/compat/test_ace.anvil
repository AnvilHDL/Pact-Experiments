import "type_ace.anvil"

struct state_t { valid : logic, dirty : logic, shd : logic }

// Arbitration can overlap a preceding clean transaction's writeback.
proc arbiter(arb_itfc) {
    reg prio : logic[2];
    reg held : req_pack_t;
    loop {
        let priority = *prio >>
        fair xoffer priority {
            req = recv cache_ep1.req => (
                set held := req >>
                let _ = recv req_ep.rdy >> cycle 1 >>
                send req_ep.req(*held) >>
                fair if ((*held).is_write) {
                    let data = recv cache_ep1.w_data >>
                    send req_ep.w_data(data)
                } >>
                let res = recv req_ep.res >>
                send cache_ep1.res(res) >>
                set prio := 2'd1
            ),
            req = recv cache_ep2.req => (
                set held := req >>
                let _ = recv req_ep.rdy >> cycle 1 >>
                send req_ep.req(*held) >>
                fair if ((*held).is_write) {
                    let data = recv cache_ep2.w_data >>
                    send req_ep.w_data(data)
                } >>
                let res = recv req_ep.res >>
                send cache_ep2.res(res) >>
                set prio := 2'd2
            ),
            req = recv cache_ep3.req => (
                set held := req >>
                let _ = recv req_ep.rdy >> cycle 1 >>
                send req_ep.req(*held) >>
                fair if ((*held).is_write) {
                    let data = recv cache_ep3.w_data >>
                    send req_ep.w_data(data)
                } >>
                let res = recv req_ep.res >>
                send cache_ep3.res(res) >>
                set prio := 2'd3
            ),
            req = recv cache_ep4.req => (
                set held := req >>
                let _ = recv req_ep.rdy >> cycle 1 >>
                send req_ep.req(*held) >>
                fair if ((*held).is_write) {
                    let data = recv cache_ep4.w_data >>
                    send req_ep.w_data(data)
                } >>
                let res = recv req_ep.res >>
                send cache_ep4.res(res) >>
                set prio := 2'd0
            )
        }
    }
}

proc mem_controller(mem_itfc) {
    reg mem : logic[256][8];
    reg addr_q : logic[8];
    reg line_q : logic;
    reg cyc : logic[16];
    loop {
        xoffer {
            addr = recv mem_ep.ar_req => (
                set addr_q := addr >> cycle 1 >>
                send mem_ep.r_res(*mem[*addr_q]) >>
                dprint "[Cycle %d] Memory read addr %d data %d\n" (*cyc + 16'd1, *addr_q, *mem[*addr_q]) >>
                cycle 1
            ),
            req = recv mem_ep.aw_req => (
                { (set addr_q := req.addr); (set line_q := req.line) } >>
                let data = recv mem_ep.w_req >>
                dprint "[Cycle %d] Memory write addr %d data %d\n" (*cyc + 16'd1, *addr_q, data) >>
                set mem[*addr_q] := data >>
                fair if (*line_q) {
                    let data = recv mem_ep.w_req >>
                    dprint "[Cycle %d] Memory write addr %d data %d\n" (*cyc + 16'd1, *addr_q + 8'd1, data) >>
                    set mem[*addr_q + 8'd1] := data
                } >>
                send mem_ep.b_res(()) >> cycle 1
            )
        }
    }
    loop { set cyc := *cyc + 16'd1 }
}

proc ace_main(ace_itfc) {
    reg held : req_pack_t;
    reg transfer1 : logic;
    reg snoop1 : logic[8];
    reg transfer2 : logic;
    reg snoop2 : logic[8];
    reg transfer3 : logic;
    reg snoop3 : logic[8];
    reg transfer4 : logic;
    reg snoop4 : logic[8];
    loop {
        send req_ep.rdy(()) >>
        let req = recv req_ep.req >>
        set held := req >> cycle 1 >>
        // AC handshake follows decode; the initiating client is excluded.
        {
            (fair if ((*held).src != 2'd0) { send cs_ep_1.req(*held) });
            (fair if ((*held).src != 2'd1) { send cs_ep_2.req(*held) });
            (fair if ((*held).src != 2'd2) { send cs_ep_3.req(*held) });
            (fair if ((*held).src != 2'd3) { send cs_ep_4.req(*held) })
        } >> cycle 2 >>
        // CR is registered before selecting the data path.
        {
            (fair if ((*held).src != 2'd0) { let r = recv cs_ep_1.res >> set transfer1 := r } else { set transfer1 := 1'b0 });
            (fair if ((*held).src != 2'd1) { let r = recv cs_ep_2.res >> set transfer2 := r } else { set transfer2 := 1'b0 });
            (fair if ((*held).src != 2'd2) { let r = recv cs_ep_3.res >> set transfer3 := r } else { set transfer3 := 1'b0 });
            (fair if ((*held).src != 2'd3) { let r = recv cs_ep_4.res >> set transfer4 := r } else { set transfer4 := 1'b0 })
        } >>
        let has_data = *transfer1 || *transfer2 || *transfer3 || *transfer4 >>
        let word = if (*transfer1) { *snoop1 } else if (*transfer2) { *snoop2 } else if (*transfer3) { *snoop3 } else { *snoop4 } >>
        fair if ((*held).clean) {
            // CleanUnique responds when CR completes, before dirty writeback.
            send req_ep.res(res_pack_t::{data = 8'd0; ack = 1'b1}) >>
            fair if (has_data) {
                cycle 1 >>
                send mem_ep.aw_req(mem_write_t::{addr = (*held).addr & 8'hf0; line = 1'b1}) >>
                cycle 1 >>
                offer {
                    data = recv cs_ep_1.data => (set snoop1 := data),
                    data = recv cs_ep_2.data => (set snoop2 := data),
                    data = recv cs_ep_3.data => (set snoop3 := data),
                    data = recv cs_ep_4.data => (set snoop4 := data)
                } >>
                { (send mem_ep.w_req(word));
                  offer {
                      data = recv cs_ep_1.data => (set snoop1 := data),
                      data = recv cs_ep_2.data => (set snoop2 := data),
                      data = recv cs_ep_3.data => (set snoop3 := data),
                      data = recv cs_ep_4.data => (set snoop4 := data)
                  }
                } >>
                send mem_ep.w_req(word) >> cycle 1 >>
                let _ = recv mem_ep.b_res >> ()
            } >> cycle 1
        } else {
            cycle 1 >>
            fair if ((*held).is_write) {
                fair if (has_data) {
                    send mem_ep.aw_req(mem_write_t::{addr = (*held).addr & 8'hf0; line = 1'b1}) >>
                    cycle 1 >>
                    offer {
                        data = recv cs_ep_1.data => (set snoop1 := data),
                        data = recv cs_ep_2.data => (set snoop2 := data),
                        data = recv cs_ep_3.data => (set snoop3 := data),
                        data = recv cs_ep_4.data => (set snoop4 := data)
                    } >>
                    { (send mem_ep.w_req(word));
                      offer {
                          data = recv cs_ep_1.data => (set snoop1 := data),
                          data = recv cs_ep_2.data => (set snoop2 := data),
                          data = recv cs_ep_3.data => (set snoop3 := data),
                          data = recv cs_ep_4.data => (set snoop4 := data)
                      }
                    } >>
                    send mem_ep.w_req(word) >> cycle 1 >>
                    let _ = recv mem_ep.b_res >> () >> cycle 1
                } >>
                send mem_ep.aw_req(mem_write_t::{addr = (*held).addr; line = 1'b0}) >>
                cycle 1 >>
                let data = recv req_ep.w_data >>
                send mem_ep.w_req(data) >> cycle 1 >>
                let _ = recv mem_ep.b_res >>
                send req_ep.res(res_pack_t::{data = 8'd0; ack = 1'b1}) >> cycle 1
            } else {
                fair if (has_data) {
                    offer {
                        data = recv cs_ep_1.data => (set snoop1 := data),
                        data = recv cs_ep_2.data => (set snoop2 := data),
                        data = recv cs_ep_3.data => (set snoop3 := data),
                        data = recv cs_ep_4.data => (set snoop4 := data)
                    } >>
                    {
                        offer {
                            data = recv cs_ep_1.data => (set snoop1 := data),
                            data = recv cs_ep_2.data => (set snoop2 := data),
                            data = recv cs_ep_3.data => (set snoop3 := data),
                            data = recv cs_ep_4.data => (set snoop4 := data)
                        };
                        (fair if (((*held).addr & 8'd8) == 8'd0) {
                            send req_ep.res(res_pack_t::{data = word; ack = 1'b0}) >> cycle 1
                        } else {
                            cycle 1 >> send req_ep.res(res_pack_t::{data = word; ack = 1'b0}) >> cycle 1
                        })
                    }
                } else {
                    send mem_ep.ar_req((*held).addr) >> cycle 1 >>
                    let data = recv mem_ep.r_res >>
                    send req_ep.res(res_pack_t::{data = data; ack = 1'b0}) >> cycle 1
                }
            }
        }
    }
}

proc cache_client<id : int>(client_itfc, snoop_itfc) {
    reg mem : logic[16][8];
    reg state : state_t[16];
    reg addr_base : logic[8];
    reg cyc : logic[16];
    reg snoop_req : req_pack_t;
    reg transfer : logic;

    loop {
        cycle 1 >>
        let addr0 = *addr_base + id[0+:8] >>
        let line0 = addr0[0+:4] >>
        dprint "[Cycle %d] Client %d read-shared addr %d\n" (*cyc + 16'd1, id, addr0) >>
        cycle 1 >>
        send cache_ep.req(req_pack_t::{src = id[0+:2]; addr = addr0; is_write = 1'b0; clean = 1'b0; is_unique = 1'b0; no_snoop = 1'b0}) >>
        let res0 = recv cache_ep.res >>
        dprint "[Cycle %d] Client %d response op %d addr %d data %d ack %d\n" (*cyc + 16'd1, id, 3'd0, addr0, res0.data, res0.ack) >>
        {
            (set mem[line0] := res0.data);
            (set state[line0] := state_t::{valid = 1'b1; dirty = 1'b0; shd = 1'b1});
            (set addr_base := *addr_base + 8'd1)
        } >>
        cycle 1 >>
        let addr1 = *addr_base + id[0+:8] >>
        let line1 = addr1[0+:4] >>
        dprint "[Cycle %d] Client %d read-unique addr %d\n" (*cyc + 16'd1, id, addr1) >>
        cycle 1 >>
        send cache_ep.req(req_pack_t::{src = id[0+:2]; addr = addr1; is_write = 1'b0; clean = 1'b0; is_unique = 1'b1; no_snoop = 1'b0}) >>
        let res1 = recv cache_ep.res >>
        dprint "[Cycle %d] Client %d response op %d addr %d data %d ack %d\n" (*cyc + 16'd1, id, 3'd1, addr1, res1.data, res1.ack) >>
        {
            (set mem[line1] := res1.data);
            (set state[line1] := state_t::{valid = 1'b1; dirty = 1'b0; shd = 1'b0});
            (set addr_base := *addr_base + 8'd1)
        } >>
        cycle 3 >>
        let addr2 = *addr_base + id[0+:8] >>
        let line2 = addr2[0+:4] >>
        dprint "[Cycle %d] Client %d clean-unique addr %d\n" (*cyc + 16'd1, id, addr2) >>
        cycle 1 >>
        send cache_ep.req(req_pack_t::{src = id[0+:2]; addr = addr2; is_write = 1'b0; clean = 1'b1; is_unique = 1'b1; no_snoop = 1'b0}) >>
        let res2 = recv cache_ep.res >>
        dprint "[Cycle %d] Client %d response op %d addr %d data %d ack %d\n" (*cyc + 16'd1, id, 3'd2, addr2, res2.data, res2.ack) >>
        {
            (set state[line2] := state_t::{valid = 1'b1; dirty = 1'b0; shd = 1'b0});
            (set addr_base := *addr_base + 8'd1)
        } >>
        cycle 7 >>
        let addr3 = *addr_base + id[0+:8] >>
        let line3 = addr3[0+:4] >>
        dprint "[Cycle %d] Client %d write-unique addr %d data %d\n" (*cyc + 16'd1, id, addr3, *cyc[0+:8] + 8'd1 + id[0+:8]) >>
        cycle 1 >>
        send cache_ep.req(req_pack_t::{src = id[0+:2]; addr = addr3; is_write = 1'b1; clean = 1'b0; is_unique = 1'b1; no_snoop = 1'b0}) >>
        send cache_ep.w_data(*cyc[0+:8] + id[0+:8]) >>
        let res3 = recv cache_ep.res >>
        dprint "[Cycle %d] Client %d response op %d addr %d data %d ack %d\n" (*cyc + 16'd1, id, 3'd3, addr3, res3.data, res3.ack) >>
        {
            (set mem[line3] := *cyc[0+:8] + id[0+:8]);
            (set state[line3] := state_t::{valid = 1'b1; dirty = 1'b1; shd = 1'b0});
            (set addr_base := *addr_base + 8'd1)
        } >>
        cycle 15 >>
        let addr4 = *addr_base + id[0+:8] >>
        let line4 = addr4[0+:4] >>
        dprint "[Cycle %d] Client %d read-no-snoop addr %d\n" (*cyc + 16'd1, id, addr4) >>
        cycle 1 >>
        send cache_ep.req(req_pack_t::{src = id[0+:2]; addr = addr4; is_write = 1'b0; clean = 1'b0; is_unique = 1'b0; no_snoop = 1'b1}) >>
        let res4 = recv cache_ep.res >>
        dprint "[Cycle %d] Client %d response op %d addr %d data %d ack %d\n" (*cyc + 16'd1, id, 3'd4, addr4, res4.data, res4.ack) >>
        {
            (set state[line4] := state_t::{valid = 1'b0; dirty = 1'b0; shd = 1'b0});
            (set addr_base := *addr_base + 8'd1)
        }
    }

    loop {
        let req = recv cs_ep.req >>
        set snoop_req := req >>
        let line = (*snoop_req).addr[0+:4] >>
        let hit = (*state[line]).valid >>
        let dirty = (*state[line]).dirty >>
        let invalidate = (*snoop_req).clean || (*snoop_req).is_write || (*snoop_req).is_unique >>
        let data_transfer = hit && ~(*snoop_req).no_snoop && (dirty || (~invalidate && ~(*state[line]).shd)) >>
        send cs_ep.res(data_transfer) >>
        {
            (set transfer := data_transfer);
            (if (~(*snoop_req).no_snoop) {
                if (invalidate) {
                    set state[line] := state_t::{valid = 1'b0; dirty = 1'b0; shd = 1'b0}
                } else {
                    set state[line] := state_t::{valid = hit; dirty = 1'b0; shd = 1'b1}
                }
            } else { cycle 1 })
        } >>
        fair if (*transfer) {
            send cs_ep.data(*mem[line]) >> cycle 1 >>
            send cs_ep.data(*mem[line]) >> cycle 1
        }
    }
    loop { set cyc := *cyc + 16'd1 }
}

proc test_ace() {
    pool p : cache_coherence_pool;
    spawn ace_main[p.i_main];
    spawn arbiter[p.i_arb];
    spawn mem_controller[p.imem];
    spawn cache_client<0>[p.ic1, p.i_sn1];
    spawn cache_client<1>[p.ic2, p.i_sn2];
    spawn cache_client<2>[p.ic3, p.i_sn3];
    spawn cache_client<3>[p.ic4, p.i_sn4];
    // Exercise cache-index wraparound and dirty writeback as well as hits.
    loop { cycle 1024 >> dfinish >> cycle 1 }
}
