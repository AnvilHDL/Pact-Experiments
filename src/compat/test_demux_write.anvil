import "type_demux_write.anvil"


proc demux_aw_main(demux_aw_main){
    reg cyc : logic[8];
    loop{
        let req = recv slv_ep.req >>
        let sel = req.select >>
        if (sel == 2'd0){
            let _ = recv mst_ep1.rdy >>
            rec X {
                try _ = recv w_fifo_ep.full {
                    cycle 1 >>
                    recurse X
                }
                else {
                    isend w_fifo_ep.push(sel) >>
                    isend mst_ep1.req(req.aw_pack) >>
                    isend slv_ep.gnt(())
                }
            }
        }
        else if (sel == 2'd1){
            let _ = recv mst_ep2.rdy >>
            rec X {
                try _ = recv w_fifo_ep.full {
                    cycle 1 >>
                    recurse X
                }
                else {
                    isend w_fifo_ep.push(sel) >>
                    isend mst_ep2.req(req.aw_pack) >>
                    isend slv_ep.gnt(())
                }
            }
        }
        else if (sel == 2'd2){
            let _ = recv mst_ep3.rdy >>
            rec X {
                try _ = recv w_fifo_ep.full {
                    cycle 1 >>
                    recurse X
                }
                else {
                    isend w_fifo_ep.push(sel) >>
                    isend mst_ep3.req(req.aw_pack) >>
                    isend slv_ep.gnt(())
                }
            }
        }
        else{
            let _ = recv mst_ep4.rdy >>
            rec X {
                try _ = recv w_fifo_ep.full {
                    cycle 1 >>
                    recurse X
                }
                else {
                    isend w_fifo_ep.push(sel) >>
                    isend mst_ep4.req(req.aw_pack) >>
                    isend slv_ep.gnt(())
                }
            }
        } >>
        cycle 1
    }
    loop{
        set cyc := *cyc + 8'd1
    }
}

proc demux_w_main(demux_w_main){
    reg cyc : logic[8];
    reg wentry : select_t;
    reg wset : logic;
    loop{
        offer{
            _ = irecv w_fifo_ep.empty =>(),
            _ = irecv b_fifo_ep.full =>(),
            # => (
                try x = recv slv_ep.req {
                    let wentry = irecv w_fifo_ep.pop >>
                    isend b_fifo_ep.push(wentry) >>
                    rec X  {
                        let wprio = if(*wset) {*wentry} else {wentry} >>
                        xoffer wprio{
                            _ = irecv mst_ep1.rdy => (
                                if (wprio == 2'd0){
                                    isend mst_ep1.req(x) >>
                                    isend slv_ep.gnt(())
                                }
                                else{
                                    dprint "[Cycle %d] Something went wrong! | wentry = %d\n vs id = 2'd0" (*cyc, wentry) >>
                                    cycle 1 >>
                                    recurse X
                                }
                            ),
                            _ = irecv mst_ep2.rdy => (
                                if (wprio == 2'd1){
                                    isend mst_ep2.req(x) >>
                                    isend slv_ep.gnt(())
                                }
                                else{
                                    dprint "[Cycle %d] Something went wrong! | wentry = %d\n vs id = 2'd1" (*cyc, wentry) >>
                                    cycle 1 >>
                                    recurse X
                                }
                            ),
                            _ = irecv mst_ep3.rdy => (
                                if (wprio == 2'd2){
                                    isend mst_ep3.req(x) >>
                                    isend slv_ep.gnt(())
                                }
                                else{
                                    dprint "[Cycle %d] Something went wrong! | wentry = %d\n vs id = 2'd2" (*cyc, wentry) >>
                                    cycle 1 >>
                                    recurse X
                                }
                            ),
                            _ = irecv mst_ep4.rdy => (
                                if (wprio == 2'd3){
                                    isend mst_ep4.req(x) >>
                                    isend slv_ep.gnt(())
                                }
                                else{
                                    dprint "[Cycle %d] Something went wrong! | wentry = %d\n vs id = 2'd3" (*cyc, wentry) >>
                                    cycle 1 >>
                                    recurse X
                                }
                            ),
                            # => (
                                (
                                    set wset := 1'b1;
                                    set wentry := wprio
                                ) >>
                                recurse X
                            )
                        }
                    }
                }
            )
        } >> 
        set wset := 1'b0
    }
    loop{
        set cyc := *cyc + 8'd1
    }
}

proc demux_b_main(demux_b_main){
    reg bentry : select_t;
    reg bset : logic;
    loop{
        try _ = recv b_fifo_ep.empty { () }
        else{
            let bentry = irecv b_fifo_ep.pop >>
            rec X {
                let bprio = if(*bset) {*bentry} else {bentry} >>
                xoffer bprio{
                    _ = irecv mst_ep1.rdy => (
                        if (bprio == 2'd0){
                            let b = irecv mst_ep1.res >>
                            isend slv_ep.res(b)
                        }
                        else{
                            dprint "Something went wrong! | bentry = %d vs id = 2'd0" (bentry) >>
                            cycle 1 >>
                            recurse X
                        }
                    ),
                    _ = irecv mst_ep2.rdy => (
                        if (bprio == 2'd1){
                            let b = irecv mst_ep2.res >>
                            isend slv_ep.res(b)
                        }
                        else{
                            dprint "Something went wrong! | bentry = %d vs id = 2'd1" (bentry) >>
                            cycle 1 >>
                            recurse X
                        }
                    ),
                    _ = irecv mst_ep3.rdy => (
                        if (bprio == 2'd2){
                            let b = irecv mst_ep3.res >>
                            isend slv_ep.res(b)
                        }
                        else{
                            dprint "Something went wrong! | bentry = %d vs id = 2'd2" (bentry) >>
                            cycle 1 >>
                            recurse X
                        }
                    ),
                    _ = irecv mst_ep4.rdy => (
                        if (bprio == 2'd3){
                            let b = irecv mst_ep4.res >>
                            isend slv_ep.res(b)
                        }
                        else{
                            dprint "Something went wrong! | bentry = %d\n vs id = 2'd3" (bentry) >>
                            cycle 1 >>
                            recurse X
                        }
                    ),
                    # =>(
                        (
                            set bset := 1'b1;
                            set bentry := bprio
                        ) >>
                        recurse X
                    )
                }
            }
        } >>
        set bset := 1'b0
    }

}

proc master<id : int>(master_address_itfc, master_data_itfc, master_response_itfc){
    reg mem : byte[256];
    reg cyc : logic[32];
    reg addresses : logic[16][8];
    reg data_ready_at : logic[16][32];
    reg response_ready_at : logic[16][32];
    reg address_write : logic[5];
    reg data_read : logic[5];
    reg response_read : logic[5];
    loop{
        rec WaitSlot {
            if ((*address_write - *response_read) == 5'd16) {
                cycle 1 >> recurse WaitSlot
            } else { () }
        } >>
        send mux_ep_aw.rdy(()) >>
        let req = recv mux_ep_aw.req >>
        dprint "[Cycle %d] Master %d received aw addr %d" (*cyc, id[0+:2], req.addr) >>
        (
            set addresses[(*address_write)[0+:4]] := req.addr[0+:8];
            set data_ready_at[(*address_write)[0+:4]] := *cyc + 32'd2;
            set address_write := *address_write + 5'd1
        ) >>
        cycle 5
    }
    loop{
        rec WaitData {
            if ((*data_read != *address_write) && (*data_ready_at[(*data_read)[0+:4]] <= *cyc)) { () }
            else { cycle 1 >> recurse WaitData }
        } >>
        send demux_ep_w.rdy(()) >>
        let wdata = recv demux_ep_w.req >>
        dprint "[Cycle %d] Master %d received w data %d" (*cyc, id[0+:2], wdata.data) >>
        (
            set mem[*addresses[(*data_read)[0+:4]]] := wdata.data;
            set response_ready_at[(*data_read)[0+:4]] := *cyc + 32'd2;
            set data_read := *data_read + 5'd1
        ) >>
        cycle 1
    }
    loop{
        rec WaitResponse {
            if ((*response_read != *data_read) && (*response_ready_at[(*response_read)[0+:4]] <= *cyc)) { () }
            else { cycle 1 >> recurse WaitResponse }
        } >>
        send demux_ep_b.rdy(()) >>
        send demux_ep_b.res(b_pack_t::{resp = 1'b0}) >>
        dprint "[Cycle %d] Master %d sent b response" (*cyc, id[0+:2]) >>
        set response_read := *response_read + 5'd1 >>
        cycle 1
    }
    loop{
        set cyc := *cyc + 32'd1
    }
}

proc slave(slave_address_itfc, slave_data_itfc, slave_response_itfc){
    reg cyc : logic[32];
    reg next_aw : logic[32];
    reg data : logic[32];
    reg sel : logic[2];
    reg pending_data : logic[16][32];
    reg write_ptr : logic[5];
    reg read_ptr : logic[5];
    loop{
        let target = if (*next_aw == 32'd0) {32'd3} else {*next_aw} >>
        rec WaitAw {
            if ((*cyc >= target) && ((*write_ptr - *read_ptr) != 5'd16)) { () }
            else { cycle 1 >> recurse WaitAw }
        } >>
        let curr_sel = *sel >>
        let curr_addr = if (curr_sel == 2'd0) {32'd0} else if (curr_sel == 2'd1) {32'd64} else if (curr_sel == 2'd2) {32'd128} else {32'd192} >>
        let aw = aw_pack_t::{addr = curr_addr; prot = 1'b0} >>
        let req = aw_ch::{aw_pack = aw; select = curr_sel} >>
        dprint "[Cycle %d] Slave write aw addr %d selected master %d" (*cyc, aw.addr, req.select) >>
        send slv_ep_aw.req(req) >>
        let _ = recv slv_ep_aw.gnt >>
        let next_target = if (target == 32'd3) {32'd10} else {((target - 32'd2) * 32'd2) + 32'd2} >>
        (
            set pending_data[(*write_ptr)[0+:4]] := *data;
            set write_ptr := *write_ptr + 5'd1;
            set data := *data + 32'd1;
            set sel := *sel + 2'd1;
            set next_aw := next_target
        )
    }
    loop{
        rec WaitData {
            if (*read_ptr != *write_ptr) { () }
            else { cycle 1 >> recurse WaitData }
        } >>
        let w = w_pack_t::{data = *pending_data[(*read_ptr)[0+:4]]; strb = 1'b1} >>
        send slv_ep_w.req(w) >>
        let _ = recv slv_ep_w.gnt >>
        dprint "[Cycle %d] Slave write data %d granted" (*cyc, w.data) >>
        set read_ptr := *read_ptr + 5'd1 >>
        cycle 1
    }
    loop{
        let b = recv slv_ep_b.res >>
        dprint "[Cycle %d] Slave received b response %d" (*cyc, b.resp) >>
        cycle 1
    }
    loop{
        set cyc := *cyc + 32'd1
    }
}

proc test_demux_write(){

    pool p : axi_type_demux_write_pool;

    spawn slave[p.i1_address, p.i1_data, p.i1_response];
    spawn master<0>[p.i2_address, p.i2_data, p.i2_response];
    spawn master<1>[p.i3_address, p.i3_data, p.i3_response];
    spawn master<2>[p.i4_address, p.i4_data, p.i4_response];
    spawn master<3>[p.i5_address, p.i5_data, p.i5_response];
    spawn demux_aw_main[p.i6];
    spawn demux_w_main[p.i7];
    spawn demux_b_main[p.i8];
    spawn fifo<select_t>[p.i9];
    spawn fifo<select_t>[p.i10];

    loop{
        cycle 1
    }
}
