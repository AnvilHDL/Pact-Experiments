interface spill_register_itfc(inp_ep : right reg_req<T>, out_ep : left reg_res<T>) =
    ((inp_ep.req ; #1) +
     (^(out_ep.data, *); (&(#inp_ep.req , #out_ep.spill, *);#1) || (#1))
     + (rec X . (^(out_ep.data,*) ; ^(#out_ep.spill, *: #1;X)))
    )


interface master_itfc(reg_ep : left reg_req<T>) = F reg_ep.req; #1
interface slave_itfc(reg_ep : right reg_res<T>) = F reg_ep.data ; (#reg_ep.spill + ()) ; #1

pool spill_reg_pool {
    reg_inp_ep -- reg_inp_ep2 : reg_req<logic[32]>,
    reg_out_ep -- reg_out_ep2 : reg_res<logic[32]>;
    ispillreg : spill_register_itfc(reg_inp_ep2, reg_out_ep2),
    imaster : master_itfc(reg_inp_ep),
    islave : slave_itfc(reg_out_ep)
}

chan reg_req <T : type> {
    right req : (T@#1)
}

chan reg_res <T : type> {
    left spill : (void@#1),
    right data : (T@#1) <<
}
