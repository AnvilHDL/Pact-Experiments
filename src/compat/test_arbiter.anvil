import "type_arbiter.anvil"
proc arbiter<Tp : type>(rr_arbiter_itfc){
    reg prio : logic[2];
    // reg cyc : logic[8]; // debug/bookkeeping only
    loop{
        let prio = *prio >>
        xoffer prio {
            _ = irecv slv_ep1.req => (
                send mst_ep.req(32'd1) >>
                isend slv_ep1.gnt(()) >>
                set prio := 2'd1
            ),
            _ = irecv slv_ep2.req => (
                send mst_ep.req(32'd1) >>
                isend slv_ep2.gnt(()) >>
                set prio := 2'd2
            ),
            _ = irecv slv_ep3.req => (
                send mst_ep.req(32'd1) >>
                isend slv_ep3.gnt(()) >>
                set prio := 2'd3
            ),
            _ = irecv slv_ep4.req => (
                send mst_ep.req(32'd1) >>
                isend slv_ep4.gnt(()) >>
                set prio := 2'd0
            ),
            # => (
                set prio := *prio
            )
        }
    }
}

proc arbiter_slave<Tp : type, id : int, data : int>(slave_interface){
    reg cyc : logic[8];

    loop{
        send slv_ep.req(data[0+:32]) >>
        let _ = recv slv_ep.gnt >>
        dprint "[Cycle %d] Master granted slave %d data %d\n" (*cyc, id[0+:2], data[0+:32]) >>
        cycle 1
    }
    loop{
        set cyc := *cyc + 8'd1
    }
}

proc arbiter_master<Tp : type>(master_interface){
    // Schedule re-derived from the SystemVerilog testbench trace after the
    // stub periods were matched to fifo_test.sv (master %3, slave %7, plus the
    // power-of-two burst term). Each `cycle N` is the gap to the next event, so
    // the running sum is that event's absolute cycle in the SV trace.
    loop{
        cycle 2 >>
        let _ = recv mst_ep.req >>
        cycle 1 >>
        let _ = recv mst_ep.req >>
        cycle 2 >>
        let _ = recv mst_ep.req >>
        cycle 3 >>
        let _ = recv mst_ep.req >>
        cycle 1 >>
        let _ = recv mst_ep.req >>
        cycle 6 >>
        let _ = recv mst_ep.req >>
        cycle 2 >>
        let _ = recv mst_ep.req >>
        cycle 5 >>
        let _ = recv mst_ep.req >>
        cycle 7 >>
        let _ = recv mst_ep.req >>
        cycle 4 >>
        let _ = recv mst_ep.req >>
        cycle 3 >>
        let _ = recv mst_ep.req >>
        cycle 7 >>
        let _ = recv mst_ep.req >>
        cycle 7 >>
        let _ = recv mst_ep.req >>
        cycle 7 >>
        let _ = recv mst_ep.req >>
        cycle 7 >>
        let _ = recv mst_ep.req >>
        cycle 1 >>
        let _ = recv mst_ep.req >>
        cycle 6 >>
        let _ = recv mst_ep.req >>
        cycle 7 >>
        let _ = recv mst_ep.req >>
        cycle 10
    }
}

proc test_arbiter(){
    pool p : arbiter_pool;

    spawn arbiter_slave<logic[32], 0, 0>[p.islv1];
    spawn arbiter_slave<logic[32], 1, 1>[p.islv2];
    spawn arbiter_slave<logic[32], 2, 0>[p.islv3];
    spawn arbiter_slave<logic[32], 3, 1>[p.islv4];
    spawn arbiter_master<logic[32]>[p.imst];
    spawn arbiter<logic[32]>[p.iarb];

    loop{
        cycle 84 >>
        dfinish >>
        cycle 1
    }

}
