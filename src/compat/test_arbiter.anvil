import "type_arbiter.anvil"
proc arbiter<Tp : type>(rr_arbiter_itfc){
    reg prio : logic[2];
    // reg cyc : logic[8]; // debug/bookkeeping only
    loop{
        let prio = *prio >>
        xoffer prio {
            _ = recv slv_ep1.req => (
                send mst_ep.req(1'd1) >>
                send slv_ep1.gnt(()) >>
                set prio := 2'd1
            ),
            _ = recv slv_ep2.req => (
                send mst_ep.req(1'd1) >>
                send slv_ep2.gnt(()) >>
                set prio := 2'd2
            ),
            _ = recv slv_ep3.req => (
                send mst_ep.req(1'd1) >>
                send slv_ep3.gnt(()) >>
                set prio := 2'd3
            ),
            _ = recv slv_ep4.req => (
                send mst_ep.req(1'd1) >>
                send slv_ep4.gnt(()) >>
                set prio := 2'd0
            ),
            # => (
                set prio := *prio
            )
        }
    }
}

proc arbiter_slave<Tp : type, id : int, data : int>(slave_interface){
    reg cyc : logic[8];

    loop{
        send slv_ep.req(data[0+:1]) >>
        let _ = recv slv_ep.gnt >>
        dprint "[Cycle %d] Master granted slave %d data %d\n" (*cyc, id[0+:2], data[0+:1]) >>
        cycle 1
    }
    loop{
        set cyc := *cyc + 8'd1
    }
}

proc arbiter_master<Tp : type>(master_interface){
    loop{
        cycle 4 >>
        let _ = recv mst_ep.req >>
        cycle 3 >>
        let _ = recv mst_ep.req >>
        cycle 3 >>
        let _ = recv mst_ep.req >>
        cycle 3 >>
        let _ = recv mst_ep.req >>
        cycle 3 >>
        let _ = recv mst_ep.req >>
        cycle 3 >>
        let _ = recv mst_ep.req >>
        cycle 3 >>
        let _ = recv mst_ep.req >>
        cycle 3 >>
        let _ = recv mst_ep.req >>
        cycle 3 >>
        let _ = recv mst_ep.req >>
        cycle 3 >>
        let _ = recv mst_ep.req >>
        cycle 3 >>
        let _ = recv mst_ep.req >>
        cycle 3 >>
        let _ = recv mst_ep.req >>
        cycle 3 >>
        let _ = recv mst_ep.req >>
        cycle 3 >>
        let _ = recv mst_ep.req >>
        cycle 3 >>
        let _ = recv mst_ep.req >>
        cycle 3 >>
        let _ = recv mst_ep.req >>
        cycle 3 >>
        let _ = recv mst_ep.req >>
        cycle 3 >>
        let _ = recv mst_ep.req >>
        cycle 3 >>
        let _ = recv mst_ep.req >>
        cycle 3 >>
        let _ = recv mst_ep.req >>
        cycle 3 >>
        let _ = recv mst_ep.req >>
        cycle 3 >>
        let _ = recv mst_ep.req >>
        cycle 3 >>
        let _ = recv mst_ep.req >>
        cycle 3 >>
        let _ = recv mst_ep.req >>
        cycle 3 >>
        let _ = recv mst_ep.req >>
        cycle 3 >>
        let _ = recv mst_ep.req >>
        cycle 3 >>
        let _ = recv mst_ep.req >>
        cycle 1
    }
}

proc test_arbiter(){
    pool p : arbiter_pool;

    spawn arbiter_slave<logic, 0, 0>[p.islv1];
    spawn arbiter_slave<logic, 1, 1>[p.islv2];
    spawn arbiter_slave<logic, 2, 0>[p.islv3];
    spawn arbiter_slave<logic, 3, 1>[p.islv4];
    spawn arbiter_master<logic>[p.imst];
    spawn arbiter<logic>[p.iarb];

    loop{
        cycle 84 >>
        dfinish >>
        cycle 1
    }

}
