interface fifo_itfc(push_ep : right fifo_insert_ch<select_t>, pop_ep : right fifo_dequeue_ch<select_t>) =  
                                                (
                                                    rec X . ^( pop_ep.pop : ^(push_ep.full, *);#1,
                                                       * :  ^(push_ep.full, *);#1;X
                                                     )
                                                  )
                                                                    + 
                                                  (
                                                    rec Y . ^(
                                                        push_ep.push : ^(pop_ep.empty, *);#1,
                                                        * : ^(pop_ep.empty, *);#1;Y
                                                    )
                                                  )
                                                     
                                                                    + 
                                                    (
                                                        &(push_ep.push , pop_ep.pop) ; #1
                                                    )


interface master_itfc(mst_ep_aw : right mst_ch<aw_pack_t>, mst_ep_w : right mst_ch<w_pack_t>, mst_ep_b : left reg_req<b_pack_t>) = mst_ep_aw.req ; mst_ep_w.req ; #1; mst_ep_b.req ;#1

interface slave_itfc(write_req_ep : left slv_ch<aw_pack_t>, write_data_ep : left slv_r_ch<w_pack_t>, write_res_ep  : left slv_res_ch<b_pack_t>) =
            write_req_ep.req ; rec X . write_data_ep.rdy; ^(write_data_ep.data, * : #1; X) ; rec Y . write_res_ep.rdy; ^(write_res_ep.res, * : #1; Y); #1

interface rr_arbiter_itfc(slv_ep1 : right slv_ch<aw_pack_t>, slv_ep2 : right slv_ch<aw_pack_t>, aw_req_ep : left reg_req<aw_sel_pack_t>) =
^( 
   slv_ep1.req : aw_req_ep.req,
   slv_ep2.req : aw_req_ep.req
) ; #1

interface spill_register_itfc(inp_ep : right reg_req<T>, out_ep : left reg_res<T>) = 
                    (inp_ep.req;#1) +  (&(inp_ep.req, out_ep.data : out_ep.spill , *)) + (out_ep.data;out_ep.spill;#1)

interface mux_aw_main (
    aw_req_ep : right reg_res<aw_sel_pack_t>,
    aw_mst_ep : left mst_ch <aw_pack_t>,
    fifo_ep : left fifo_insert_ch<select_t>
) =^(
        fifo_ep.full,
        * : ^(aw_req_ep.data : #fifo_ep.push  ; aw_mst_ep.req; #aw_req_ep.spill ,  *)
    ) ; #1

interface mux_w_main (
    slv_ep1 : right slv_r_ch<w_pack_t>,
    slv_ep2 : right slv_r_ch<w_pack_t>,
    w_fifo_ep : left fifo_dequeue_ch<select_t>,
    b_fifo_ep : left fifo_insert_ch<select_t>,
    w_mst_ep : left mst_ch<w_pack_t>
) =^(
        w_fifo_ep.empty,
        * : ^(b_fifo_ep.full, 
              * : #w_fifo_ep.pop;#b_fifo_ep.push; rec X . ^(
                                                        slv_ep1.rdy : ((slv_ep1.data;w_mst_ep.req) + (#1;X)),
                                                        slv_ep2.rdy : ((slv_ep2.data;w_mst_ep.req) + (#1;X))
                                                      )
                )
); #1

interface mux_b_main (
    b_fifo_ep : left fifo_dequeue_ch<select_t>,
    b_mst_ep : right reg_res<b_pack_t>,
    slv_ep1 : right slv_res_ch<b_pack_t>,
    slv_ep2 : right slv_res_ch<b_pack_t>
) = ^(
        b_fifo_ep.empty,
        * : #b_fifo_ep.pop ; rec X . b_mst_ep.data ; ^(
                                                        slv_ep1.rdy : ((slv_ep1.res;#b_mst_ep.spill) + (#1;X)),
                                                        slv_ep2.rdy : ((slv_ep2.res;#b_mst_ep.spill) + (#1;X))
                                                      )
    ) ; #1
                            
                                            
pool mux_write_transaction_pool {
    // slave interfaces
    slv_ep1 -- arb_ep1 : slv_ch<aw_pack_t>,
    slv_ep2 -- arb_ep2 : slv_ch<aw_pack_t>,
    slv_data_ep1 -- mux_data_ep1 : slv_r_ch<w_pack_t>,
    slv_data_ep2 -- mux_data_ep2 : slv_r_ch<w_pack_t>,
    slv_res_ep1 -- mux_res_ep1 : slv_res_ch<b_pack_t>,
    slv_res_ep2 -- mux_res_ep2 : slv_res_ch<b_pack_t>,
    
    // master interfaces
    mst_ep_aw -- mux_ep_aw : mst_ch<aw_pack_t>,
    mst_ep_w -- mux_ep_w : mst_ch<w_pack_t>,
    mst_ep_b -- b_reg_req_ep : reg_req<b_pack_t>,


    arb_aw_ep -- aw_reg_req_ep : reg_req<aw_sel_pack_t>,
    mux_aw_req_ep -- aw_reg_res_ep : reg_res<aw_sel_pack_t>,

    mux_b_res_ep -- b_reg_res_ep : reg_res<b_pack_t>,

    w_fifo_push -- w_fifo_push_ri : fifo_insert_ch<select_t>,
    w_fifo_pop -- w_fifo_pop_ri : fifo_dequeue_ch<select_t>,
    b_fifo_push -- b_fifo_push_ri : fifo_insert_ch<select_t>,
    b_fifo_pop -- b_fifo_pop_ri : fifo_dequeue_ch<select_t>;

    islv1 : slave_itfc(slv_ep1, slv_data_ep1, slv_res_ep1),
    islv2 : slave_itfc(slv_ep2, slv_data_ep2, slv_res_ep2),
    imst : master_itfc(mux_ep_aw, mux_ep_w, mst_ep_b),
    iarb : rr_arbiter_itfc(arb_ep1, arb_ep2, arb_aw_ep),
    isr_aw : spill_register_itfc(aw_reg_req_ep, mux_aw_req_ep),
    isr_b : spill_register_itfc(b_reg_req_ep, mux_b_res_ep),
    iaw : mux_aw_main(aw_reg_res_ep, mst_ep_aw, w_fifo_push),
    iw : mux_w_main(mux_data_ep1, mux_data_ep2, w_fifo_pop, b_fifo_push, mst_ep_w),
    ib : mux_b_main(b_fifo_pop, b_reg_res_ep, mux_res_ep1, mux_res_ep2),
    iwf : fifo_itfc(w_fifo_push_ri, w_fifo_pop_ri),
    ibf : fifo_itfc(b_fifo_push_ri, b_fifo_pop_ri)
}


    




