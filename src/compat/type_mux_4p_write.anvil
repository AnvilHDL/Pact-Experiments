import "mux_commons.anvilh"


interface master_write_itfc(mst_ep_aw : right w_mst_ch<aw_pack_t>, mst_ep_w : right w_mst_ch<w_pack_t>, mst_ep_b : left mst_res_ch<b_pack_t>) = F mst_ep_aw.rdy ; mst_ep_aw.req ; #1; mst_ep_w.rdy ; mst_ep_w.req;#1;mst_ep_b.rdy;mst_ep_b.res;#1

interface slave_write_itfc(write_req_ep : left w_slv_ch<aw_pack_t>, write_data_ep : left slv_w_ch<w_pack_t>, write_res_ep  : left slv_res_ch<b_pack_t>) =
            F write_req_ep.req ; write_req_ep.gnt; rec X . (write_data_ep.rdy; ^(write_data_ep.data, * : #1; X) ); rec Y . (write_res_ep.rdy; ^(write_res_ep.res, * : #1; Y)); #1

interface w_rr_arbiter_itfc(slv_ep1 : right w_slv_ch<T>, slv_ep2 : right w_slv_ch<T>, slv_ep3 : right w_slv_ch<T>, slv_ep4 : right w_slv_ch<T>, aw_req_ep : left w_mux_ch<T1>) =
^( 
   slv_ep1.req : aw_req_ep.req;aw_req_ep.gnt;#slv_ep1.gnt,
   slv_ep2.req : aw_req_ep.req;aw_req_ep.gnt;#slv_ep2.gnt,
   slv_ep3.req : aw_req_ep.req;aw_req_ep.gnt;#slv_ep3.gnt,
   slv_ep4.req : aw_req_ep.req;aw_req_ep.gnt;#slv_ep4.gnt,
   *
) ; #1

interface mux_aw_main (
    aw_req_ep : right w_mux_ch<aw_sel_pack_t>,
    aw_mst_ep : left w_mst_ch <aw_pack_t>,
    fifo_ep : left fifo_insert_ch<select_t>
) = aw_req_ep.req;aw_mst_ep.rdy ; rec X . ^(fifo_ep.full: #1;X, * : #fifo_ep.push;#aw_mst_ep.req;#aw_req_ep.gnt);#1

interface mux_w_main (
    slv_ep1 : right slv_w_ch<w_pack_t>,
    slv_ep2 : right slv_w_ch<w_pack_t>,
    slv_ep3 : right slv_w_ch<w_pack_t>,
    slv_ep4 : right slv_w_ch<w_pack_t>,
    w_fifo_ep : left fifo_dequeue_ch<select_t>,
    b_fifo_ep : left fifo_insert_ch<select_t>,
    w_mst_ep : left w_mst_ch<w_pack_t>
) =&(
        w_fifo_ep.empty,
        b_fifo_ep.full,
        * : ^(w_mst_ep.rdy :  #w_fifo_ep.pop;#b_fifo_ep.push; rec X . ^(
                                                        slv_ep1.rdy : ((#slv_ep1.data;#w_mst_ep.req) + (#1;X)),
                                                        slv_ep2.rdy : ((#slv_ep2.data;#w_mst_ep.req) + (#1;X)),
                                                        slv_ep3.rdy : ((#slv_ep3.data;#w_mst_ep.req) + (#1;X)),
                                                        slv_ep4.rdy : ((#slv_ep4.data;#w_mst_ep.req) + (#1;X))                                                      
                                                     ),
                *
            )
        
); #1

interface mux_b_main (
    b_fifo_ep : left fifo_dequeue_ch<select_t>,
    b_mst_ep : right mst_res_ch<b_pack_t>,
    slv_ep1 : right slv_res_ch<b_pack_t>,
    slv_ep2 : right slv_res_ch<b_pack_t>,
    slv_ep3 : right slv_res_ch<b_pack_t>,
    slv_ep4 : right slv_res_ch<b_pack_t>
) = ^(
        b_fifo_ep.empty,
        * : ^(b_mst_ep.rdy : #b_fifo_ep.pop ; rec X.  ^(
                                         slv_ep1.rdy : (#b_mst_ep.res;#slv_ep1.res) + (#1;X),
                                          slv_ep2.rdy : (#b_mst_ep.res;#slv_ep2.res) + (#1;X),
                                          slv_ep3.rdy : (#b_mst_ep.res;#slv_ep3.res) + (#1;X),
                                          slv_ep4.rdy : (#b_mst_ep.res;#slv_ep4.res) + (#1;X)
                                    ),
                *)

    ) ; #1
                            
                                            
pool mux_write_transaction_pool {
    w_slv_ep1 -- w_arb_ep1 : w_slv_ch<aw_pack_t>,
    w_slv_ep2 -- w_arb_ep2 : w_slv_ch<aw_pack_t>,
    w_slv_ep3 -- w_arb_ep3 : w_slv_ch<aw_pack_t>,
    w_slv_ep4 -- w_arb_ep4 : w_slv_ch<aw_pack_t>,
    w_slv_data_ep1 -- w_mux_data_ep1 : slv_w_ch<w_pack_t>,
    w_slv_data_ep2 -- w_mux_data_ep2 : slv_w_ch<w_pack_t>,
    w_slv_data_ep3 -- w_mux_data_ep3 : slv_w_ch<w_pack_t>,
    w_slv_data_ep4 -- w_mux_data_ep4 : slv_w_ch<w_pack_t>,
    w_slv_res_ep1 -- w_mux_res_ep1 : slv_res_ch<b_pack_t>,
    w_slv_res_ep2 -- w_mux_res_ep2 : slv_res_ch<b_pack_t>,
    w_slv_res_ep3 -- w_mux_res_ep3 : slv_res_ch<b_pack_t>,
    w_slv_res_ep4 -- w_mux_res_ep4 : slv_res_ch<b_pack_t>,
    
    // master interfaces
    w_mux_ep_aw -- w_mst_ep_aw : w_mst_ch<aw_pack_t>,
    w_mux_ep_w -- w_mst_ep_w : w_mst_ch<w_pack_t>,
    w_mst_ep_b -- w_mux_ep_b   : mst_res_ch<b_pack_t>,

    w_aw_req_ep -- w_mux_aw_req_ep : w_mux_ch<aw_sel_pack_t>,

    w_fifo_push -- w_fifo_push_ri : fifo_insert_ch<select_t>,
    w_fifo_pop -- w_fifo_pop_ri : fifo_dequeue_ch<select_t>,
    b_fifo_push -- b_fifo_push_ri : fifo_insert_ch<select_t>,
    b_fifo_pop -- b_fifo_pop_ri : fifo_dequeue_ch<select_t>;

    islv1 : slave_write_itfc(w_slv_ep1, w_slv_data_ep1, w_slv_res_ep1),
    islv2 : slave_write_itfc(w_slv_ep2, w_slv_data_ep2, w_slv_res_ep2),
    islv3 : slave_write_itfc(w_slv_ep3, w_slv_data_ep3, w_slv_res_ep3),
    islv4 : slave_write_itfc(w_slv_ep4, w_slv_data_ep4, w_slv_res_ep4),
    imst : master_write_itfc(w_mst_ep_aw, w_mst_ep_w, w_mst_ep_b),
    iarb : w_rr_arbiter_itfc(w_arb_ep1, w_arb_ep2, w_arb_ep3, w_arb_ep4, w_aw_req_ep),
    iaw : mux_aw_main(w_mux_aw_req_ep, w_mux_ep_aw, w_fifo_push),
    iw : mux_w_main(w_mux_data_ep1, w_mux_data_ep2, w_mux_data_ep3, w_mux_data_ep4, w_fifo_pop, b_fifo_push, w_mux_ep_w),
    ib : mux_b_main(b_fifo_pop, w_mux_ep_b, w_mux_res_ep1, w_mux_res_ep2, w_mux_res_ep3, w_mux_res_ep4),
    iwf : fifo_itfc(w_fifo_push_ri, w_fifo_pop_ri),
    ibf : fifo_itfc(b_fifo_push_ri, b_fifo_pop_ri)
}






chan fifo_insert_ch<Tp : type> {
    right push : (Tp@#1),
    left full : (void@#1) 
}

chan fifo_dequeue_ch<Tp : type> {
    left pop : (Tp@#1) ,
    left empty : (void@#1)
}

type select_t = logic[2];




type prot_t = logic;
type resp_t = logic;
type strb_t = logic;

type select_t = logic[2];
type A = logic[32];
type T = logic[32];


struct aw_pack_t {
    addr : A,
    prot : prot_t
}

struct w_pack_t {
    data : T,
    strb : strb_t
}

struct b_pack_t {
    resp : resp_t
}

struct ar_pack_t {
    addr : A,
    prot : prot_t
}

struct r_pack_t {
    data : T,
    resp : resp_t
}

struct aw_sel_pack_t {
    aw_pack : aw_pack_t,
    select : select_t
}


chan w_slv_ch<Tp : type> {
    right req : (Tp@#1),
    left gnt : (void@#1)
}
chan w_mux_ch<Tp : type> {
    right req : (Tp@#1),
    left gnt : (void@#1)
}

chan slv_w_ch<Tp : type> {
    right rdy : (void@#1),
    right data : (Tp@#1)
}

chan w_mst_ch<Tp : type> {
    left rdy : (void@#1),
    right req : (Tp@#1)
}

chan slv_res_ch<Tp : type> {
    right rdy : (void@#1),
    left res : (Tp@#1)
}

chan mst_res_ch<Tp : type> {
    right rdy : (void@#1),
    right res : (Tp@#1)
}
type byte = logic[32];