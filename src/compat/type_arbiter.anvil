interface rr_arbiter_itfc(slv_ep1 : right arbiter_slave_ch<Tp>, slv_ep2 : right arbiter_slave_ch<Tp>, slv_ep3 : right arbiter_slave_ch<Tp>, slv_ep4 : right arbiter_slave_ch<Tp>, slv_ep5 : right arbiter_slave_ch<Tp>, slv_ep6 : right arbiter_slave_ch<Tp>, slv_ep7 : right arbiter_slave_ch<Tp>, slv_ep8 : right arbiter_slave_ch<Tp>, mst_ep : left arbiter_master_ch<Tp>) =  

^( slv_ep1.req : mst_ep.req ; #slv_ep1.gnt,
   slv_ep2.req : mst_ep.req ; #slv_ep2.gnt,
   slv_ep3.req : mst_ep.req ; #slv_ep3.gnt,
   slv_ep4.req : mst_ep.req ; #slv_ep4.gnt,
   *
   ) ; #1

interface slave_interface(slv_ep : right arbiter_slave_ch<Tp>) = F slv_ep.req ; slv_ep.gnt;#1

interface master_interface(mst_ep : left arbiter_master_ch<Tp>) = F ^(mst_ep.req, *) ; #1

pool arbiter_pool{
    slv_ep1 -- slv_ep_ri1 : arbiter_slave_ch<Tp>,
    slv_ep2 -- slv_ep_ri2 : arbiter_slave_ch<Tp>,
    slv_ep3 -- slv_ep_ri3 : arbiter_slave_ch<Tp>,
    slv_ep4 -- slv_ep_ri4 : arbiter_slave_ch<Tp>,
    mst_ep -- mst_ep_ro : arbiter_master_ch<Tp>;

    islv1 : slave_interface(slv_ep_ri1),
    islv2 : slave_interface(slv_ep_ri2),
    islv3 : slave_interface(slv_ep_ri3),
    islv4 : slave_interface(slv_ep_ri4),
    imst : master_interface(mst_ep_ro),
    iarb : rr_arbiter_itfc(slv_ep_ri1, slv_ep_ri2, slv_ep_ri3, slv_ep_ri4, slv_ep_ri5, slv_ep_ri6, slv_ep_ri7, slv_ep_ri8, mst_ep_ro)
}