import "type_fifo.anvil"

proc fifo<T : type>(fifo_itfc){
    reg data : T[8];
    reg read_ptr : logic[3];
    reg write_ptr : logic[3];
    reg full : logic;
    // reg cyc : logic[8]; // debug/bookkeeping only

    loop{
        fair if (*full == 1'b1){
            μ X {
                try isend pop_ep.pop(*data[*read_ptr]){
                    try isend push_ep.full(()){()} >>
                    set read_ptr := *read_ptr + 3'd1;
                    set full := 1'b0
                }
                else{
                    try isend push_ep.full(()){()} >>
                    cycle 1 >>
                    recurse X
                }
            } 
        }
        else fair if(*read_ptr == *write_ptr){
         μ X {
            try x = irecv push_ep.push {
                try isend pop_ep.empty(()){()} >>
                set data[*write_ptr] := x;
                set write_ptr := *write_ptr + 3'd1
            }
            else {
                try isend pop_ep.empty(()){()} >>
                cycle 1 >>
                recurse X
            }
          }
        }
        else{
            offer{
                x = recv push_ep.push => (
                    let full = if(((*write_ptr + 3'd1) == *read_ptr)&&(~(probe pop_ep.pop))) {1'b1} else {1'b0} >>
                    set write_ptr := *write_ptr + 3'd1;
                    set data[*write_ptr] := x;
                    set full := full
                
                ),
                send pop_ep.pop(*data[*read_ptr])=>(
                    set read_ptr := *read_ptr + 3'd1
                )
            }
        }
    }
    // loop{
    //     set cyc := *cyc + 8'd1
    // }
}

proc fifo_master(master_itfc){
    reg cyc : logic[8];
    loop{
        cycle 2 >>
        rec X {
            try _ = irecv fifo_ep.full {
                cycle 1 >>
                recurse X
            }
            else {
                isend fifo_ep.push(32'd0)
            }
        } >>
        dprint "[Cycle %d] Pushed %d\n" (*cyc, 2'd0) >>
        cycle 3 >>
        rec X {
            try _ = irecv fifo_ep.full {
                cycle 1 >>
                recurse X
            }
            else {
