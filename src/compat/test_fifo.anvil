            }
            else {
                isend fifo_ep.push(32'd0)
            }
        } >>
        dprint "[Cycle %d] Pushed %d\n" (*cyc, 2'd0) >>
        cycle 10
    }
    loop{
        set cyc := *cyc + 8'd1
    }
}

proc fifo_slave(slave_itfc){
    loop{
        cycle 3 >>
        rec X {
            try _ = irecv fifo_ep.empty {
                cycle 1 >>
                recurse X
            }
            else {
                let x = irecv fifo_ep.pop >>
                dprint "[Cycle %d] Popped %d\n" (8'd3, x)
            }
        } >>
        cycle 6 >>
        rec X {
            try _ = irecv fifo_ep.empty {
                cycle 1 >>
                recurse X
            }
