proc test_fifo(){
    pool p : fifo_pool;

    spawn fifo<select_t>[p.ififo];
    spawn fifo_master[p.imaster];
    spawn fifo_slave[p.islave];

    loop{
        cycle 84 >>
        dfinish >>
        cycle 1
    }

}
