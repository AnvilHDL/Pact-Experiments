import "type_tilelink.anvil"
proc tilelink_arb(arbiter_ifc){
    reg prio : logic;
    loop{
        let _ = recv server_ep.rdy >>
        let prio = *prio >>
        xoffer prio{
            _ = irecv ep1.req => (set prio := *prio + 1),
            _ = irecv ep2.req => (set prio := *prio + 1),
            # => (set prio := *prio)
        }
    }

}


proc crossbar_A<T : type, U : type>(crossbar_itfc_A){
    loop{
        offer{
            x = irecv client_ep1.req => (
                if (x == 1'd0){
                    try send arb_cl_ep_le11.req(()) {
                        let data = irecv client_ep1.data >>
                        isend server1_ep.req(data_pack_t::{data = data; id = 1'd0})
                    }
                }else{
                    try send arb_cl_ep_le21.req(()) {
                        let data = irecv client_ep1.data >>
                        isend server2_ep.req(data_pack_t::{data = data; id = 1'd0})
                    }
                }
            ),
            y = irecv client_ep2.req => (
                if (y == 1'd0){
                    try send arb_cl_ep_le12.req(()) {
                        let data = irecv client_ep2.data >>
                        isend server1_ep.req(data_pack_t::{data = data; id = 1'd1})
                    }
                }else{
                    try send arb_cl_ep_le22.req(()) {
                        let data = irecv client_ep2.data >>
                        isend server2_ep.req(data_pack_t::{data = data; id = 1'd1})
                    }
                }
            ),
            # =>(
                ()
            )
        } >>
        cycle 1
    }
}


proc crossbar_D<T : type>(crossbar_itfc_D){
    loop{
        offer{
            a = irecv server1_ep.req => (
                if (a == 1'd0){
                    try send arb_cl_ep_le11.req(()) {
                        let data = irecv server1_ep.res >>
                        isend client_ep1.res(data)
                    }
                }else{
                    try send arb_cl_ep_le21.req(()) {
                        let data = irecv server1_ep.res >>
                        isend client_ep2.res(data)
                    }
                }
            ),
            b = irecv server2_ep.req => (
                if (b == 1'd0){
                    try send arb_cl_ep_le12.req(()) {
                        let data = irecv server2_ep.res >>
                        isend client_ep1.res(data)
                    }
                }else{
                    try send arb_cl_ep_le22.req(()) {
                        let data = irecv server2_ep.res >>
                        isend client_ep2.res(data)
                    }
                }
            ),
            # =>(
                ()
            )
        } >>
        cycle 1
    }
}


proc client<T : type, id : int>(client_itfc){
    reg client_select : logic;
    reg data : logic[8];
    reg cyc : logic[8];
    loop{
        {
            (
                try send res_arb_client.rdy(()) {
                    try  x = recv client_crossbar_ep.res {
                        let trace_cyc = *cyc + 8'd1 >>
                        dprint "[Cycle %d] Client %d received response: %d\n" (trace_cyc, id, x) >>
                        set data := x;
                        set client_select := *client_select + 1'd1
                    }
                    else{
                        cycle 1
                    }
                }
                else{
                    cycle 1
                }
            );
            (
                let next_select = if (id == 32'd0) {1'd0} else {1'd1} >>
                let next_data = id[0+:8] >>
                try send client_ep.req(next_select) {
                    try send client_ep.data(next_data) {
                        let trace_cyc = *cyc + 8'd1 >>
                        dprint "[Cycle %d] Client %d sent request to Master %d with data: %d\n" (trace_cyc, id, next_select, next_data) >>
                        cycle 1
                    }
                    else{
                        cycle 1
                    }
                }
                else{
                    cycle 1
                }
            )
        }
    }
    loop{
        set cyc := *cyc + 8'd1
    }
}



proc manager<T : type, U : type, id : int>(manager_itfc){
    reg next_id : logic;
    reg cyc : logic[8];
    loop{
        // Readiness must remain available until a request is accepted.
        rec WaitRequest {
            send manager_ep.rdy(()) >>
            try req = recv manager_crossbar_ep.req {
                let trace_cyc = *cyc + 8'd1 >>
                dprint "[Cycle %d] Manager %d received request from client %d\n" (trace_cyc, id, req.id) >>
                set next_id := req.id >>
                cycle 1 >>
                // Retry the routing request too when the payload is not accepted.
                rec WaitResponse {
                    send manager_crossbar_d_ep.req(*next_id) >>
                    try send manager_crossbar_d_ep.res(id[0+:8]) {
                        let trace_cyc = *cyc + 8'd1 >>
                        dprint "[Cycle %d] Manager %d sent response: %d to client %d\n" (trace_cyc, id, id[0+:8], *next_id) >>
                        cycle 1
                    } else {
                        cycle 1 >> recurse WaitResponse
                    }
                }
            } else {
                cycle 1 >> recurse WaitRequest
            }
        }
    }
    loop{
        set cyc := *cyc + 8'd1
    }
}


proc test_tilelink(){
    pool p : tilelink;
    spawn client<logic[8], 0>[p.ic1];
    spawn client<logic[8], 1>[p.ic2];
    spawn manager<data_pack_t, logic[8], 0>[p.im1];
    spawn manager<data_pack_t, logic[8], 1>[p.im2];
    spawn crossbar_A<logic[8], data_pack_t>[p.icrA];
    spawn crossbar_D<logic[8]>[p.icrD];
    spawn tilelink_arb[p.ia1];
    spawn tilelink_arb[p.ia2];
    spawn tilelink_arb[p.iares1];
    spawn tilelink_arb[p.iares2];
    
    loop{
        cycle 1
    }

}
