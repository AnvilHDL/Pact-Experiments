import "test_mux_read.anvil"
import "test_mux_write.anvil"


proc master(master_read_request_itfc, master_read_response_itfc,
            master_write_address_itfc, master_write_data_itfc, master_write_response_itfc){
    reg mem : byte[256];
    reg cyc : logic[32];
    reg read_data : byte[16];
    reg read_ready_at : logic[16][32];
    reg read_write : logic[5];
    reg read_read : logic[5];
    reg addresses : logic[16][8];
    reg data_ready_at : logic[16][32];
    reg response_ready_at : logic[16][32];
    reg address_write : logic[5];
    reg data_read : logic[5];
    reg response_read : logic[5];
    loop{
        cycle 4 >>
        rec WaitReadSlot {
            if ((*read_write - *read_read) == 5'd16) { cycle 1 >> recurse WaitReadSlot }
            else { () }
        } >>
        send mst_ep_ar.rdy(()) >>
        let req = recv mst_ep_ar.req >>
        dprint "[Cycle %d] Master received ar req with addr %d" (*cyc, req.addr) >>
        (
            set read_data[(*read_write)[0+:4]] := *mem[req.addr];
            set read_ready_at[(*read_write)[0+:4]] := *cyc + 32'd2;
            set read_write := *read_write + 5'd1
        ) >>
        // Keep the seven-cycle request interval independently of responses.
        cycle 2
    }
    loop{
        rec WaitReadResponse {
            if ((*read_read != *read_write) && (*read_ready_at[(*read_read)[0+:4]] <= *cyc)) { () }
            else { cycle 1 >> recurse WaitReadResponse }
        } >>
        let r = r_pack_t::{data = *read_data[(*read_read)[0+:4]]; resp = 1'b1} >>
        send mst_ep_r.rdy(()) >>
        send mst_ep_r.res(r) >>
        dprint "[Cycle %d] Master sent r res with data %d" (*cyc, r.data) >>
        set read_read := *read_read + 5'd1 >>
        cycle 1
    }
    loop{
        cycle 4 >>
        rec WaitWriteSlot {
            if ((*address_write - *response_read) == 5'd16) { cycle 1 >> recurse WaitWriteSlot }
            else { () }
        } >>
        send mst_ep_aw.rdy(()) >>
        let req = recv mst_ep_aw.req >>
        dprint "[Cycle %d] Master received aw req with addr %d" (*cyc, req.addr) >>
        (
            set addresses[(*address_write)[0+:4]] := req.addr[0+:8];
            set data_ready_at[(*address_write)[0+:4]] := *cyc + 32'd2;
            set address_write := *address_write + 5'd1
        ) >>
        // Keep the nine-cycle address interval independently of responses.
        cycle 4
    }
    loop{
        rec WaitData {
            if ((*data_read != *address_write) && (*data_ready_at[(*data_read)[0+:4]] <= *cyc)) { () }
            else { cycle 1 >> recurse WaitData }
        } >>
        send mst_ep_w.rdy(()) >>
        let wdata = recv mst_ep_w.req >>
        dprint "[Cycle %d] Master received w req with data %d" (*cyc, wdata.data) >>
        (
            set mem[*addresses[(*data_read)[0+:4]]] := wdata.data;
            set response_ready_at[(*data_read)[0+:4]] := *cyc + 32'd2;
            set data_read := *data_read + 5'd1
        ) >>
        cycle 1
    }
    loop{
        rec WaitWriteResponse {
            if ((*response_read != *data_read) && (*response_ready_at[(*response_read)[0+:4]] <= *cyc)) { () }
            else { cycle 1 >> recurse WaitWriteResponse }
        } >>
        send mst_ep_b.rdy(()) >>
        send mst_ep_b.res(b_pack_t::{resp = 1'b1}) >>
        set response_read := *response_read + 5'd1 >>
        cycle 1
    }
    loop{
        set cyc := *cyc + 32'd1
    }
}

proc test_unified_mux(){
    // read transactions
    pool p1 : mux_read_transaction_pool;
    pool p2 : mux_write_transaction_pool;
    spawn slave_read<1>[p1.islv1_request, p1.islv1_response];
    spawn slave_read<2>[p1.islv2_request, p1.islv2_response];
    spawn slave_read<3>[p1.islv3_request, p1.islv3_response];
    spawn slave_read<4>[p1.islv4_request, p1.islv4_response];
    spawn arbiter<ar_pack_t, ar_sel_pack_t>[p1.iarb];
    spawn mux_ar_main[p1.imux_ar];
    spawn mux_r_main[p1.imux_r];
    spawn fifo<select_t>[p1.ififo];

    // write transactions

    spawn slave_write<1>[p2.islv1_address, p2.islv1_data, p2.islv1_response];
    spawn slave_write<2>[p2.islv2_address, p2.islv2_data, p2.islv2_response];
    spawn slave_write<3>[p2.islv3_address, p2.islv3_data, p2.islv3_response];
    spawn slave_write<4>[p2.islv4_address, p2.islv4_data, p2.islv4_response];
    spawn arbiter<aw_pack_t, aw_sel_pack_t>[p2.iarb];
    spawn mux_aw_main[p2.iaw];
    spawn mux_w_main[p2.iw];
    spawn mux_b_main[p2.ib];
    spawn fifo<select_t>[p2.iwf];
    spawn fifo<select_t>[p2.ibf];


    //unified master

    spawn master[p1.imst_request, p1.imst_response, p2.imst_address, p2.imst_data, p2.imst_response];

    loop{
        cycle 30 >>
        dfinish
    }

}
