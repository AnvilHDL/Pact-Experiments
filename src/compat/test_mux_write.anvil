import "type_mux_4p_write.anvil"

proc arbiter<T : type, T1 : type> (w_rr_arbiter_itfc){
    reg prio : logic[2];
    loop{
        let raw_prio = *prio >>
        let prio = if (raw_prio == 2'd1) {2'd1} else if (raw_prio == 2'd2) {2'd2} else if (raw_prio == 2'd3) {2'd3} else {2'd0} >>
        let zero = 2'd0 >>
        if (prio == 2'd0) {
            xoffer zero{
                x = recv slv_ep1.req => (
                    let data = aw_sel_pack_t::{aw_pack = x; select = 2'd0} >>
                    send aw_req_ep.req(data) >>
                    let _ = recv aw_req_ep.gnt >>
                    isend slv_ep1.gnt(())
                ),
                x = recv slv_ep2.req => (
                    let data = aw_sel_pack_t::{aw_pack = x; select = 2'd1} >>
                    send aw_req_ep.req(data) >>
                    let _ = recv aw_req_ep.gnt >>
                    isend slv_ep2.gnt(())
                ),
                x = recv slv_ep3.req => (
                    let data = aw_sel_pack_t::{aw_pack = x; select = 2'd2} >>
                    send aw_req_ep.req(data) >>
                    let _ = recv aw_req_ep.gnt >>
                    isend slv_ep3.gnt(())
                ),
                x = recv slv_ep4.req => (
                    let data = aw_sel_pack_t::{aw_pack = x; select = 2'd3} >>
                    send aw_req_ep.req(data) >>
                    let _ = recv aw_req_ep.gnt >>
                    isend slv_ep4.gnt(())
                )
            }
        }
        else if (prio == 2'd1) {
            xoffer zero{
                x = recv slv_ep2.req => (
                    let data = aw_sel_pack_t::{aw_pack = x; select = 2'd1} >>
                    send aw_req_ep.req(data) >>
                    let _ = recv aw_req_ep.gnt >>
                    isend slv_ep2.gnt(())
                ),
                x = recv slv_ep1.req => (
                    let data = aw_sel_pack_t::{aw_pack = x; select = 2'd0} >>
                    send aw_req_ep.req(data) >>
                    let _ = recv aw_req_ep.gnt >>
                    isend slv_ep1.gnt(())
                ),
                x = recv slv_ep4.req => (
                    let data = aw_sel_pack_t::{aw_pack = x; select = 2'd3} >>
                    send aw_req_ep.req(data) >>
                    let _ = recv aw_req_ep.gnt >>
                    isend slv_ep4.gnt(())
                ),
                x = recv slv_ep3.req => (
                    let data = aw_sel_pack_t::{aw_pack = x; select = 2'd2} >>
                    send aw_req_ep.req(data) >>
                    let _ = recv aw_req_ep.gnt >>
                    isend slv_ep3.gnt(())
                )
            }
        }
        else if (prio == 2'd2) {
            xoffer zero{
                x = recv slv_ep3.req => (
                    let data = aw_sel_pack_t::{aw_pack = x; select = 2'd2} >>
                    send aw_req_ep.req(data) >>
                    let _ = recv aw_req_ep.gnt >>
                    isend slv_ep3.gnt(())
                ),
                x = recv slv_ep4.req => (
                    let data = aw_sel_pack_t::{aw_pack = x; select = 2'd3} >>
                    send aw_req_ep.req(data) >>
                    let _ = recv aw_req_ep.gnt >>
                    isend slv_ep4.gnt(())
                ),
                x = recv slv_ep1.req => (
                    let data = aw_sel_pack_t::{aw_pack = x; select = 2'd0} >>
                    send aw_req_ep.req(data) >>
                    let _ = recv aw_req_ep.gnt >>
                    isend slv_ep1.gnt(())
                ),
                x = recv slv_ep2.req => (
                    let data = aw_sel_pack_t::{aw_pack = x; select = 2'd1} >>
                    send aw_req_ep.req(data) >>
                    let _ = recv aw_req_ep.gnt >>
                    isend slv_ep2.gnt(())
                )
            }
        }
        else {
            xoffer zero{
                x = recv slv_ep4.req => (
                    let data = aw_sel_pack_t::{aw_pack = x; select = 2'd3} >>
                    send aw_req_ep.req(data) >>
                    let _ = recv aw_req_ep.gnt >>
                    isend slv_ep4.gnt(())
                ),
                x = recv slv_ep3.req => (
                    let data = aw_sel_pack_t::{aw_pack = x; select = 2'd2} >>
                    send aw_req_ep.req(data) >>
                    let _ = recv aw_req_ep.gnt >>
                    isend slv_ep3.gnt(())
                ),
                x = recv slv_ep2.req => (
                    let data = aw_sel_pack_t::{aw_pack = x; select = 2'd1} >>
                    send aw_req_ep.req(data) >>
                    let _ = recv aw_req_ep.gnt >>
                    isend slv_ep2.gnt(())
                ),
                x = recv slv_ep1.req => (
                    let data = aw_sel_pack_t::{aw_pack = x; select = 2'd0} >>
                    send aw_req_ep.req(data) >>
                    let _ = recv aw_req_ep.gnt >>
                    isend slv_ep1.gnt(())
                )
            }
        } >>
        if (prio == 2'd0) {
            if (ready slv_ep2.req) {
                set prio := 2'd1
            }
            else if (ready slv_ep3.req) {
                set prio := 2'd2
            }
            else if (ready slv_ep4.req) {
                set prio := 2'd3
            }
            else {
                set prio := 2'd0
            }
        }
        else if (prio == 2'd1) {
            if (ready slv_ep3.req) {
                set prio := 2'd2
            }
            else if (ready slv_ep4.req) {
                set prio := 2'd3
            }
            else if (ready slv_ep1.req) {
                set prio := 2'd0
            }
            else {
                set prio := 2'd1
            }
        }
        else if (prio == 2'd2) {
            if (ready slv_ep4.req) {
                set prio := 2'd3
            }
            else if (ready slv_ep1.req) {
                set prio := 2'd0
            }
            else if (ready slv_ep2.req) {
                set prio := 2'd1
            }
            else {
                set prio := 2'd2
            }
        }
        else {
            if (ready slv_ep1.req) {
                set prio := 2'd0
            }
            else if (ready slv_ep2.req) {
                set prio := 2'd1
            }
            else if (ready slv_ep3.req) {
                set prio := 2'd2
            }
            else {
                set prio := 2'd3
            }
        }
    }
}


proc mux_w_main(mux_w_main){
    reg cyc : logic[8];
    loop{
        offer{
            _ = irecv w_fifo_ep.empty =>  (),
            _ = irecv b_fifo_ep.full => (),
            # => (
                    try _ = recv w_mst_ep.rdy {
                        let wentry = irecv w_fifo_ep.pop >>
                        isend b_fifo_ep.push(wentry) >>
                        rec X  {
                            xoffer wentry{
                                _ = recv slv_ep1.rdy => (
                                    if (wentry == 2'd0){
                                        let data = irecv slv_ep1.data >>
                                        isend w_mst_ep.req(data)
                                    }
                                    else{
                                        dprint "[Cycle %d] Something went wrong! | wentry = %d\n vs id = 2'd0" (*cyc, wentry) >>
                                        cycle 1 >>
                                        recurse X
                                    }
                                ),
                                _ = recv slv_ep2.rdy => (
                                    if (wentry == 2'd1){
                                        let data = irecv slv_ep2.data >>
                                        isend w_mst_ep.req(data)
                                    }
                                    else{
                                        dprint "[Cycle %d] Something went wrong! | wentry = %d\n vs id = 2'd1" (*cyc, wentry) >>
                                        cycle 1 >>
                                        recurse X
                                    }
                                ),
                                _ = recv slv_ep3.rdy => (
                                    if (wentry == 2'd2){
                                        let data = irecv slv_ep3.data >>
                                        isend w_mst_ep.req(data)
                                    }
                                    else{
                                        dprint "[Cycle %d] Something went wrong! | wentry = %d\n vs id = 2'd2" (*cyc, wentry) >>
                                        cycle 1 >>
                                        recurse X
                                    }
                                ),
                                _ = recv slv_ep4.rdy => (
                                    if (wentry == 2'd3){
                                        let data = irecv slv_ep4.data >>
                                        isend w_mst_ep.req(data)
                                    }
                                    else{
                                        dprint "[Cycle %d] Something went wrong! | wentry = %d\n vs id = 2'd3" (*cyc, wentry) >>
                                        cycle 1 >>
                                        recurse X
                                    }
                                )
                            }
                        }
                    }
            )
        }  >>
        cycle 1
    } 
    loop{
        set cyc := *cyc + 8'd1
    }
}

proc mux_aw_main(mux_aw_main){
    reg cyc : logic[8];
    loop{
        let x = recv aw_req_ep.req >>
        let _ = recv aw_mst_ep.rdy >>
        rec X {
            try _ = recv fifo_ep.full {
                cycle 1 >>
                recurse X
            }
            else {
                isend fifo_ep.push(x.select) >>
                isend aw_mst_ep.req(x.aw_pack) >>
                isend aw_req_ep.gnt(())
            }
        } >>
        cycle 1
    }
}

proc mux_b_main(mux_b_main){
    loop{
        try _ = recv b_fifo_ep.empty { ()}
        else{
            try _ = recv b_mst_ep.rdy {
                let bentry = irecv b_fifo_ep.pop >>
                rec X{
                    xoffer bentry{
                        _ = recv slv_ep1.rdy => (
                            if (bentry == 2'd0){
                                let b = irecv b_mst_ep.res >>
                                isend slv_ep1.res(b)
                            }
                            else{
                                dprint "Something went wrong! | bentry = %d\n vs id = 2'd0" (bentry) >>
                                cycle 1 >>
                                recurse X
                            }
                        ),
                        _ = recv slv_ep2.rdy => (
                            if (bentry == 2'd1){
                                let b = irecv b_mst_ep.res >>
                                isend slv_ep2.res(b)
                            }
                            else{
                                dprint "Something went wrong! | bentry = %d\n vs id = 2'd1" (bentry) >>
                                cycle 1 >>
                                recurse X
                            }
                        ),
                        _ = recv slv_ep3.rdy => (
                            if (bentry == 2'd2){
                                let b = irecv b_mst_ep.res >>
                                isend slv_ep3.res(b)
                            }   
                            else{
                                dprint "Something went wrong! | bentry = %d\n vs id = 2'd2" (bentry) >>
                                cycle 1 >>
                                recurse X
                            }
                        ),
                        _ = recv slv_ep4.rdy => (
                            if (bentry == 2'd3){
                                let b = irecv b_mst_ep.res >>
                                isend slv_ep4.res(b)
                            }
                            else{
                                dprint "Something went wrong! | bentry = %d\n vs id = 2'd3" (bentry) >>
                                cycle 1 >>
                                recurse X
                            }
                        )
                    } 
                }
            }
            
        } >>
        cycle 1
    }

}

proc master_write(master_write_address_itfc, master_write_data_itfc, master_write_response_itfc){
    reg mem : byte[256];
    reg cyc : logic[32];
    reg addresses : logic[16][8];
    reg data_ready_at : logic[16][32];
    reg response_ready_at : logic[16][32];
    reg address_write : logic[5];
    reg data_read : logic[5];
    reg response_read : logic[5];
    loop{
        rec WaitSlot {
            if ((*address_write - *response_read) == 5'd16) {
                cycle 1 >> recurse WaitSlot
            } else { () }
        } >>
        send mst_ep_aw.rdy(()) >>
        let req = recv mst_ep_aw.req >>
        dprint "[Cycle %d] Master received aw req with addr %d" (*cyc, req.addr) >>
        (
            set addresses[(*address_write)[0+:4]] := req.addr[0+:8];
            set data_ready_at[(*address_write)[0+:4]] := *cyc + 32'd2;
            set address_write := *address_write + 5'd1
        ) >>
        cycle 5
    }
    loop{
        rec WaitData {
            if ((*data_read != *address_write) && (*data_ready_at[(*data_read)[0+:4]] <= *cyc)) { () }
            else { cycle 1 >> recurse WaitData }
        } >>
        send mst_ep_w.rdy(()) >>
        let wdata = recv mst_ep_w.req >>
        dprint "[Cycle %d] Master received w req with data %d" (*cyc, wdata.data) >>
        (
            set mem[*addresses[(*data_read)[0+:4]]] := wdata.data;
            set response_ready_at[(*data_read)[0+:4]] := *cyc + 32'd2;
            set data_read := *data_read + 5'd1
        ) >>
        cycle 1
    }
    loop{
        rec WaitResponse {
            if ((*response_read != *data_read) && (*response_ready_at[(*response_read)[0+:4]] <= *cyc)) { () }
            else { cycle 1 >> recurse WaitResponse }
        } >>
        send mst_ep_b.rdy(()) >>
        send mst_ep_b.res(b_pack_t::{resp = 1'b0}) >>
        dprint "[Cycle %d] Master sent b response" (*cyc) >>
        set response_read := *response_read + 5'd1 >>
        cycle 1
    }
    loop{
        set cyc := *cyc + 32'd1
    }
}

proc slave_write<id : int>(slave_write_address_itfc, slave_write_data_itfc, slave_write_response_itfc){
    reg cyc : logic[32];
    reg data : logic[32];
    reg request_after : logic[32];
    reg pending_data : logic[16][32];
    reg data_ready_at : logic[16][32];
    reg write_ptr : logic[5];
    reg read_ptr : logic[5];
    loop{
        rec WaitReq {
            if ((*cyc >= *request_after) && (*cyc != 32'd0) && ((*cyc & (*cyc - 32'd1)) == 32'd0)
                && ((*write_ptr - *read_ptr) != 5'd16)) {
                cycle 2
            } else { cycle 1 >> recurse WaitReq }
        } >>
        let aid = id[0+:32] >>
        let aw = aw_pack_t::{addr = aid; prot = 1'b0} >>
        send write_req_ep.req(aw) >>
        let _ = recv write_req_ep.gnt >>
        dprint "[Cycle %d] Slave %d write aw addr %d selected" (*cyc, id[0+:2], aw.addr) >>
        // Four pipeline cycles and one recovery cycle preserve the stimulus cadence.
        (
            set pending_data[(*write_ptr)[0+:4]] := *data + aid;
            set data_ready_at[(*write_ptr)[0+:4]] := *cyc + 32'd2;
            set write_ptr := *write_ptr + 5'd1;
            set data := *data + 32'd1;
            set request_after := *cyc + 32'd5
        )
    }
    loop{
        rec WaitData {
            if ((*read_ptr != *write_ptr) && (*data_ready_at[(*read_ptr)[0+:4]] <= *cyc)) { () }
            else { cycle 1 >> recurse WaitData }
        } >>
        let aid = id[0+:32] >>
        let w = w_pack_t::{data = *pending_data[(*read_ptr)[0+:4]]; strb = 1'b1} >>
        rec SendData {
            send write_data_ep.rdy(()) >>
            try send write_data_ep.data(w) {
                dprint "[Cycle %d] Slave %d write data %d granted" (*cyc, id[0+:2], w.data)
            } else { cycle 1 >> recurse SendData }
        } >>
        set read_ptr := *read_ptr + 5'd1 >>
        cycle 1
    }
    loop{
        rec ReceiveResponse {
            send write_res_ep.rdy(()) >>
            try res = recv write_res_ep.res {
                dprint "[Cycle %d] Slave %d write response received" (*cyc, id[0+:2])
            } else { cycle 1 >> recurse ReceiveResponse }
        } >>
        cycle 1
    }
    loop{
        set cyc := *cyc + 32'd1
    }
}

proc test_mux_write(){

    pool p : mux_write_transaction_pool;
    spawn slave_write<0>[p.islv1_address, p.islv1_data, p.islv1_response];
    spawn slave_write<1>[p.islv2_address, p.islv2_data, p.islv2_response];
    spawn slave_write<2>[p.islv3_address, p.islv3_data, p.islv3_response];
    spawn slave_write<3>[p.islv4_address, p.islv4_data, p.islv4_response];
    spawn master_write[p.imst_address, p.imst_data, p.imst_response];
    spawn arbiter<aw_pack_t, aw_sel_pack_t>[p.iarb];
    spawn mux_aw_main[p.iaw];
    spawn mux_w_main[p.iw];
    spawn mux_b_main[p.ib];
    spawn fifo<select_t>[p.iwf];
    spawn fifo<select_t>[p.ibf];

    loop{
        cycle 1
    }
}
