import "type_mux_4p_write.anvil"

proc arbiter<T : type, T1 : type> (w_rr_arbiter_itfc){
    reg prio : logic[2];
    loop{
        let prio = *prio >>
        xoffer prio{
          x = recv slv_ep1.req => (
                let data = aw_sel_pack_t::{aw_pack = x; select = 2'd0} >>
                send aw_req_ep.req(data) >>
                let _ = recv aw_req_ep.gnt >>
                send slv_ep1.gnt(()) >>
                set prio := 2'd1
          ),
          x = recv slv_ep2.req => (
                let data = aw_sel_pack_t::{aw_pack = x; select = 2'd1} >>
                send aw_req_ep.req(data) >>
                let _ = recv aw_req_ep.gnt >>
                send slv_ep2.gnt(()) >>
                set prio := 2'd2
          ),
          x = recv slv_ep3.req => (
                let data = aw_sel_pack_t::{aw_pack = x; select = 2'd2} >>
                send aw_req_ep.req(data) >>
                let _ = recv aw_req_ep.gnt >>
                send slv_ep3.gnt(()) >>
                set prio := 2'd3
          ),
          x = recv slv_ep4.req => (
                let data = aw_sel_pack_t::{aw_pack = x; select = 2'd3} >>
                send aw_req_ep.req(data) >>
                let _ = recv aw_req_ep.gnt >>
                send slv_ep4.gnt(()) >>
                set prio := 2'd0
          )
        }
    }
}


proc mux_w_main(mux_w_main){
    reg cyc : logic[8];
    loop{
        offer{
            _ = recv w_fifo_ep.empty =>  (),
            _ = recv b_fifo_ep.full => (),
            # => (
                    try _ = recv w_mst_ep.rdy {
                        let wentry = recv w_fifo_ep.pop >>
                        send b_fifo_ep.push(wentry) >>
                        rec X  {
                            xoffer wentry{
                                _ = recv slv_ep1.rdy => (
                                    if (wentry == 2'd0){
                                        let data = recv slv_ep1.data >>
                                        send w_mst_ep.req(data)
                                    }
                                    else{
                                        dprint "[Cycle %d] Something went wrong! | wentry = %d\n vs id = 2'd0" (*cyc, wentry) >>
                                        cycle 1 >>
                                        recurse X
                                    }
                                ),
                                _ = recv slv_ep2.rdy => (
                                    if (wentry == 2'd1){
                                        let data = recv slv_ep2.data >>
                                        send w_mst_ep.req(data)
                                    }
                                    else{
                                        dprint "[Cycle %d] Something went wrong! | wentry = %d\n vs id = 2'd1" (*cyc, wentry) >>
                                        cycle 1 >>
                                        recurse X
                                    }
                                ),
                                _ = recv slv_ep3.rdy => (
                                    if (wentry == 2'd2){
                                        let data = recv slv_ep3.data >>
                                        send w_mst_ep.req(data)
                                    }
                                    else{
                                        dprint "[Cycle %d] Something went wrong! | wentry = %d\n vs id = 2'd2" (*cyc, wentry) >>
                                        cycle 1 >>
                                        recurse X
                                    }
                                ),
                                _ = recv slv_ep4.rdy => (
                                    if (wentry == 2'd3){
                                        let data = recv slv_ep4.data >>
                                        send w_mst_ep.req(data)
                                    }
                                    else{
                                        dprint "[Cycle %d] Something went wrong! | wentry = %d\n vs id = 2'd3" (*cyc, wentry) >>
                                        cycle 1 >>
                                        recurse X
                                    }
                                )
                            }
                        }
                    }
            )
        }  >>
        cycle 1
    } 
    loop{
        set cyc := *cyc + 8'd1
    }
}

proc mux_aw_main(mux_aw_main){
    reg cyc : logic[8];
    loop{
        let x = recv aw_req_ep.req >>
        let _ = recv aw_mst_ep.rdy >>
        rec X {
            try _ = recv fifo_ep.full {
                cycle 1 >>
                recurse X
            }
            else {
                send fifo_ep.push(x.select) >>
                send aw_mst_ep.req(x.aw_pack) >>
                send aw_req_ep.gnt(())
            }
        } >>
        cycle 1
    }
}

proc mux_b_main(mux_b_main){
    loop{
        try _ = recv b_fifo_ep.empty { ()}
        else{
            try _ = recv b_mst_ep.rdy {
                let bentry = recv b_fifo_ep.pop >>
                rec X{
                    xoffer bentry{
                        _ = recv slv_ep1.rdy => (
                            if (bentry == 2'd0){
                                let b = recv b_mst_ep.res >>
                                send slv_ep1.res(b)
                            }
                            else{
                                dprint "Something went wrong! | bentry = %d\n vs id = 2'd0" (bentry) >>
                                cycle 1 >>
                                recurse X
                            }
                        ),
                        _ = recv slv_ep2.rdy => (
                            if (bentry == 2'd1){
                                let b = recv b_mst_ep.res >>
                                send slv_ep2.res(b)
                            }
                            else{
                                dprint "Something went wrong! | bentry = %d\n vs id = 2'd1" (bentry) >>
                                cycle 1 >>
                                recurse X
                            }
                        ),
                        _ = recv slv_ep3.rdy => (
                            if (bentry == 2'd2){
                                let b = recv b_mst_ep.res >>
                                send slv_ep3.res(b)
                            }   
                            else{
                                dprint "Something went wrong! | bentry = %d\n vs id = 2'd2" (bentry) >>
                                cycle 1 >>
                                recurse X
                            }
                        ),
                        _ = recv slv_ep4.rdy => (
                            if (bentry == 2'd3){
                                let b = recv b_mst_ep.res >>
                                send slv_ep4.res(b)
                            }
                            else{
                                dprint "Something went wrong! | bentry = %d\n vs id = 2'd3" (bentry) >>
                                cycle 1 >>
                                recurse X
                            }
                        )
                    } 
                }
            }
            
        } >>
        cycle 1
    }

}

proc master_write(master_write_itfc){
    reg mem : byte[256];
    reg addr : logic[8];
    reg cyc : logic[8];
    loop{
        cycle 1 >>
        cycle 1 >>
        cycle 1 >>
        cycle 1 >>
        send mst_ep_aw.rdy(()) >>
        let req = recv mst_ep_aw.req >>
        dprint "[Cycle %d] Master received aw req with addr %d\n" (*cyc, req.addr) >>
        set addr := req.addr >>
        send mst_ep_w.rdy(()) >>
        let wdata = recv mst_ep_w.req >>
        dprint "[Cycle %d] Master received w req with data %d\n" (*cyc, wdata.data) >>
        set mem[*addr] := wdata.data >>
        send mst_ep_b.rdy (()) >>
        send mst_ep_b.res(b_pack_t::{resp = 1'b1}) >>
        cycle 1
    }
    loop{
        set cyc := *cyc + 8'd1
    }
}
    

proc slave_write<id : int>(slave_write_itfc){
    reg cyc : logic[8];
    reg counter : logic[8];
    reg last_counter : logic[8];
    reg state : logic[8];
    loop{
        let aid = id[0+:8] >>
        set state := *state + aid >>
        let res = aw_pack_t::{addr = *state; prot = 1'b0} >>
        send write_req_ep.req(res) >>
        dprint "[Cycle %d] Slave %d write req selected with addr %d\n" (*cyc, id, res.addr) >>
        let _ = recv write_req_ep.gnt >>
        dprint "[Cycle %d] Slave %d write req granted\n" (*cyc, id) >>
        rec x {
            send write_data_ep.rdy(()) >>
            let res = w_pack_t::{data = *cyc;strb = 1'b0} >>
            try send write_data_ep.data(res) {
                dprint "[Cycle %d] Slave %d write data sent with data %d\n" (*cyc, id, res.data)
            }
            else{
                cycle 1 >>
                recurse x
            }
        } >>
        rec Y {
            send write_res_ep.rdy(()) >>
            try res = recv write_res_ep.res {
                dprint "[Cycle %d] Slave %d write response received\n" (*cyc, id)
            }
            else{
                cycle 1 >>
                recurse Y
            }
        } >>
        cycle 1
    }
    loop{
        set cyc := *cyc + 8'd1
    }
}

proc test_mux_write(){

    pool p : mux_write_transaction_pool;
    spawn slave_write<1>[p.islv1];
    spawn slave_write<2>[p.islv2];
    spawn slave_write<3>[p.islv3];
    spawn slave_write<4>[p.islv4];
    spawn master_write[p.imst];
    spawn arbiter<aw_pack_t, aw_sel_pack_t>[p.iarb];
    spawn mux_aw_main[p.iaw];
    spawn mux_w_main[p.iw];
    spawn mux_b_main[p.ib];
    spawn fifo<select_t>[p.iwf];
    spawn fifo<select_t>[p.ibf];

    loop{
        cycle 20 >>
        dfinish
    }
}