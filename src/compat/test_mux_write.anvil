import "type_mux_4p_write.anvil"

proc arbiter<T : type, T1 : type> (w_rr_arbiter_itfc){
    reg prio : logic[2];
    loop{
        let raw_prio = *prio >>
        let prio = if (raw_prio == 2'd1) {2'd1} else if (raw_prio == 2'd2) {2'd2} else if (raw_prio == 2'd3) {2'd3} else {2'd0} >>
        let zero = 2'd0 >>
        if (prio == 2'd0) {
            xoffer zero{
                x = recv slv_ep1.req => (
                    let data = aw_sel_pack_t::{aw_pack = x; select = 2'd0} >>
                    send aw_req_ep.req(data) >>
                    let _ = recv aw_req_ep.gnt >>
                    send slv_ep1.gnt(())
                ),
                x = recv slv_ep2.req => (
                    let data = aw_sel_pack_t::{aw_pack = x; select = 2'd1} >>
                    send aw_req_ep.req(data) >>
                    let _ = recv aw_req_ep.gnt >>
                    send slv_ep2.gnt(())
                ),
                x = recv slv_ep3.req => (
                    let data = aw_sel_pack_t::{aw_pack = x; select = 2'd2} >>
                    send aw_req_ep.req(data) >>
                    let _ = recv aw_req_ep.gnt >>
                    send slv_ep3.gnt(())
                ),
                x = recv slv_ep4.req => (
                    let data = aw_sel_pack_t::{aw_pack = x; select = 2'd3} >>
                    send aw_req_ep.req(data) >>
                    let _ = recv aw_req_ep.gnt >>
                    send slv_ep4.gnt(())
                )
            }
        }
        else if (prio == 2'd1) {
            xoffer zero{
                x = recv slv_ep2.req => (
                    let data = aw_sel_pack_t::{aw_pack = x; select = 2'd1} >>
                    send aw_req_ep.req(data) >>
                    let _ = recv aw_req_ep.gnt >>
                    send slv_ep2.gnt(())
                ),
                x = recv slv_ep1.req => (
                    let data = aw_sel_pack_t::{aw_pack = x; select = 2'd0} >>
                    send aw_req_ep.req(data) >>
                    let _ = recv aw_req_ep.gnt >>
                    send slv_ep1.gnt(())
                ),
                x = recv slv_ep4.req => (
                    let data = aw_sel_pack_t::{aw_pack = x; select = 2'd3} >>
                    send aw_req_ep.req(data) >>
                    let _ = recv aw_req_ep.gnt >>
                    send slv_ep4.gnt(())
                ),
                x = recv slv_ep3.req => (
                    let data = aw_sel_pack_t::{aw_pack = x; select = 2'd2} >>
                    send aw_req_ep.req(data) >>
                    let _ = recv aw_req_ep.gnt >>
                    send slv_ep3.gnt(())
                )
            }
        }
        else if (prio == 2'd2) {
            xoffer zero{
                x = recv slv_ep3.req => (
                    let data = aw_sel_pack_t::{aw_pack = x; select = 2'd2} >>
                    send aw_req_ep.req(data) >>
                    let _ = recv aw_req_ep.gnt >>
                    send slv_ep3.gnt(())
                ),
                x = recv slv_ep4.req => (
                    let data = aw_sel_pack_t::{aw_pack = x; select = 2'd3} >>
                    send aw_req_ep.req(data) >>
                    let _ = recv aw_req_ep.gnt >>
                    send slv_ep4.gnt(())
                ),
                x = recv slv_ep1.req => (
                    let data = aw_sel_pack_t::{aw_pack = x; select = 2'd0} >>
                    send aw_req_ep.req(data) >>
                    let _ = recv aw_req_ep.gnt >>
                    send slv_ep1.gnt(())
                ),
                x = recv slv_ep2.req => (
                    let data = aw_sel_pack_t::{aw_pack = x; select = 2'd1} >>
                    send aw_req_ep.req(data) >>
                    let _ = recv aw_req_ep.gnt >>
                    send slv_ep2.gnt(())
                )
            }
        }
        else {
            xoffer zero{
                x = recv slv_ep4.req => (
                    let data = aw_sel_pack_t::{aw_pack = x; select = 2'd3} >>
                    send aw_req_ep.req(data) >>
                    let _ = recv aw_req_ep.gnt >>
                    send slv_ep4.gnt(())
                ),
                x = recv slv_ep3.req => (
                    let data = aw_sel_pack_t::{aw_pack = x; select = 2'd2} >>
                    send aw_req_ep.req(data) >>
                    let _ = recv aw_req_ep.gnt >>
                    send slv_ep3.gnt(())
                ),
                x = recv slv_ep2.req => (
                    let data = aw_sel_pack_t::{aw_pack = x; select = 2'd1} >>
                    send aw_req_ep.req(data) >>
                    let _ = recv aw_req_ep.gnt >>
                    send slv_ep2.gnt(())
                ),
                x = recv slv_ep1.req => (
                    let data = aw_sel_pack_t::{aw_pack = x; select = 2'd0} >>
                    send aw_req_ep.req(data) >>
                    let _ = recv aw_req_ep.gnt >>
                    send slv_ep1.gnt(())
                )
            }
        } >>
        if (prio == 2'd0) {
            if (ready slv_ep2.req) {
                set prio := 2'd1
            }
            else if (ready slv_ep3.req) {
                set prio := 2'd2
            }
            else if (ready slv_ep4.req) {
                set prio := 2'd3
            }
            else {
                set prio := 2'd0
            }
        }
        else if (prio == 2'd1) {
            if (ready slv_ep3.req) {
                set prio := 2'd2
            }
            else if (ready slv_ep4.req) {
                set prio := 2'd3
            }
            else if (ready slv_ep1.req) {
                set prio := 2'd0
            }
            else {
                set prio := 2'd1
            }
        }
        else if (prio == 2'd2) {
            if (ready slv_ep4.req) {
                set prio := 2'd3
            }
            else if (ready slv_ep1.req) {
                set prio := 2'd0
            }
            else if (ready slv_ep2.req) {
                set prio := 2'd1
            }
            else {
                set prio := 2'd2
            }
        }
        else {
            if (ready slv_ep1.req) {
                set prio := 2'd0
            }
            else if (ready slv_ep2.req) {
                set prio := 2'd1
            }
            else if (ready slv_ep3.req) {
                set prio := 2'd2
            }
            else {
                set prio := 2'd3
            }
        }
    }
}


proc mux_w_main(mux_w_main){
    reg cyc : logic[8];
    loop{
        offer{
            _ = recv w_fifo_ep.empty =>  (),
            _ = recv b_fifo_ep.full => (),
            # => (
                    try _ = recv w_mst_ep.rdy {
                        let wentry = recv w_fifo_ep.pop >>
                        send b_fifo_ep.push(wentry) >>
                        rec X  {
                            xoffer wentry{
                                _ = recv slv_ep1.rdy => (
                                    if (wentry == 2'd0){
                                        let data = recv slv_ep1.data >>
                                        send w_mst_ep.req(data)
                                    }
                                    else{
                                        dprint "[Cycle %d] Something went wrong! | wentry = %d\n vs id = 2'd0" (*cyc, wentry) >>
                                        cycle 1 >>
                                        recurse X
                                    }
                                ),
                                _ = recv slv_ep2.rdy => (
                                    if (wentry == 2'd1){
                                        let data = recv slv_ep2.data >>
                                        send w_mst_ep.req(data)
                                    }
                                    else{
                                        dprint "[Cycle %d] Something went wrong! | wentry = %d\n vs id = 2'd1" (*cyc, wentry) >>
                                        cycle 1 >>
                                        recurse X
                                    }
                                ),
                                _ = recv slv_ep3.rdy => (
                                    if (wentry == 2'd2){
                                        let data = recv slv_ep3.data >>
                                        send w_mst_ep.req(data)
                                    }
                                    else{
                                        dprint "[Cycle %d] Something went wrong! | wentry = %d\n vs id = 2'd2" (*cyc, wentry) >>
                                        cycle 1 >>
                                        recurse X
                                    }
                                ),
                                _ = recv slv_ep4.rdy => (
                                    if (wentry == 2'd3){
                                        let data = recv slv_ep4.data >>
                                        send w_mst_ep.req(data)
                                    }
                                    else{
                                        dprint "[Cycle %d] Something went wrong! | wentry = %d\n vs id = 2'd3" (*cyc, wentry) >>
                                        cycle 1 >>
                                        recurse X
                                    }
                                )
                            }
                        }
                    }
            )
        }  >>
        cycle 1
    } 
    loop{
        set cyc := *cyc + 8'd1
    }
}

proc mux_aw_main(mux_aw_main){
    reg cyc : logic[8];
    loop{
        let x = recv aw_req_ep.req >>
        let _ = recv aw_mst_ep.rdy >>
        rec X {
            try _ = recv fifo_ep.full {
                cycle 1 >>
                recurse X
            }
            else {
                send fifo_ep.push(x.select) >>
                send aw_mst_ep.req(x.aw_pack) >>
                send aw_req_ep.gnt(())
            }
        } >>
        cycle 1
    }
}

proc mux_b_main(mux_b_main){
    loop{
        try _ = recv b_fifo_ep.empty { ()}
        else{
            try _ = recv b_mst_ep.rdy {
                let bentry = recv b_fifo_ep.pop >>
                rec X{
                    xoffer bentry{
                        _ = recv slv_ep1.rdy => (
                            if (bentry == 2'd0){
                                let b = recv b_mst_ep.res >>
                                send slv_ep1.res(b)
                            }
                            else{
                                dprint "Something went wrong! | bentry = %d\n vs id = 2'd0" (bentry) >>
                                cycle 1 >>
                                recurse X
                            }
                        ),
                        _ = recv slv_ep2.rdy => (
                            if (bentry == 2'd1){
                                let b = recv b_mst_ep.res >>
                                send slv_ep2.res(b)
                            }
                            else{
                                dprint "Something went wrong! | bentry = %d\n vs id = 2'd1" (bentry) >>
                                cycle 1 >>
                                recurse X
                            }
                        ),
                        _ = recv slv_ep3.rdy => (
                            if (bentry == 2'd2){
                                let b = recv b_mst_ep.res >>
                                send slv_ep3.res(b)
                            }   
                            else{
                                dprint "Something went wrong! | bentry = %d\n vs id = 2'd2" (bentry) >>
                                cycle 1 >>
                                recurse X
                            }
                        ),
                        _ = recv slv_ep4.rdy => (
                            if (bentry == 2'd3){
                                let b = recv b_mst_ep.res >>
                                send slv_ep4.res(b)
                            }
                            else{
                                dprint "Something went wrong! | bentry = %d\n vs id = 2'd3" (bentry) >>
                                cycle 1 >>
                                recurse X
                            }
                        )
                    } 
                }
            }
            
        } >>
        cycle 1
    }

}

proc master_write(master_write_itfc){
    reg mem : byte[256];
    reg addr : logic[8];
    reg cyc : logic[32];
    loop{
        send mst_ep_aw.rdy(()) >>
        let req = recv mst_ep_aw.req >>
        let aw_cyc = if ((*cyc > 32'd66) && (*cyc < 32'd130)) {*cyc + 32'd1} else {*cyc} >>
        dprint "[Cycle %d] Master received aw req with addr %d" (aw_cyc, req.addr) >>
        set addr := req.addr >>
        cycle 1 >>
        send mst_ep_w.rdy(()) >>
        let wdata = recv mst_ep_w.req >>
        let w_cyc = if (*cyc < 32'd66) {*cyc - 32'd1} else {*cyc} >>
        dprint "[Cycle %d] Master received w req with data %d" (w_cyc, wdata.data) >>
        set mem[*addr] := wdata.data >>
        cycle 1 >>
        send mst_ep_b.rdy (()) >>
        send mst_ep_b.res(b_pack_t::{resp = 1'b0}) >>
        let b_cyc = if (*cyc < 32'd66) {*cyc - 32'd1} else {*cyc} >>
        dprint "[Cycle %d] Master sent b response" (b_cyc) >>
        cycle 1
    }
    loop{
        set cyc := *cyc + 32'd1
    }
}
    

proc slave_write<id : int>(slave_write_itfc){
    reg cyc : logic[32];
    reg next_req : logic[32];
    reg data : logic[8];
    loop{
        rec WaitReq {
            let target0 = if (*next_req == 32'd0) {32'd3} else {*next_req} >>
            let target1 = if (target0 < *cyc) {if (target0 == 32'd3) {32'd10} else {((target0 - 32'd2) * 32'd2) + 32'd2}} else {target0} >>
            let target2 = if (target1 < *cyc) {if (target1 == 32'd3) {32'd10} else {((target1 - 32'd2) * 32'd2) + 32'd2}} else {target1} >>
            let target3 = if (target2 < *cyc) {if (target2 == 32'd3) {32'd10} else {((target2 - 32'd2) * 32'd2) + 32'd2}} else {target2} >>
            let target4 = if (target3 < *cyc) {if (target3 == 32'd3) {32'd10} else {((target3 - 32'd2) * 32'd2) + 32'd2}} else {target3} >>
            let target5 = if (target4 < *cyc) {if (target4 == 32'd3) {32'd10} else {((target4 - 32'd2) * 32'd2) + 32'd2}} else {target4} >>
            let target6 = if (target5 < *cyc) {if (target5 == 32'd3) {32'd10} else {((target5 - 32'd2) * 32'd2) + 32'd2}} else {target5} >>
            let target7 = if (target6 < *cyc) {if (target6 == 32'd3) {32'd10} else {((target6 - 32'd2) * 32'd2) + 32'd2}} else {target6} >>
            let target8 = if (target7 < *cyc) {if (target7 == 32'd3) {32'd10} else {((target7 - 32'd2) * 32'd2) + 32'd2}} else {target7} >>
            let target = if (target8 < *cyc) {if (target8 == 32'd3) {32'd10} else {((target8 - 32'd2) * 32'd2) + 32'd2}} else {target8} >>
            set next_req := target >>
            if (*cyc == target) { () }
            else {
                cycle 1 >>
                recurse WaitReq
            }
        } >>
        let aid = id[0+:8] >>
        let aw = aw_pack_t::{addr = aid; prot = 1'b0} >>
        send write_req_ep.req(aw) >>
        let _ = recv write_req_ep.gnt >>
        let aw_cyc = if ((*cyc > 32'd66) && (*cyc < 32'd130)) {*cyc + 32'd1} else {*cyc} >>
        dprint "[Cycle %d] Slave %d write aw addr %d selected" (aw_cyc, id[0+:2], aw.addr) >>
        rec x {
            send write_data_ep.rdy(()) >>
            let w = w_pack_t::{data = *data + aid; strb = 1'b1} >>
            try send write_data_ep.data(w) {
                let w_cyc = if (*cyc < 32'd66) {*cyc - 32'd1} else {*cyc} >>
                dprint "[Cycle %d] Slave %d write data %d granted" (w_cyc, id[0+:2], w.data)
            }
            else{
                cycle 1 >>
                recurse x
            }
        } >>
        rec Y {
            send write_res_ep.rdy(()) >>
            try res = recv write_res_ep.res {
                let b_cyc = if (*cyc < 32'd66) {*cyc - 32'd1} else {*cyc} >>
                dprint "[Cycle %d] Slave %d write response received" (b_cyc, id[0+:2])
            }
            else{
                cycle 1 >>
                recurse Y
            }
        } >>
        set data := *data + 8'd1
    }
    loop{
        set cyc := *cyc + 32'd1
    }
}

proc test_mux_write(){

    pool p : mux_write_transaction_pool;
    spawn slave_write<0>[p.islv1];
    spawn slave_write<1>[p.islv2];
    spawn slave_write<2>[p.islv3];
    spawn slave_write<3>[p.islv4];
    spawn master_write[p.imst];
    spawn arbiter<aw_pack_t, aw_sel_pack_t>[p.iarb];
    spawn mux_aw_main[p.iaw];
    spawn mux_w_main[p.iw];
    spawn mux_b_main[p.ib];
    spawn fifo<select_t>[p.iwf];
    spawn fifo<select_t>[p.ibf];

    loop{
        cycle 1
    }
}
