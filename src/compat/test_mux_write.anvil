import "type_mux_4p_write.anvil"

proc fifo<T : type>(fifo_itfc){
    reg mem : T[8];
    reg read_ptr : logic[3];
    reg write_ptr : logic[3];
    reg full : logic;
    reg cyc : logic[8];
    loop{
        if(*full){
            rec X {
                try send push_ep.full(()) {()} >>
                try send pop_ep.pop(*mem[*read_ptr]){
                    (
                        set read_ptr := *read_ptr + 3'd1;
                        set full := 1'd0
                    ) >>
                    offer{
                        x = recv push_ep.push => (
                            let full = if(((*write_ptr + 3'd1) == *read_ptr)&&(~(probe pop_ep.pop))) {1'b1} else {1'b0} >>
                            set write_ptr := *write_ptr + 3'd1;
                            set mem[*write_ptr] := x;
                            set full := full
                        
                        ),
                        send pop_ep.pop(*mem[*read_ptr])=>(
                            set read_ptr := *read_ptr + 3'd1
                        )
                    }
                }
                else{
                    cycle 1 >>
                    recurse X
                }
            }

        }
        else if(*read_ptr == *write_ptr){
            rec Y {
                try send pop_ep.empty(()) {()} >>
                try x = recv push_ep.push {
                    (
                    set mem[*write_ptr] := x;
                    set write_ptr := *write_ptr + 3'd1
                    ) >>

                    offer{
                        x = recv push_ep.push => (
                            let full = if(((*write_ptr + 3'd1) == *read_ptr)&&(~(probe pop_ep.pop))) {1'b1} else {1'b0} >>
                            set write_ptr := *write_ptr + 3'd1;
                            set mem[*write_ptr] := x;
                            set full := full
                        
                        ),
                        send pop_ep.pop(*mem[*read_ptr])=>(
                            set read_ptr := *read_ptr + 3'd1
                        )
                    }
                } 
                else {
                    cycle 1 >>
                    recurse Y
                }
            }

        }
        else{
            offer{
                x = recv push_ep.push => (
                    let full = if(((*write_ptr + 3'd1) == *read_ptr)&&(~(probe pop_ep.pop))) {1'b1} else {1'b0} >>
                    set write_ptr := *write_ptr + 3'd1;
                    set mem[*write_ptr] := x;
                    set full := full
                ),
                send pop_ep.pop(*mem[*read_ptr])=>(
                    set read_ptr := *read_ptr + 3'd1
                )
            }
        }

    }
    loop{
        set cyc := *cyc + 8'd1
    }
}


proc arbiter<T : type, T1 : type> (rr_arbiter_itfc){
    reg prio : logic[2];
    loop{
        xoffer{
          x = recv slv_ep1.req => (
                let data = aw_sel_pack_t::{aw_pack = x; select = 2'd0} >>
                send aw_req_ep.req(data) >>
                let _ = recv aw_req_ep.gnt >>
                send slv_ep1.gnt(())
          ),
          x = recv slv_ep2.req => (
                let data = aw_sel_pack_t::{aw_pack = x; select = 2'd1} >>
                send aw_req_ep.req(data) >>
                let _ = recv aw_req_ep.gnt >>
                send slv_ep2.gnt(())
          ),
          x = recv slv_ep3.req => (
                let data = aw_sel_pack_t::{aw_pack = x; select = 2'd2} >>
                send aw_req_ep.req(data) >>
                let _ = recv aw_req_ep.gnt >>
                send slv_ep3.gnt(())
          ),
          x = recv slv_ep4.req => (
                let data = aw_sel_pack_t::{aw_pack = x; select = 2'd3} >>
                send aw_req_ep.req(data) >>
                let _ = recv aw_req_ep.gnt >>
                send slv_ep4.gnt(())
          )
        } >>
        set prio := *prio + 2'd1
    }
}


proc mux_w_main(mux_w_main){
    reg cyc : logic[8];
    loop{
        offer{
            _ = recv w_fifo_ep.empty =>  (),
            _ = recv b_fifo_ep.full => (),
            # => (
                    try _ = recv w_mst_ep.rdy {
                        let wentry = recv w_fifo_ep.pop >>
                        send b_fifo_ep.push(wentry) >>
                        rec X  {
                            xoffer wentry{
                                _ = recv slv_ep1.rdy => (
                                    if (wentry == 2'd0){
                                        let data = recv slv_ep1.data >>
                                        send w_mst_ep.req(data)
                                    }
                                    else{
                                        dprint "[Cycle %d] Something went wrong! | wentry = %d\n vs id = 2'd0" (*cyc, wentry) >>
                                        cycle 1 >>
                                        recurse X
                                    }
                                ),
                                _ = recv slv_ep2.rdy => (
                                    if (wentry == 2'd1){
                                        let data = recv slv_ep2.data >>
                                        send w_mst_ep.req(data)
                                    }
                                    else{
                                        dprint "[Cycle %d] Something went wrong! | wentry = %d\n vs id = 2'd1" (*cyc, wentry) >>
                                        cycle 1 >>
                                        recurse X
                                    }
                                ),
                                _ = recv slv_ep3.rdy => (
                                    if (wentry == 2'd2){
                                        let data = recv slv_ep3.data >>
                                        send w_mst_ep.req(data)
                                    }
                                    else{
                                        dprint "[Cycle %d] Something went wrong! | wentry = %d\n vs id = 2'd2" (*cyc, wentry) >>
                                        cycle 1 >>
                                        recurse X
                                    }
                                ),
                                _ = recv slv_ep4.rdy => (
                                    if (wentry == 2'd3){
                                        let data = recv slv_ep4.data >>
                                        send w_mst_ep.req(data)
                                    }
                                    else{
                                        dprint "[Cycle %d] Something went wrong! | wentry = %d\n vs id = 2'd3" (*cyc, wentry) >>
                                        cycle 1 >>
                                        recurse X
                                    }
                                )
                            }
                        }
                    }
            )
        }  >>
        cycle 1
    } 
    loop{
        set cyc := *cyc + 8'd1
    }
}



proc test_mux_write(){
    chan w_push_ep_le -- w_push_ep_ri : fifo_insert_ch<select_t> ;
    chan w_pop_ep_le -- w_pop_ep_ri : fifo_dequeue_ch<select_t> ;
    chan b_push_ep_le -- b_push_ep_ri : fifo_insert_ch<select_t> ;
    chan b_pop_ep_le -- b_pop_ep_ri : fifo_dequeue_ch<select_t> ;
    chan slv_ep_le1 -- slv_ep_ri1 : slv_ch<aw_pack_t> ;
    chan slv_ep_le2 -- slv_ep_ri2 : slv_ch<aw_pack_t> ;
    chan slv_ep_le3 -- slv_ep_ri3 : slv_ch<aw_pack_t> ;
    chan slv_ep_le4 -- slv_ep_ri4 : slv_ch<aw_pack_t> ;
    chan slv_res_ep_le1 -- slv_res_ep_ri1 : mux_ch<aw_sel_pack_t> ;

    chan slv_data_ep1 -- mux_data_ep1 : slv_w_ch<w_pack_t> ;
    chan slv_data_ep2 -- mux_data_ep2 : slv_w_ch<w_pack_t> ;
    chan slv_data_ep3 -- mux_data_ep3 : slv_w_ch<w_pack_t> ;
    chan slv_data_ep4 -- mux_data_ep4 : slv_w_ch<w_pack_t> ;
    chan mst_ep_w -- mux_ep_w : mst_ch<w_pack_t> ;

    spawn fifo<select_t>(w_push_ep_ri, w_pop_ep_ri);
    spawn fifo<select_t>(b_push_ep_ri, b_pop_ep_ri);
    spawn mux_w_main(mux_data_ep1, mux_data_ep2, mux_data_ep3, mux_data_ep4, w_pop_ep_le, b_push_ep_le,mst_ep_w);
    spawn arbiter<aw_pack_t, aw_sel_pack_t>(slv_ep_ri1, slv_ep_ri2, slv_ep_ri3, slv_ep_ri4, slv_res_ep_le1);
    loop{
        cycle 20 >>
        dfinish
    }
}