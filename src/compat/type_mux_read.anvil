interface fifo_itfc(push_ep : right fifo_insert_ch<select_t>, pop_ep : right fifo_dequeue_ch<select_t>) =  
                                                (
                                                    rec X . ^( pop_ep.pop : ^(push_ep.full, *);#1,
                                                       * :  ^(push_ep.full, *);#1;X
                                                     )
                                                  )
                                                                    + 
                                                  (
                                                    rec Y . ^(
                                                        push_ep.push : ^(pop_ep.empty, *);#1,
                                                        * : ^(pop_ep.empty, *);#1;Y
                                                    )
                                                  )
                                                     
                                                                    + 
                                                    (
                                                        &(push_ep.push , pop_ep.pop) ; #1
                                                    )


interface master_itfc(mst_ep_ar : right mst_ch<ar_pack_t>, mst_ep_r : left mst_ch<r_pack_t>) = mst_ep_ar.req ;#1;mst_ep_r.rdy;#1

interface slave_itfc(read_req_ep :left slv_ch<ar_pack_t>, read_res_ep : left slv_r_ch<r_pack_t>) =
            read_req_ep.req ; rec X . read_res_ep.rdy ; ^(read_res_ep.res,*:#1;X); #1

interface rr_arbiter_itfc(slv_ep1 : right slv_ch<ar_pack_t>, slv_ep2 : right slv_ch<ar_pack_t>, ar_req_ep : left reg_req<ar_sel_pack_t>) =

^( 
   slv_ep1.req : ar_req_ep.req,
   slv_ep2.req : ar_req_ep.req
) ; #1

interface spill_register_itfc(inp_ep : right reg_req<T>, out_ep : left reg_res<T>) = 
                    (inp_ep.req;#1) +  (&(inp_ep.req, out_ep.data : out_ep.spill , *)) + (out_ep.data;out_ep.spill;#1)

interface mux_ar_main (
    ar_req_ep : right reg_res<ar_sel_pack_t>,
    ar_mst_ep : left mst_ch <ar_pack_t>,
    fifo_ep : right fifo_insert_ch<select_t>
) =^(
        fifo_ep.full,
        * : ^(ar_req_ep.data : #fifo_ep.push  ; ar_mst_ep.req; #ar_req_ep.spill ,  *)
    ) ; #1
interface mux_r_main (
    r_res_ep : right reg_res<r_pack_t>,
    fifo_ep : right fifo_dequeue_ch<select_t>,
    slv_ep1 : right slv_r_ch<r_pack_t>,
    slv_ep2 : right slv_r_ch<r_pack_t>
) =^(
        fifo_ep.empty,
        * : ^(r_res_ep.data : #fifo_ep.pop ; rec X . ^(
                                                        slv_ep1.rdy : ((slv_ep1.res;#r_res_ep.spill) + (#1;X)),
                                                        slv_ep2.rdy : ((slv_ep2.res;#r_res_ep.spill) + (#1;X))
                                                      ), 
            *)
); #1

pool mux_read_transaction_pool {
    slv_ep1 -- arb_ep1 : slv_ch<ar_pack_t>,
    slv_ep2 -- arb_ep2 : slv_ch<ar_pack_t>,
    slv_res_ep1 -- mux_res_ep1 : slv_r_ch<r_pack_t>,
    slv_res_ep2 -- mux_res_ep2 : slv_r_ch<r_pack_t>,
    

    mst_r_ep -- reg_r_ep : reg_req<r_pack_t>,
    arb_ar_ep -- reg_ar_ep : reg_req<ar_pack_t>,
    mux_r_res_ep -- reg_r_res_ep : reg_res<r_pack_t>,
    mux_ar_res_ep -- reg_ar_res_ep : reg_res<ar_pack_t>,

    mst_ar_ep -- mux_mst_ep : mst_ch<ar_pack_t>,


    fifo_push_ep -- fifo_push_ep_ri : fifo_insert_ch<select_t>,
    fifo_pop_ep -- fifo_pop_ep_ri : fifo_dequeue_ch<select_t>;

    islv1 : slave_itfc(slv_ep1, slv_res_ep1),
    islv2 : slave_itfc(slv_ep2, slv_res_ep2),
    
    isr_ar : spill_register_itfc(reg_ar_ep, mux_ar_res_ep), 
    isr_r : spill_register_itfc(mst_r_ep, mux_r_res_ep),

    iarb : rr_arbiter_itfc(arb_ep1, arb_ep2, arb_ar_ep),
    
    imst : master_itfc(mux_mst_ep, mst_r_ep),
    imux_ar : mux_ar_main(mux_ar_res_ep, mux_mst_ep,  fifo_push_ep),
    imux_r : mux_r_main(mux_r_res_ep, fifo_pop_ep, mux_res_ep1, mux_res_ep2),
    ififo : fifo_itfc(fifo_push_ep_ri, fifo_pop_ep_ri)    
}