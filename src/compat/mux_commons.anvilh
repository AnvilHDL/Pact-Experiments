interface fifo_itfc(push_ep : right fifo_insert_ch<T>, pop_ep : right fifo_dequeue_ch<T>) =
    // FIFO of any depth >= 1. Empty until a push.
    (rec Empty . (
        ^(#pop_ep.empty, *);
        ^(#push_ep.push : #1, * : #1; Empty)
    ));
    // Push first, then pop in the same cycle; only a lone push fills it, only a lone pop empties it.
    ((rec Middle . ^(
        #push_ep.push : ^(#pop_ep.pop : #1; Middle,
                         * : #1; (Middle + (rec FullMiddle . (
                             ^(#push_ep.full, *);
                             ^(#pop_ep.pop : #1; (Middle + ()), * : #1; FullMiddle)
                         )))),
        * : ^(#pop_ep.pop : #1; (Middle + ()),
              * : #1; Middle)
    ))
     + (rec Full . (
        ^(#push_ep.full, *);
        ^(#pop_ep.pop : #1; ((rec AfterFull . ^(
                #push_ep.push : ^(#pop_ep.pop : #1; AfterFull,
                                 * : #1; (AfterFull + (rec FullAfterFull . (
                                     ^(#push_ep.full, *);
                                     ^(#pop_ep.pop : #1; (AfterFull + ()), * : #1; FullAfterFull)
                                 )))),
                * : ^(#pop_ep.pop : #1; (AfterFull + ()),
                      * : #1; AfterFull)
            )) + ()), * : #1; Full)
    )))

// Depth-8 FIFO: push first, then pop in the same cycle.
proc fifo<T : type>(fifo_itfc){
    reg mem : T[8];
    reg read_ptr : logic[3];
    reg write_ptr : logic[3];
    loop{
        rec Empty {
            try isend pop_ep.empty(()) {()} >>
            try x = irecv push_ep.push {
                set mem[*write_ptr] := x;
                set write_ptr := *write_ptr + 3'd1
            }
            else {
                cycle 1 >>
                recurse Empty
            }
        } >>
        rec Middle {
            try x = irecv push_ep.push {
                try isend pop_ep.pop(*mem[*read_ptr]) {
                    {
                        set mem[*write_ptr] := x;
                        set write_ptr := *write_ptr + 3'd1;
                        set read_ptr := *read_ptr + 3'd1
                    } >>
                    recurse Middle
                }
                else {
                    {
                        set mem[*write_ptr] := x;
                        set write_ptr := *write_ptr + 3'd1
                    } >>
                    if (*write_ptr == *read_ptr) {
                        rec Full {
                            try isend push_ep.full(()) {()} >>
                            try isend pop_ep.pop(*mem[*read_ptr]) {
                                set read_ptr := *read_ptr + 3'd1
                            }
                            else {
                                cycle 1 >>
                                recurse Full
                            }
                        } >>
                        recurse Middle
                    }
                    else {
                        recurse Middle
                    }
                }
            }
            else {
                try isend pop_ep.pop(*mem[*read_ptr]) {
                    set read_ptr := *read_ptr + 3'd1 >>
                    if (*write_ptr == *read_ptr) {
                        ()
                    }
                    else {
                        recurse Middle
                    }
                }
                else {
                    cycle 1 >>
                    recurse Middle
                }
            }
        }
    }
}
