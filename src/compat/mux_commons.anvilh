interface fifo_itfc(push_ep : right fifo_insert_ch<T>, pop_ep : right fifo_dequeue_ch<T>) =
    // Empty until a push; the next phase is full or neither full nor empty.
    (rec Empty . (
        ^(pop_ep.empty, *);
        ^(push_ep.push: #1, *: #1; Empty)
    ));
    (
        (rec Full . (
            ^(push_ep.full, *);
            ^(pop_ep.pop: #1, *: #1; Full)
        ))
        + (&(push_ep.push, pop_ep.pop); #1)
    )

// One-entry FIFO: each accepted push is followed by a pop before reuse.
proc fifo<T : type>(fifo_itfc){
    reg entry : T;
    loop{
        rec Empty {
            try send pop_ep.empty(()) {()} >>
            try x = recv push_ep.push {
                set entry := x
            }
            else {
                cycle 1 >>
                recurse Empty
            }
        } >>
        rec Full {
            try send push_ep.full(()) {()} >>
            try send pop_ep.pop(*entry) {
                cycle 1
            }
            else {
                cycle 1 >>
                recurse Full
            }
        }
    }
}
