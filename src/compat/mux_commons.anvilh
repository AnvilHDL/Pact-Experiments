interface fifo_itfc(push_ep : right fifo_insert_ch<T>, pop_ep : right fifo_dequeue_ch<T>) =
    // FIFO of any depth >= 1. Empty until a push.
    (rec Empty . (
        ^(pop_ep.empty, *);
        ^(push_ep.push : #1, * : #1; Empty)
    ));
    // Push and pop are independent unless full; the arms taken pick the next
    // state. Only a push alone can fill it and only a pop alone can empty it.
    ((rec Middle . &(push_ep.push : #1, pop_ep.pop : #1).(
        push_ep.push : (Middle + (rec FullMiddle . (
            ^(push_ep.full, *);
            ^(pop_ep.pop : #1; (Middle + ()), * : #1; FullMiddle)
        ))),
        pop_ep.pop : (Middle + ()),
        {push_ep.push, pop_ep.pop} : Middle
    ))
     + (rec Full . (
        ^(push_ep.full, *);
        ^(pop_ep.pop : #1; ((rec AfterFull . &(push_ep.push : #1, pop_ep.pop : #1).(
                push_ep.push : (AfterFull + (rec FullAfterFull . (
                    ^(push_ep.full, *);
                    ^(pop_ep.pop : #1; (AfterFull + ()), * : #1; FullAfterFull)
                ))),
                pop_ep.pop : (AfterFull + ()),
                {push_ep.push, pop_ep.pop} : AfterFull
            )) + ()), * : #1; Full)
    )))

// Depth-8 FIFO. Push and pop are independent unless it is empty or full; the
// arms taken decide whether equal pointers mean full or empty.
proc fifo<T : type>(fifo_itfc){
    reg mem : T[8];
    reg read_ptr : logic[3];
    reg write_ptr : logic[3];
    loop{
        rec Empty {
            try send pop_ep.empty(()) {()} >>
            try x = recv push_ep.push {
                set mem[*write_ptr] := x;
                set write_ptr := *write_ptr + 3'd1
            }
            else {
                cycle 1 >>
                recurse Empty
            }
        } >>
        rec Middle {
            offer {
                x = recv push_ep.push => (
                    set mem[*write_ptr] := x;
                    set write_ptr := *write_ptr + 3'd1
                ),
                send pop_ep.pop(*mem[*read_ptr]) => (
                    set read_ptr := *read_ptr + 3'd1
                )
            } match {
                push_ep.push => (
                    if (*write_ptr == *read_ptr) {
                        rec Full {
                            try send push_ep.full(()) {()} >>
                            try send pop_ep.pop(*mem[*read_ptr]) {
                                set read_ptr := *read_ptr + 3'd1
                            }
                            else {
                                cycle 1 >>
                                recurse Full
                            }
                        } >>
                        recurse Middle
                    }
                    else {
                        recurse Middle
                    }
                ),
                pop_ep.pop => (
                    if (*write_ptr == *read_ptr) {
                        ()
                    }
                    else {
                        recurse Middle
                    }
                ),
                {push_ep.push, pop_ep.pop} => recurse Middle
            }
        }
    }
}
