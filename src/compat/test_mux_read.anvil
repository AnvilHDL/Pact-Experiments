import "type_mux_read_simplified.anvil"


proc arbiter<T : type, T1 : type> (rr_arbiter_itfc){
    reg prio : logic[2];
    loop{
        let prio = *prio >>
        xoffer prio{
          x = recv slv_ep1.req => (
                let data = ar_sel_pack_t::{ar_pack = x; select = 2'd0} >>
                send ar_req_ep.req(data) >>
                let _ = recv ar_req_ep.gnt >>
                send slv_ep1.gnt(()) >>
                set prio := 2'd1
          ),
          x = recv slv_ep2.req => (
                let data = ar_sel_pack_t::{ar_pack = x; select = 2'd1} >>
                send ar_req_ep.req(data) >>
                let _ = recv ar_req_ep.gnt >>
                send slv_ep2.gnt(()) >>
                set prio := 2'd2
          ),
          x = recv slv_ep3.req => (
                let data = ar_sel_pack_t::{ar_pack = x; select = 2'd2} >>
                send ar_req_ep.req(data) >>
                let _ = recv ar_req_ep.gnt >>
                send slv_ep3.gnt(()) >>
                set prio := 2'd3
          ),
          x = recv slv_ep4.req => (
                let data = ar_sel_pack_t::{ar_pack = x; select = 2'd3} >>
                send ar_req_ep.req(data) >>
                let _ = recv ar_req_ep.gnt >>
                send slv_ep4.gnt(()) >>
                set prio := 2'd0
          )
        }
    }
}

proc mux_ar_main(mux_ar_main){
    reg cyc : logic[8];
    loop{
        let x = recv ar_req_ep.req >>
        let _ = recv ar_mst_ep.rdy >>
        rec X {
            try _ = recv fifo_ep.full {
                cycle 1 >>
                recurse X
            }
            else {
                send fifo_ep.push(x.select) >>
                send ar_mst_ep.req(x.ar_pack) >>
                send ar_req_ep.gnt(())
            }
        } >>
        cycle 1
    }
    loop{
        set cyc := *cyc + 8'd1
    }
}

proc mux_r_main(mux_r_main){
    loop{
        try _ = recv fifo_ep.empty { ()}
        else{
            try _ = recv r_res_ep.rdy {
                let rentry = recv fifo_ep.pop >>
                rec X{
                    xoffer rentry{
                        _ = recv slv_ep1.rdy => (
                            if (rentry == 2'd0){
                                let r = recv r_res_ep.res >>
                                send slv_ep1.res(r)
                            }
                            else{
                                dprint "Something went wrong! | rentry = %d\n vs id = 2'd0" (rentry) >>
                                cycle 1 >>
                                recurse X
                            }
                        ),
                        _ = recv slv_ep2.rdy => (
                            if (rentry == 2'd1){
                                let r = recv r_res_ep.res >>
                                send slv_ep2.res(r)
                            }
                            else{
                                dprint "Something went wrong! | rentry = %d\n vs id = 2'd1" (rentry) >>
                                cycle 1 >>
                                recurse X
                            }
                        ),
                        _ = recv slv_ep3.rdy => (
                            if (rentry == 2'd2){
                                let r = recv r_res_ep.res >>
                                send slv_ep3.res(r)
                            }
                            else{
                                dprint "Something went wrong! | rentry = %d\n vs id = 2'd2" (rentry) >>
                                cycle 1 >>
                                recurse X
                            }
                        ),
                        _ = recv slv_ep4.rdy => (
                            if (rentry == 2'd3){
                                let r = recv r_res_ep.res >>
                                send slv_ep4.res(r)
                            }
                            else{
                                dprint "Something went wrong! | rentry = %d\n vs id = 2'd3" (rentry) >>
                                cycle 1 >>
                                recurse X
                            }
                        )
                    } 
                }
            }
        } >>
        cycle 1
    }
}

proc master(master_itfc){
    reg mem : byte[256];
    reg addr : logic[8];
    reg cyc : logic[8];
    loop{
        cycle 1 >>
        cycle 1 >>
        cycle 1 >>
        cycle 1 >>
        send mst_ep_ar.rdy(()) >>
        let req = recv mst_ep_ar.req >>
        dprint "[Cycle %d] Master received ar req with addr %d\n" (*cyc, req.addr) >>
        set addr := req.addr >>
        send mst_ep_r.rdy(()) >>
        let r = r_pack_t::{data = *mem[*addr]; resp = 1'b1} >>
        send mst_ep_r.res(r) >>
        dprint "[Cycle %d] Master sent r res with data %d\n" (*cyc, r.data) >>
        cycle 1
    }
    loop{
        set cyc := *cyc + 8'd1
    }
}

proc slave<id : int>(slave_itfc){
    reg cyc : logic[8];
    reg state : logic[8];
    loop{
        let aid = id[0+:8] >>
        set state := *state + aid >>
        let req = ar_pack_t::{addr = *state; prot = 1'b0} >>
        send read_req_ep.req(req) >>
        dprint "[Cycle %d] Slave %d read req selected with addr %d\n" (*cyc, id, req.addr) >>
        let _ = recv read_req_ep.gnt >>
        dprint "[Cycle %d] Slave %d read req granted\n" (*cyc, id) >>
        rec X {
            send read_res_ep.rdy(()) >>
            try r = recv read_res_ep.res{
                dprint "[Cycle %d] Slave %d read response received with data %d\n" (*cyc, id, r.data)
            }
            else{
                cycle 1 >>
                recurse X
            }
        } >>
        cycle 1
    }
    loop{
        set cyc := *cyc + 8'd1
    }
}

proc test_mux_read(){

    pool p : mux_read_transaction_pool;

    spawn slave<1>[p.islv1];
    spawn slave<2>[p.islv2];
    spawn slave<3>[p.islv3];
    spawn slave<4>[p.islv4];
    spawn master[p.imst];
    spawn arbiter<ar_pack_t, ar_sel_pack_t>[p.iarb];
    spawn mux_ar_main[p.imux_ar];
    spawn mux_r_main[p.imux_r];
    spawn fifo<select_t>[p.ififo];

    loop{
        cycle 20 >>
        dfinish
    }
}
