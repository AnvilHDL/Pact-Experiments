import "type_mux_read_simplified.anvil"


proc arbiter<T : type, T1 : type> (r_rr_arbiter_itfc){
    reg prio : logic[2];
    loop{
        let prio = *prio >>
        xoffer prio{
          x = recv slv_ep1.req => (
                let data = ar_sel_pack_t::{ar_pack = x; select = 2'd0} >>
                send ar_req_ep.req(data) >>
                let _ = recv ar_req_ep.gnt >>
                isend slv_ep1.gnt(()) >>
                if (ready slv_ep2.req) {
                    set prio := 2'd1
                }
                else if (ready slv_ep3.req) {
                    set prio := 2'd2
                }
                else if (ready slv_ep4.req) {
                    set prio := 2'd3
                }
                else {
                    set prio := 2'd0
                }
          ),
          x = recv slv_ep2.req => (
                let data = ar_sel_pack_t::{ar_pack = x; select = 2'd1} >>
                send ar_req_ep.req(data) >>
                let _ = recv ar_req_ep.gnt >>
                isend slv_ep2.gnt(()) >>
                if (ready slv_ep3.req) {
                    set prio := 2'd2
                }
                else if (ready slv_ep4.req) {
                    set prio := 2'd3
                }
                else if (ready slv_ep1.req) {
                    set prio := 2'd0
                }
                else {
                    set prio := 2'd1
                }
          ),
          x = recv slv_ep3.req => (
                let data = ar_sel_pack_t::{ar_pack = x; select = 2'd2} >>
                send ar_req_ep.req(data) >>
                let _ = recv ar_req_ep.gnt >>
                isend slv_ep3.gnt(()) >>
                if (ready slv_ep4.req) {
                    set prio := 2'd3
                }
                else if (ready slv_ep1.req) {
                    set prio := 2'd0
                }
                else if (ready slv_ep2.req) {
                    set prio := 2'd1
                }
                else {
                    set prio := 2'd2
                }
          ),
          x = recv slv_ep4.req => (
                let data = ar_sel_pack_t::{ar_pack = x; select = 2'd3} >>
                send ar_req_ep.req(data) >>
                let _ = recv ar_req_ep.gnt >>
                isend slv_ep4.gnt(()) >>
                if (ready slv_ep1.req) {
                    set prio := 2'd0
                }
                else if (ready slv_ep2.req) {
                    set prio := 2'd1
                }
                else if (ready slv_ep3.req) {
                    set prio := 2'd2
                }
                else {
                    set prio := 2'd3
                }
          )
        }
    }
}

proc mux_ar_main(mux_ar_main){
    reg cyc : logic[8];
    loop{
        let x = recv ar_req_ep.req >>
        let _ = recv ar_mst_ep.rdy >>
        rec X {
            try _ = recv fifo_ep.full {
                cycle 1 >>
                recurse X
            }
            else {
                isend fifo_ep.push(x.select) >>
                isend ar_mst_ep.req(x.ar_pack) >>
                isend ar_req_ep.gnt(())
            }
        } >>
        cycle 1
    }
    loop{
        set cyc := *cyc + 8'd1
    }
}

proc mux_r_main(mux_r_main){
    reg rentry : select_t;
    reg rset : logic;
    loop{
        try _ = recv fifo_ep.empty { ()}
        else{
            try _ = recv r_res_ep.rdy {
                let rentry = irecv fifo_ep.pop >>
                rec X{
                    let rprio = (if(*rset == 1'd0){rentry} else {*rentry}) >>
                    xoffer rprio{
                        _ = irecv slv_ep1.rdy => (
                            if (rprio == 2'd0){
                                let r = irecv r_res_ep.res >>
                                isend slv_ep1.res(r)
                            }
                            else{
                                dprint "Something went wrong! | rprio = %d vs id = 2'd0" (rprio) >>
                                cycle 1 >>
                                recurse X
                            }
                        ),
                        _ = irecv slv_ep2.rdy => (
                            if (rprio == 2'd1){
                                let r = irecv r_res_ep.res >>
                                isend slv_ep2.res(r)
                            }
                            else{
                                dprint "Something went wrong! | rprio = %d vs id = 2'd1" (rprio) >>
                                cycle 1 >>
                                recurse X
                            }
                        ),
                        _ = irecv slv_ep3.rdy => (
                            if (rprio == 2'd2){
                                let r = irecv r_res_ep.res >>
                                isend slv_ep3.res(r)
                            }
                            else{
                                dprint "Something went wrong! | rprio = %d vs id = 2'd2" (rprio) >>
                                cycle 1 >>
                                recurse X
                            }
                        ),
                        _ = irecv slv_ep4.rdy => (
                            if (rprio == 2'd3){
                                let r = irecv r_res_ep.res >>
                                isend slv_ep4.res(r)
                            }
                            else{
                                dprint "Something went wrong! | rprio = %d vs id = 2'd3" (rprio) >>
                                cycle 1 >>
                                recurse X
                            }
                        ),
                        # => (
                            (
                                set rset := 1'd0;
                                set rentry := rprio
                            ) >>
                            recurse X
                        )
                    } 
                }
            }
        } >>
        cycle 1
    }
}

proc master_read(master_read_request_itfc, master_read_response_itfc){
    reg data : logic[32];
    reg cyc : logic[32];
    reg ready_at : logic[16][32];
    reg write_ptr : logic[5];
    reg read_ptr : logic[5];
    loop{
        rec WaitSlot {
            if ((*write_ptr - *read_ptr) == 5'd16) {
                cycle 1 >> recurse WaitSlot
            } else { () }
        } >>
        send mst_ep_ar.rdy(()) >>
        let req = recv mst_ep_ar.req >>
        dprint "[Cycle %d] Master received ar req with addr %d" (*cyc, req.addr) >>
        set ready_at[(*write_ptr)[0+:4]] := *cyc + 32'd2 >>
        set write_ptr := *write_ptr + 5'd1 >>
        cycle 2
    }
    loop{
        rec WaitResponse {
            if ((*read_ptr != *write_ptr) && (*ready_at[(*read_ptr)[0+:4]] <= *cyc)) { () }
            else { cycle 1 >> recurse WaitResponse }
        } >>
        let r = r_pack_t::{data = *data; resp = 1'b0} >>
        send mst_ep_r.rdy(()) >>
        dprint "[Cycle %d] Master sent r res with data %d" (*cyc, r.data) >>
        send mst_ep_r.res(r) >>
        set data := *data + 32'd1 >>
        set read_ptr := *read_ptr + 5'd1 >>
        cycle 1
    }
    loop{
        set cyc := *cyc + 32'd1
    }
}

proc slave_read<id : int>(slave_read_request_itfc, slave_read_response_itfc){
    reg cyc : logic[32];
    reg next_req : logic[32];
    loop{
        rec WaitReq {
            let target = if (*next_req == 32'd0) {32'd3} else {*next_req} >>
            if (*cyc == target) { () }
            else {
                if (target < *cyc) {
                    let next_target = if (target == 32'd3) {32'd10} else {((target - 32'd2) * 32'd2) + 32'd2} >>
                    set next_req := next_target
                }
                else {
                    ()
                } >>
                cycle 1 >>
                recurse WaitReq
            }
        } >>
        let aid = id[0+:32] >>
        let req = ar_pack_t::{addr = aid; prot = 1'b0} >>
        send read_req_ep.req(req) >>
        let _ = recv read_req_ep.gnt >>
        dprint "[Cycle %d] Slave %d read req selected with addr %d" (*cyc, id[0+:2], req.addr) >>
        cycle 2 >>
        cycle 1
    }
    loop{
        rec X {
            send read_res_ep.rdy(()) >>
            try r = recv read_res_ep.res{
                dprint "[Cycle %d] Slave %d read response received with data %d" (*cyc, id[0+:2], r.data)
            }
            else{
                cycle 1 >>
                recurse X
            }
        } >>
        cycle 1
    }
    loop{
        set cyc := *cyc + 32'd1
    }
}

proc test_mux_read(){

    pool p : mux_read_transaction_pool;

    spawn slave_read<0>[p.islv1_request, p.islv1_response];
    spawn slave_read<1>[p.islv2_request, p.islv2_response];
    spawn slave_read<2>[p.islv3_request, p.islv3_response];
    spawn slave_read<3>[p.islv4_request, p.islv4_response];
    spawn master_read[p.imst_request, p.imst_response];
    spawn arbiter<ar_pack_t, ar_sel_pack_t>[p.iarb];
    spawn mux_ar_main[p.imux_ar];
    spawn mux_r_main[p.imux_r];
    spawn fifo<select_t>[p.ififo];

    loop{
        cycle 1
    }
}
