import "type_spill_reg.anvil"

proc spill_reg <T: type> (spill_register_itfc){
    reg a : T;
    reg b : T;
    reg afull : logic;
    reg bfull : logic;
    // reg cyc : logic[8]; // debug/bookkeeping only
    loop{
        if (~ (*afull || *bfull)){
            let in_data = recv inp_ep.req >>
            set a := in_data;
            set afull := 1'b1;
            set bfull := 1'b0
        }
        else if (~ (*afull & *bfull)) {
            let out = if(*bfull){
                *b
            }
            else{
                *a
            } >>
            // dprint "[Cycle %d] Spill Register: Ready to send data %d" (*cyc, out) >>
            try send out_ep.data(out) {()} >>
            // dprint "[Cycle %d] Spill Register: Sent data %d, waiting for spill signal" (*cyc, out) >>
            (
            offer {
                in_data = irecv inp_ep.req => (
                    set a := in_data
                ),
                _ = irecv out_ep.spill => (
                    cycle 1
                ),
                # => (
                    cycle 1
                )
            };
            (
                if((ready inp_ep.req) && ~(ready out_ep.spill)){
                    let b = if(*bfull){
                        *b
                    }
                    else{
                        *a
                    } >>
                    set afull := 1'b1;
                    set bfull := 1'b1;
                    set b := b
                }
                else if (ready out_ep.spill&& ~(ready inp_ep.req)){
                    set afull := 1'b0;
                    set bfull := 1'b0
                }
                else if (ready out_ep.spill && ready inp_ep.req){
                    set afull := 1'b1;
                    set bfull := 1'b0
                }
                else{
                    let b = if(*bfull){
                        *b
                    }
                    else{
                        *a
                    } >>
                    set afull := 1'b0;
                    set bfull := 1'b1;
                    set b := b
                }
                    

            )
            )
        }
        else{
            rec X  {
                let out = *b >>
                try send out_ep.data(out) {()} >>
                try _ = irecv out_ep.spill{
                    set b := *a;
                    set afull := 1'b0;
                    set bfull := 1'b1
                }
                else {
                    set afull := *afull >>
                    recurse X
                }
            }
        

        }        
    }
    // loop{
    //     set cyc := *cyc + 8'd1
    // }
}


proc spill_master<T : type>(master_itfc){
    reg cyc : logic[8];

    // Schedule re-derived from the SystemVerilog testbench trace after the
    // stub periods were matched to fifo_test.sv (master %3, slave %7, plus the
    // power-of-two burst term). Each `cycle N` is the gap to the next event, so
    // the running sum is that event's absolute cycle in the SV trace.
    loop{
        cycle 2 >>
        send reg_ep.req(32'd0) >>
        dprint "[Cycle %d] Enqueued data %d\n" (*cyc, 8'd0) >>
        cycle 2 >>
        send reg_ep.req(32'd1) >>
        dprint "[Cycle %d] Enqueued data %d\n" (*cyc, 8'd1) >>
        cycle 2 >>
        send reg_ep.req(32'd0) >>
        dprint "[Cycle %d] Enqueued data %d\n" (*cyc, 8'd0) >>
        cycle 11 >>
        send reg_ep.req(32'd1) >>
        dprint "[Cycle %d] Enqueued data %d\n" (*cyc, 8'd1) >>
        cycle 18 >>
        send reg_ep.req(32'd0) >>
        dprint "[Cycle %d] Enqueued data %d\n" (*cyc, 8'd0) >>
        cycle 3 >>
        send reg_ep.req(32'd1) >>
        dprint "[Cycle %d] Enqueued data %d\n" (*cyc, 8'd1) >>
        cycle 21 >>
        send reg_ep.req(32'd0) >>
        dprint "[Cycle %d] Enqueued data %d\n" (*cyc, 8'd0) >>
        cycle 21 >>
        send reg_ep.req(32'd1) >>
        dprint "[Cycle %d] Enqueued data %d\n" (*cyc, 8'd1) >>
        cycle 10
    }
    loop{
        set cyc := *cyc + 8'd1
    }
}

proc spill_slave<T : type>(slave_itfc){
    reg cyc : logic[8];

    // Schedule re-derived from the SystemVerilog testbench trace after the
    // stub periods were matched to fifo_test.sv (master %3, slave %7, plus the
    // power-of-two burst term). Each `cycle N` is the gap to the next event, so
    // the running sum is that event's absolute cycle in the SV trace.
    loop{
        cycle 4 >>
        let r0 = recv reg_ep.data >>
        dprint "[Cycle %d] Received data %d\n" (*cyc, r0) >>
        isend reg_ep.spill(()) >>
        cycle 12 >>
        let r1 = recv reg_ep.data >>
        dprint "[Cycle %d] Received data %d\n" (*cyc, r1) >>
        isend reg_ep.spill(()) >>
        cycle 18 >>
        let r2 = recv reg_ep.data >>
        dprint "[Cycle %d] Received data %d\n" (*cyc, r2) >>
        isend reg_ep.spill(()) >>
        cycle 3 >>
        let r3 = recv reg_ep.data >>
        dprint "[Cycle %d] Received data %d\n" (*cyc, r3) >>
        isend reg_ep.spill(()) >>
        cycle 21 >>
        let r4 = recv reg_ep.data >>
        dprint "[Cycle %d] Received data %d\n" (*cyc, r4) >>
        isend reg_ep.spill(()) >>
        cycle 21 >>
        let r5 = recv reg_ep.data >>
        dprint "[Cycle %d] Received data %d\n" (*cyc, r5) >>
        isend reg_ep.spill(()) >>
        cycle 10
    }
    loop{
        set cyc := *cyc + 8'd1
    }
}

proc test_spill_reg(){
    pool p : spill_reg_pool;

    spawn spill_reg<logic[32]>[p.ispillreg];
    spawn spill_master<logic[32]>[p.imaster];
    spawn spill_slave<logic[32]>[p.islave];

    loop{
        cycle 84 >>
        dfinish >>
        cycle 1
    }

}
