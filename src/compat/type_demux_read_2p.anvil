interface fifo_itfc(push_ep : right fifo_insert_ch<select_t>, pop_ep : right fifo_dequeue_ch<select_t>) =
    // FIFO of any depth >= 1. Empty until a push.
    (rec Empty . (
        ^(#pop_ep.empty, *);
        ^(#push_ep.push : #1, * : #1; Empty)
    ));
    // Push first, then pop in the same cycle; only a lone push fills it, only a lone pop empties it.
    ((rec Middle . ^(
        #push_ep.push : ^(#pop_ep.pop : #1; Middle,
                         * : #1; (Middle + (rec FullMiddle . (
                             ^(#push_ep.full, *);
                             ^(#pop_ep.pop : #1; (Middle + ()), * : #1; FullMiddle)
                         )))),
        * : ^(#pop_ep.pop : #1; (Middle + ()),
              * : #1; Middle)
    ))
     + (rec Full . (
        ^(#push_ep.full, *);
        ^(#pop_ep.pop : #1; ((rec AfterFull . ^(
                #push_ep.push : ^(#pop_ep.pop : #1; AfterFull,
                                 * : #1; (AfterFull + (rec FullAfterFull . (
                                     ^(#push_ep.full, *);
                                     ^(#pop_ep.pop : #1; (AfterFull + ()), * : #1; FullAfterFull)
                                 )))),
                * : ^(#pop_ep.pop : #1; (AfterFull + ()),
                      * : #1; AfterFull)
            )) + ()), * : #1; Full)
    )))

interface demux_ar_main (
    fifo_ep : left fifo_insert_ch<select_t>,
    slv_ep : right slv_ar_ch<ar_pack_t>,
    mst_ep1 : left mast_ch<ar_pack_t>,
    mst_ep2 : left mast_ch<ar_pack_t>
) = ^(
    #slv_ep.ar_req : (mst_ep1.rdy; rec X . ^(#fifo_ep.full : #1;X, * : fifo_ep.push;#mst_ep1.req;#slv_ep.gnt))+ 
                    (mst_ep2.rdy; rec Y . ^(#fifo_ep.full : #1;Y, * : fifo_ep.push;#mst_ep2.req;#slv_ep.gnt)),
    *
    ) ; #1

interface demux_r_main (
    fifo_ep : left fifo_dequeue_ch<select_t>,
    slv_ep : right slv_r_ch<r_pack_t>,
    mst_ep1 : left mast_ch<r_pack_t>,
    mst_ep2 : left mast_ch<r_pack_t>
) =^(
        #fifo_ep.empty,
        * :  #fifo_ep.pop; (rec X . 
                                                    ^(
                                                      mst_ep1.rdy : ((#mst_ep1.res;slv_ep.r_res) + (#1;X)),
                                                      mst_ep2.rdy: ((#mst_ep2.res;slv_ep.r_res) + (#1;X))
                                                      )
                            )
); #1

interface master_itfc(mux_ep_ar : right mast_ch<ar_pack_t>, demux_ep_r : left mast_ch<r_pack_t>) = mux_ep_ar.rdy; mux_ep_ar.req; rec X .( demux_ep_r.rdy; ^(#demux_ep_r.res,*:#1;X)) ; #1

interface slave_itfc(slv_ep_ar : left slv_ar_ch<ar_pack_t> , slv_ep_r : left slv_r_ch<r_pack_t>) =
        F slv_ep_ar.ar_req;slv_ep_ar.gnt ; slv_ep_r.r_res; #1


pool demux_read_pool {
    slv_ep_ar -- demux_ep_ar : slv_ar_ch<ar_pack_t>,
    slv_ep_r -- demux_ep_r : slv_r_ch<r_pack_t>,

    mst_ep1_ar -- mst_ep1_ar_ri : mast_ch<ar_pack_t>,
    mst_ep1_r -- mst_ep1_r_ri : mast_ch<r_pack_t>,

    mst_ep2_ar -- mst_ep2_ar_ri : mast_ch<ar_pack_t>,
    mst_ep2_r -- mst_ep2_r_ri : mast_ch<r_pack_t>,


    fifo_insert_ep -- fifo_insert_ep_ri : fifo_insert_ch<select_t>,
    fifo_dequeue_ep -- fifo_dequeue_ep_ri : fifo_dequeue_ch<select_t>;

    slave : slave_itfc(slv_ep_ar , slv_ep_r),
    master1 : master_itfc(mst_ep1_ar_ri, mst_ep1_r_ri),
    master2 : master_itfc(mst_ep2_ar_ri, mst_ep2_r_ri),
    demux_ar : demux_ar_main(fifo_insert_ep, slv_ep_ar, mst_ep1_ar, mst_ep2_ar),
    demux_r : demux_r_main(fifo_dequeue_ep, slv_ep_r, mst_ep1_r, mst_ep2_r),
    fifo : fifo_itfc(fifo_insert_ep_ri, fifo_dequeue_ep_ri)
}

// Channel alphabets and payloads used by this standalone benchmark.
chan fifo_insert_ch<Tp : type> {
    right push : (Tp@#1),
    left full : (void@#1)
}

chan fifo_dequeue_ch<Tp : type> {
    left pop : (Tp@#1) ,
    left empty : (void@#1)
}

type prot_t = logic[3];
type resp_t = logic[2];

type select_t = logic[2];
type A = logic[32];
type T = logic[32];
type byte = logic[32];

struct ar_pack_t {
    addr : A,
    prot : prot_t
}

struct r_pack_t {
    data : T,
    resp : resp_t
}

struct ar_ch {
    ar_pack : ar_pack_t,
    select : select_t
}

chan slv_ar_ch<Tp : type> {
    // The requester holds the request until granted.
    right ar_req : (Tp@gnt+1),
    left gnt : (void@#1)
}

chan slv_r_ch<Tp : type> {
    left r_res : (Tp@#1)
}

chan mast_ch<Tp : type> {
    left rdy : (void@#1),
    right req : (Tp@#1),
    right res : (Tp@#1)
}

chan mast_r_ch<Tp : type> {
    right rdy : (void@#1),
    right res : (Tp@#1)
}
