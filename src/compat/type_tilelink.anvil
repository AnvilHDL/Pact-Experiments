// A 2x2 TileLink crossbar on the A and D channels, as generated by
// chipsalliance TLCrossBar (16-bit address, 16-bit data, 2-bit source/sink,
// transfers of at most 2 bytes, so every message is a single beat).
// A is routed by address bit 0 and D by source; each output port has a
// round-robin arbiter.

// When the output is ready, grant one request.
interface arbiter_ifc(  ep1 : right arbiter_client_ch,
                        ep2 : right arbiter_client_ch,
                     server_ep : left arbiter_server_ch) =
    server_ep.rdy ; ^(#ep1.req, #ep2.req, *) ; #1

interface crossbar_itfc_A(client_ep1 : right client_ch, client_ep2 : right client_ch,
                        arb_cl_ep_le11 : left arbiter_client_ch, arb_cl_ep_le12 : left arbiter_client_ch,
                        arb_cl_ep_le21 : left arbiter_client_ch, arb_cl_ep_le22 : left arbiter_client_ch,
                        server1_ep : right server_ch, server2_ep : right server_ch
                        ) = (
    &(
        #client_ep1.req : (
                            (^(arb_cl_ep_le11.req : #client_ep1.fire;#server1_ep.req , *))
                                                                    +
                            (^(arb_cl_ep_le21.req : #client_ep1.fire;#server2_ep.req , *))
                         ),

        #client_ep2.req : (
                            (^(arb_cl_ep_le12.req : #client_ep2.fire;#server1_ep.req , *))
                                                                    +
                            (^(arb_cl_ep_le22.req : #client_ep2.fire;#server2_ep.req , *))
                        ),
        *
     )
     ;
    #1
)

interface crossbar_itfc_D(server1_ep : right server_r_ch, server2_ep : right server_r_ch,
                        arb_cl_ep_le11 : left arbiter_client_ch, arb_cl_ep_le12 : left arbiter_client_ch,
                        arb_cl_ep_le21 : left arbiter_client_ch, arb_cl_ep_le22 : left arbiter_client_ch,
                        client_ep1 : left client_r_ch, client_ep2 : left client_r_ch
                        ) = (
    (
    &(
        // A response whose source names no client is never taken.
        #server1_ep.req : (
                            (^(arb_cl_ep_le11.req : #server1_ep.fire;#client_ep1.res , *))
                                                                    +
                            (^(arb_cl_ep_le21.req : #server1_ep.fire;#client_ep2.res , *))
                                                                    +
                            ()
                         ),

        #server2_ep.req : (
                            (^(arb_cl_ep_le12.req : #server2_ep.fire;#client_ep1.res , *))
                                                                    +
                            (^(arb_cl_ep_le22.req : #server2_ep.fire;#client_ep2.res , *))
                                                                    +
                            ()
                        ),
        *
     )
    )
     ;
    #1
)

interface client_itfc(client_ep : left client_ch, res_arb_client : right arbiter_server_ch, client_crossbar_ep : right client_r_ch) =
   (^(res_arb_client.rdy : ^(client_crossbar_ep.res : #1, * : #1), * : #1) + #1) || (^(client_ep.req: ^(client_ep.fire : #1, * : #1), * : #1) + (#1))

// Each cycle the manager is ready for a request, offers a response beat, or waits.
interface manager_itfc(manager_ep : right arbiter_server_ch, manager_crossbar_ep : left server_ch, manager_crossbar_d_ep : left server_r_ch) =
    ^(manager_ep.rdy : ^(manager_crossbar_ep.req : #1, * : #1), * : #1)
    + ^(manager_crossbar_d_ep.req : ^(manager_crossbar_d_ep.fire : #1, * : #1), * : #1)
    + #1

pool tilelink{
    client_ep_le1 -- client_ep_ri1 : client_ch,
    client_ep_le2 -- client_ep_ri2 : client_ch,
    client_res_ep_le1 -- client_res_ep_ri1 : client_r_ch,
    client_res_ep_le2 -- client_res_ep_ri2 : client_r_ch,


    server_ep_le1 -- server_ep_ri1 : server_ch,
    server_ep_le2 -- server_ep_ri2 : server_ch,

    server_res_ep_le1 -- server_res_ep_ri1 : server_r_ch,
    server_res_ep_le2 -- server_res_ep_ri2 : server_r_ch,


    manager_ep_le1 -- manager_ep_ri1 : arbiter_server_ch,
    manager_ep_le2 -- manager_ep_ri2 : arbiter_server_ch,

    res_arb_client_le1 -- res_arb_client_ri1 : arbiter_server_ch,
    res_arb_client_le2 -- res_arb_client_ri2 : arbiter_server_ch,


    arb_cl_ep_le11 -- arb_cl_ep_ri11 : arbiter_client_ch,
    arb_cl_ep_le12 -- arb_cl_ep_ri12 : arbiter_client_ch,
    arb_cl_ep_le21 -- arb_cl_ep_ri21 : arbiter_client_ch,
    arb_cl_ep_le22 -- arb_cl_ep_ri22 : arbiter_client_ch,


    res_ma_ep_le11 -- res_ma_ep_ri11 : arbiter_client_ch,
    res_ma_ep_le12 -- res_ma_ep_ri12 : arbiter_client_ch,
    res_ma_ep_le21 -- res_ma_ep_ri21 : arbiter_client_ch,
    res_ma_ep_le22 -- res_ma_ep_ri22 : arbiter_client_ch;

    ic1 : client_itfc(client_ep_le1,res_arb_client_ri1, client_res_ep_ri1),
    ic2 : client_itfc(client_ep_le2,res_arb_client_ri2, client_res_ep_ri2),

    im1 : manager_itfc(manager_ep_ri1, server_ep_le1, server_res_ep_le1),
    im2 : manager_itfc(manager_ep_ri2, server_ep_le2, server_res_ep_le2),


    ia1 : arbiter_ifc(arb_cl_ep_ri11,arb_cl_ep_ri12, manager_ep_le1),
    ia2 : arbiter_ifc(arb_cl_ep_ri21,arb_cl_ep_ri22, manager_ep_le2),
    iares1 : arbiter_ifc(res_ma_ep_ri11,res_ma_ep_ri12, res_arb_client_le1),
    iares2 : arbiter_ifc(res_ma_ep_ri21,res_ma_ep_ri22, res_arb_client_le2),

    icrA : crossbar_itfc_A(
                        client_ep_ri1,client_ep_ri2,
                        arb_cl_ep_le11,arb_cl_ep_le12,
                        arb_cl_ep_le21,arb_cl_ep_le22,
                        server_ep_ri1, server_ep_ri2
                    ),
    icrD : crossbar_itfc_D(
                        server_res_ep_ri1,server_res_ep_ri2,
                        res_ma_ep_le11,res_ma_ep_le12,
                        res_ma_ep_le21,res_ma_ep_le22,
                        client_res_ep_le1, client_res_ep_le2
                    )

}

struct tl_a_t {
    opcode : logic[3],
    param : logic[3],
    size : logic,
    source : logic[2],
    address : logic[16],
    mask : logic[2],
    data : logic[16],
    corrupt : logic
}

struct tl_d_t {
    opcode : logic[3],
    param : logic[3],
    size : logic,
    source : logic[2],
    sink : logic[2],
    denied : logic,
    data : logic[16],
    corrupt : logic
}

// Interface A chs
chan arbiter_client_ch {
    right req : (void@#1)
}

chan arbiter_server_ch {
    left rdy : (void@#1)
}

// `req` offers the beat every cycle it is valid; `fire` completes the transfer.
chan client_ch {
    right req : (tl_a_t@#1),
    right fire : (void@#1)
}

chan server_ch {
    left req : (tl_a_t@#1)
}



// Interface D chs
chan client_r_ch {
    right res : (tl_d_t@#1)
}

chan server_r_ch {
    right req : (tl_d_t@#1),
    right fire : (void@#1)
}
