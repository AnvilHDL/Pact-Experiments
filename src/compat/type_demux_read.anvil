interface fifo_itfc(push_ep : right fifo_insert_ch<select_t>, pop_ep : right fifo_dequeue_ch<select_t>) =  
                                                (
                                                    rec X . ^( pop_ep.pop : ^(push_ep.full, *);#1,
                                                       * :  ^(push_ep.full, *);#1;X
                                                     )
                                                  )
                                                                    + 
                                                  (
                                                    rec Y . ^(
                                                        push_ep.push : ^(pop_ep.empty, *);#1,
                                                        * : ^(pop_ep.empty, *);#1;Y
                                                    )
                                                  )
                                                     
                                                                    + 
                                                    (
                                                        &(push_ep.push , pop_ep.pop) ; #1
                                                    )


interface mux_ar_main (
    fifo_ep : left fifo_insert_ch<select_t>,
    slv_ep : right slv_ar_ch<ar_pack_t>,
    mst_ep1 : left mast_ch<ar_pack_t>,
    mst_ep2 : left mast_ch<ar_pack_t>,
    mst_ep3 : left mast_ch<ar_pack_t>,
    mst_ep4 : left mast_ch<ar_pack_t>
) = ^(
        fifo_ep.full,
        * : ^(slv_ep.ar_req : fifo_ep.push;(mst_ep1.req + mst_ep2.req + mst_ep3.req + mst_ep4.req),*)
    ) ; #1

interface mux_r_main (
    fifo_ep : left fifo_dequeue_ch<select_t>,
    slv_ep : right slv_r_ch<r_pack_t>,
    mst_ep1 : left mast_ch<r_pack_t>,
    mst_ep2 : left mast_ch<r_pack_t>,
    mst_ep3 : left mast_ch<r_pack_t>,
    mst_ep4 : left mast_ch<r_pack_t>
) =^(
        fifo_ep.empty,
        * :  #fifo_ep.pop; (rec X . 
                                                    ^(
                                                      mst_ep1.rdy : ((#mst_ep1.res;slv_ep.r_res) + (#1;X)),
                                                      mst_ep2.rdy: ((#mst_ep2.res;slv_ep.r_res) + (#1;X)),
                                                      mst_ep3.rdy: ((#mst_ep3.res;slv_ep.r_res) + (#1;X)),
                                                      mst_ep4.rdy: ((#mst_ep4.res;slv_ep.r_res) + (#1;X))
                                                      )
                            )
); #1

interface master_itfc(mux_ep_ar : right mux_ch, mux_ep_r : left mux_ch) = mux_ep_ar.req ; rec X . mux_ep_r.rdy; ^(mux_ep_r.res,*:#1;X) ; #1

interface slave_itfc(slv_ep_ar : left slv_ar_ch<ar_pack_t> , slv_ep_r : left slv_r_ch<r_pack_t>) =
         slv_ep_ar.ar_req ; slv_ep_r.r_res; #1


pool demux_read_pool {
    slv_ep_ar -- mux_ep_ar : slv_ar_ch<ar_pack_t>,
    slv_ep_r -- mux_ep_r : slv_r_ch<r_pack_t>,

    mst_ep1_ar -- mst_ep1_ar_ri : mast_ch<ar_pack_t>,
    mst_ep1_r -- mst_ep1_r_ri : mast_ch<r_pack_t>,

    mst_ep2_ar -- mst_ep2_ar_ri : mast_ch<ar_pack_t>,
    mst_ep2_r -- mst_ep2_r_ri : mast_ch<r_pack_t>,

    mst_ep3_ar -- mst_ep3_ar_ri : mast_ch<ar_pack_t>,
    mst_ep3_r -- mst_ep3_r_ri : mast_ch<r_pack_t>,

    mst_ep4_ar -- mst_ep4_ar_ri : mast_ch<ar_pack_t>,
    mst_ep4_r -- mst_ep4_r_ri : mast_ch<r_pack_t>,

    fifo_insert_ep -- fifo_insert_ep_ri : fifo_insert_ch<select_t>,
    fifo_dequeue_ep -- fifo_dequeue_ep_ri : fifo_dequeue_ch<select_t>;

    slave : slave_itfc(slv_ep_ar , slv_ep_r),
    master1 : master_itfc(mst_ep1_ar_ri, mst_ep1_r_ri),
    master2 : master_itfc(mst_ep2_ar_ri, mst_ep2_r_ri),
    master3 : master_itfc(mst_ep3_ar_ri, mst_ep3_r_ri),
    master4 : master_itfc(mst_ep4_ar_ri, mst_ep4_r_ri),
    mux_ar : mux_ar_main(fifo_insert_ep, slv_ep_ar, mst_ep1_ar, mst_ep2_ar, mst_ep3_ar, mst_ep4_ar),
    mux_r : mux_r_main(fifo_dequeue_ep, slv_ep_r, mst_ep1_r, mst_ep2_r, mst_ep3_r, mst_ep4_r),
    fifo : fifo_itfc(fifo_insert_ep_ri, fifo_dequeue_ep_ri)
}