import "type_stream_fifo.anvil"

proc stream_fifo<T : type>(stream_fifo_if){
    reg data : T[8];
    reg read_ptr : logic[3];
    reg write_ptr : logic[3];
    reg full : logic;

    loop{
        if(*full){
            send pop_ep.pop(*data[*read_ptr]) >>
            try x = irecv push_ep.push {
                set data[*write_ptr] := x;
                set write_ptr := *write_ptr + 3'd1;
                set read_ptr := *read_ptr + 3'd1
            }
            else {
                set full := 1'b0;
                set read_ptr := *read_ptr + 3'd1
            }
        }
        else if (*read_ptr == *write_ptr){
            let x = recv push_ep.push >>
            set data[*write_ptr] := x;
            set write_ptr := *write_ptr + 3'd1
        }
        else{
            offer{
                x = recv push_ep.push => (
                    let full = if(((*write_ptr + 3'd1) == *read_ptr)&&(~(probe pop_ep.pop))) {1'b1} else {1'b0} >>
                    set write_ptr := *write_ptr + 3'd1;
                    set data[*write_ptr] := x;
                    set full := full
                
                ),
                send pop_ep.pop(*data[*read_ptr])=>(
                    set read_ptr := *read_ptr + 3'd1
                )
            }
        }
    }
}

proc stream_fifo_master<T : type>(master_itfc){
    reg cyc : logic[8];

    // Schedule re-derived from the SystemVerilog testbench trace after the
    // stub periods were matched to fifo_test.sv (master %3, slave %7, plus the
    // power-of-two burst term). Each `cycle N` is the gap to the next event, so
    // the running sum is that event's absolute cycle in the SV trace.
    loop{
        cycle 2 >>
        send fifo_ep.push(32'd0) >>
        dprint "[Cycle %d] Pushed %d\n" (*cyc, 8'd0) >>
        cycle 3 >>
        send fifo_ep.push(32'd1) >>
        dprint "[Cycle %d] Pushed %d\n" (*cyc, 8'd1) >>
        cycle 3 >>
        send fifo_ep.push(32'd0) >>
        dprint "[Cycle %d] Pushed %d\n" (*cyc, 8'd0) >>
        cycle 3 >>
        send fifo_ep.push(32'd1) >>
        dprint "[Cycle %d] Pushed %d\n" (*cyc, 8'd1) >>
        cycle 3 >>
        send fifo_ep.push(32'd0) >>
        dprint "[Cycle %d] Pushed %d\n" (*cyc, 8'd0) >>
        cycle 3 >>
        send fifo_ep.push(32'd1) >>
        dprint "[Cycle %d] Pushed %d\n" (*cyc, 8'd1) >>
        cycle 3 >>
        send fifo_ep.push(32'd0) >>
        dprint "[Cycle %d] Pushed %d\n" (*cyc, 8'd0) >>
        cycle 3 >>
        send fifo_ep.push(32'd1) >>
        dprint "[Cycle %d] Pushed %d\n" (*cyc, 8'd1) >>
        cycle 3 >>
        send fifo_ep.push(32'd0) >>
        dprint "[Cycle %d] Pushed %d\n" (*cyc, 8'd0) >>
        cycle 3 >>
        send fifo_ep.push(32'd1) >>
        dprint "[Cycle %d] Pushed %d\n" (*cyc, 8'd1) >>
        cycle 3 >>
        send fifo_ep.push(32'd0) >>
        dprint "[Cycle %d] Pushed %d\n" (*cyc, 8'd0) >>
        cycle 3 >>
        send fifo_ep.push(32'd1) >>
        dprint "[Cycle %d] Pushed %d\n" (*cyc, 8'd1) >>
        cycle 3 >>
        send fifo_ep.push(32'd0) >>
        dprint "[Cycle %d] Pushed %d\n" (*cyc, 8'd0) >>
        cycle 3 >>
        send fifo_ep.push(32'd1) >>
        dprint "[Cycle %d] Pushed %d\n" (*cyc, 8'd1) >>
        cycle 3 >>
        send fifo_ep.push(32'd0) >>
        dprint "[Cycle %d] Pushed %d\n" (*cyc, 8'd0) >>
        cycle 3 >>
        send fifo_ep.push(32'd1) >>
        dprint "[Cycle %d] Pushed %d\n" (*cyc, 8'd1) >>
        cycle 4 >>
        send fifo_ep.push(32'd0) >>
        dprint "[Cycle %d] Pushed %d\n" (*cyc, 8'd0) >>
        cycle 7 >>
        send fifo_ep.push(32'd1) >>
        dprint "[Cycle %d] Pushed %d\n" (*cyc, 8'd1) >>
        cycle 7 >>
        send fifo_ep.push(32'd0) >>
        dprint "[Cycle %d] Pushed %d\n" (*cyc, 8'd0) >>
        cycle 7 >>
        send fifo_ep.push(32'd1) >>
        dprint "[Cycle %d] Pushed %d\n" (*cyc, 8'd1) >>
        cycle 7 >>
        send fifo_ep.push(32'd0) >>
        dprint "[Cycle %d] Pushed %d\n" (*cyc, 8'd0) >>
        cycle 10
    }
    loop{
        set cyc := *cyc + 8'd1
    }
}

proc stream_fifo_slave<T : type>(slave_itfc){
    // Schedule re-derived from the SystemVerilog testbench trace after the
    // stub periods were matched to fifo_test.sv (master %3, slave %7, plus the
    // power-of-two burst term). Each `cycle N` is the gap to the next event, so
    // the running sum is that event's absolute cycle in the SV trace.
    // The printed cycle is a literal here (as upstream), so it must carry the
    // SV trace's absolute cycle for the trace diff to line up.
    loop{
        cycle 3 >>
        let p0 = recv fifo_ep.pop >>
        dprint "[Cycle %d] Popped %d\n" (8'd3, p0) >>
        cycle 6 >>
        let p1 = recv fifo_ep.pop >>
        dprint "[Cycle %d] Popped %d\n" (8'd9, p1) >>
        cycle 7 >>
        let p2 = recv fifo_ep.pop >>
        dprint "[Cycle %d] Popped %d\n" (8'd16, p2) >>
        cycle 7 >>
        let p3 = recv fifo_ep.pop >>
        dprint "[Cycle %d] Popped %d\n" (8'd23, p3) >>
        cycle 7 >>
        let p4 = recv fifo_ep.pop >>
        dprint "[Cycle %d] Popped %d\n" (8'd30, p4) >>
        cycle 4 >>
        let p5 = recv fifo_ep.pop >>
        dprint "[Cycle %d] Popped %d\n" (8'd34, p5) >>
        cycle 3 >>
        let p6 = recv fifo_ep.pop >>
        dprint "[Cycle %d] Popped %d\n" (8'd37, p6) >>
        cycle 7 >>
        let p7 = recv fifo_ep.pop >>
        dprint "[Cycle %d] Popped %d\n" (8'd44, p7) >>
        cycle 7 >>
        let p8 = recv fifo_ep.pop >>
        dprint "[Cycle %d] Popped %d\n" (8'd51, p8) >>
        cycle 7 >>
        let p9 = recv fifo_ep.pop >>
        dprint "[Cycle %d] Popped %d\n" (8'd58, p9) >>
        cycle 7 >>
        let p10 = recv fifo_ep.pop >>
        dprint "[Cycle %d] Popped %d\n" (8'd65, p10) >>
        cycle 7 >>
        let p11 = recv fifo_ep.pop >>
        dprint "[Cycle %d] Popped %d\n" (8'd72, p11) >>
        cycle 7 >>
        let p12 = recv fifo_ep.pop >>
        dprint "[Cycle %d] Popped %d\n" (8'd79, p12) >>
        cycle 10
    }
}

proc test_stream_fifo(){
    pool p : fifo_pool;

    spawn stream_fifo<byte>[p.ififo];
    spawn stream_fifo_master<byte>[p.imaster];
    spawn stream_fifo_slave<byte>[p.islave];

    loop{
        cycle 84 >>
        dfinish >>
        cycle 1
    }
}
