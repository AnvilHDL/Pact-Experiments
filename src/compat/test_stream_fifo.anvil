        dprint "[Cycle %d] Popped %d\n" (8'd82, p19) >>
        cycle 1
    }
}

proc test_stream_fifo(){
    pool p : fifo_pool;

    spawn stream_fifo<byte>[p.ififo];
    spawn stream_fifo_master<byte>[p.imaster];
    spawn stream_fifo_slave<byte>[p.islave];

    loop{
        cycle 84 >>
        dfinish >>
        cycle 1
    }
}
