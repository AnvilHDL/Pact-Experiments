import "type_stream_fifo.anvil"

proc stream_fifo<T : type>(stream_fifo_if){
    reg data : T[8];
    reg read_ptr : logic[3];
    reg write_ptr : logic[3];
    reg full : logic;

    loop{
        if(*full){
            send pop_ep.pop(*data[*read_ptr]) >>
            try x = recv push_ep.push {
                set data[*write_ptr] := x;
                set write_ptr := *write_ptr + 3'd1;
                set read_ptr := *read_ptr + 3'd1
            }
            else {
                set full := 1'b0;
                set read_ptr := *read_ptr + 3'd1
            }
        }
        else if (*read_ptr == *write_ptr){
            let x = recv push_ep.push >>
            set data[*write_ptr] := x;
            set write_ptr := *write_ptr + 3'd1
        }
        else{
            offer{
                x = recv push_ep.push => (
                    let full = if(((*write_ptr + 3'd1) == *read_ptr)&&(~(probe pop_ep.pop))) {1'b1} else {1'b0} >>
                    set write_ptr := *write_ptr + 3'd1;
                    set data[*write_ptr] := x;
                    set full := full
                
                ),
                send pop_ep.pop(*data[*read_ptr])=>(
                    set read_ptr := *read_ptr + 3'd1
                )
            }
        }
    }
}

proc stream_fifo_master<T : type>(master_itfc){
    reg cyc : logic[8];

    loop{
        cycle 2 >>
        send fifo_ep.push(8'd0) >>
        dprint "[Cycle %d] Pushed %d\n" (*cyc, 8'd0) >>
        cycle 4 >>
        send fifo_ep.push(8'd1) >>
        dprint "[Cycle %d] Pushed %d\n" (*cyc, 8'd1) >>
        cycle 4 >>
        send fifo_ep.push(8'd0) >>
        dprint "[Cycle %d] Pushed %d\n" (*cyc, 8'd0) >>
        cycle 4 >>
        send fifo_ep.push(8'd1) >>
        dprint "[Cycle %d] Pushed %d\n" (*cyc, 8'd1) >>
        cycle 4 >>
        send fifo_ep.push(8'd0) >>
        dprint "[Cycle %d] Pushed %d\n" (*cyc, 8'd0) >>
        cycle 4 >>
        send fifo_ep.push(8'd1) >>
        dprint "[Cycle %d] Pushed %d\n" (*cyc, 8'd1) >>
        cycle 4 >>
        send fifo_ep.push(8'd0) >>
        dprint "[Cycle %d] Pushed %d\n" (*cyc, 8'd0) >>
        cycle 4 >>
        send fifo_ep.push(8'd1) >>
        dprint "[Cycle %d] Pushed %d\n" (*cyc, 8'd1) >>
        cycle 4 >>
        send fifo_ep.push(8'd0) >>
        dprint "[Cycle %d] Pushed %d\n" (*cyc, 8'd0) >>
        cycle 4 >>
        send fifo_ep.push(8'd1) >>
        dprint "[Cycle %d] Pushed %d\n" (*cyc, 8'd1) >>
        cycle 4 >>
        send fifo_ep.push(8'd0) >>
        dprint "[Cycle %d] Pushed %d\n" (*cyc, 8'd0) >>
        cycle 4 >>
        send fifo_ep.push(8'd1) >>
        dprint "[Cycle %d] Pushed %d\n" (*cyc, 8'd1) >>
        cycle 4 >>
        send fifo_ep.push(8'd0) >>
        dprint "[Cycle %d] Pushed %d\n" (*cyc, 8'd0) >>
        cycle 4 >>
        send fifo_ep.push(8'd1) >>
        dprint "[Cycle %d] Pushed %d\n" (*cyc, 8'd1) >>
        cycle 4 >>
        send fifo_ep.push(8'd0) >>
        dprint "[Cycle %d] Pushed %d\n" (*cyc, 8'd0) >>
        cycle 4 >>
        send fifo_ep.push(8'd1) >>
        dprint "[Cycle %d] Pushed %d\n" (*cyc, 8'd1) >>
        cycle 4 >>
        send fifo_ep.push(8'd0) >>
        dprint "[Cycle %d] Pushed %d\n" (*cyc, 8'd0) >>
        cycle 4 >>
        send fifo_ep.push(8'd1) >>
        dprint "[Cycle %d] Pushed %d\n" (*cyc, 8'd1) >>
        cycle 4 >>
        send fifo_ep.push(8'd0) >>
        dprint "[Cycle %d] Pushed %d\n" (*cyc, 8'd0) >>
        cycle 4 >>
        send fifo_ep.push(8'd1) >>
        dprint "[Cycle %d] Pushed %d\n" (*cyc, 8'd1) >>
        cycle 4 >>
        send fifo_ep.push(8'd0) >>
        dprint "[Cycle %d] Pushed %d\n" (*cyc, 8'd0) >>
        cycle 1
    }
    loop{
        set cyc := *cyc + 8'd1
    }
}

proc stream_fifo_slave<T : type>(slave_itfc){
    loop{
        cycle 3 >>
        let p0 = recv fifo_ep.pop >>
        dprint "[Cycle %d] Popped %d\n" (8'd3, p0) >>
        cycle 8 >>
        let p1 = recv fifo_ep.pop >>
        dprint "[Cycle %d] Popped %d\n" (8'd10, p1) >>
