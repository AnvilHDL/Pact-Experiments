import "common_cells.anvilh"

chan ar_mast_ch{
    left rdy : (logic@#1),
    right data : (logic[32]@#1)
}

interface master_itfc(mst_req_ep : right ar_mast_ch,  mst_res_ep : left req_inp_ch<r_pack_t>) = #4 >> mst_req_ep.rdy >> mst_req_ep.data >> mst_res_ep.req >> #1 ;

proc ar_master (master_itfc) {
    reg mem : logic[8][32];
    reg addr : A;
    reg cyc : logic[8];
    loop{
        (
        generate (i : 0, 7, 1){
            set mem[i] := < (i) :: logic[32] > + 32'd1
        }) >>
        cycle 3 >>
        send mst_req_ep.rdy(1'd1) >>
        let addr_pack = recv mst_req_ep.data >>
        let res = *mem[addr_pack.addr[0+:3]] >>
        send mst_res_ep.req(r_pack_t::{data=res; resp = 2'd0}) >>
        dprint "[Cycle %d][Master] Received Address: %d | Sent Data: %d" (*cyc, addr_pack.addr[0+:3], res) >>
        set addr := *addr + 32'd4           
    }

    loop{
        set cyc := *cyc + 8'd1
    }
}