import "common_cells.anvilh"



interface master_itfc(mst_req_ep : right reg_out_ch<ar_sel_pack_t>,  mst_res_ep : left req_inp_ch<r_pack_t>) = #4 >> mst_req_ep.spill >> mst_res_ep.req >> #1 ;

proc ar_master (master_itfc) {
    reg mem : logic[8][32];
    reg addr : A;
    reg cyc : logic[8];
    loop{
        (
        generate (i : 0, 7, 1){
            set mem[i] := < (i) :: logic[32] >
        }) >>
        cycle 3 >>
        let addr_pack = recv mst_req_ep.spill >>
        dprint "[Cycle %d] Master received req for Address: %d" (*cyc, addr_pack.ar_pack.addr[0+:3]) >>
        let res = *mem[addr_pack.ar_pack.addr[0+:3]] >>
        send mst_res_ep.req(r_pack_t::{data=res; resp = 2'd0}) >>
        dprint "[Cycle %d] Received Address: %d | Sent Data: %d" (*cyc, addr_pack.ar_pack.addr[0+:3], res) >>
        set addr := *addr + 32'd4           
    }

    loop{
        set cyc := *cyc + 8'd1
    }
}