import "common_cells.anvilh"
import "ar_arbiter.anvil"
import "ar_slave.anvil"
import "spill_reg_ar.anvil"
import "ar_master.anvil"
import "../common_cells/fifo_v2.anvil"
import "read_mux.anvil"



pool read_transaction_pool {
    slv_ep1 -- arb_ep1 : arbiter_slave_ch,
    slv_ep2 -- arb_ep2 : arbiter_slave_ch,
    slv_ep3 -- arb_ep3 : arbiter_slave_ch,
    slv_ep4 -- arb_ep4 : arbiter_slave_ch,
    slv_ep5 -- arb_ep5 : arbiter_slave_ch,
    slv_ep6 -- arb_ep6 : arbiter_slave_ch,
    slv_ep7 -- arb_ep7 : arbiter_slave_ch,
    slv_ep8 -- arb_ep8 : arbiter_slave_ch,
    
    slv_ep_r_1 -- mux_ep_r_1 : slv_r_ch<r_pack_t>,
    slv_ep_r_2 -- mux_ep_r_2 : slv_r_ch<r_pack_t>,
    slv_ep_r_3 -- mux_ep_r_3 : slv_r_ch<r_pack_t>,
    slv_ep_r_4 -- mux_ep_r_4 : slv_r_ch<r_pack_t>,
    slv_ep_r_5 -- mux_ep_r_5 : slv_r_ch<r_pack_t>,
    slv_ep_r_6 -- mux_ep_r_6 : slv_r_ch<r_pack_t>,
    slv_ep_r_7 -- mux_ep_r_7 : slv_r_ch<r_pack_t>,
    slv_ep_r_8 -- mux_ep_r_8 : slv_r_ch<r_pack_t>,

    arb_reg_ep -- reg_arb_ep : req_inp_ch<ar_sel_pack_t>,
    reg_mst_ep -- mux_reg_ep : reg_out_ch<ar_sel_pack_t>,

    mst_ep_reg -- reg_ep_r : req_inp_ch<r_pack_t>,
    reg_ep_slv -- mux_ep_r : reg_out_ch<r_pack_t>,

    mux_ep_mst -- mst_ep_mux : ar_mast_ch,

    fifo_ep_le -- fifo_ep_ri : fifo_ch<select_t>;

    i1 : slave_itfc(slv_ep1 , slv_ep_r_1);
    i2 : slave_itfc(slv_ep2 , slv_ep_r_2);
    i3 : slave_itfc(slv_ep3 , slv_ep_r_3);
    i4 : slave_itfc(slv_ep4 , slv_ep_r_4);
    i5 : slave_itfc(slv_ep5 , slv_ep_r_5);
    i6 : slave_itfc(slv_ep6 , slv_ep_r_6);
    i7 : slave_itfc(slv_ep7 , slv_ep_r_7);
    i8 : slave_itfc(slv_ep8 , slv_ep_r_8);

    i9 : rr_arbiter_itfc(slv_ep1,slv_ep2, slv_ep3, slv_ep4, slv_ep5, slv_ep6, slv_ep7, slv_ep8, arb_reg_ep);
    i10 : spill_register_itfc(reg_arb_ep, mux_reg_ep);
    i11 : master_itfc(mst_ep_mux, mst_ep_reg);
    i12 : spill_register_itfc(reg_ep_r, reg_ep_slv);
    i13 : mux_main(mux_reg_ep, mux_ep_mst, mux_ep_r,  fifo_ep_ri, mux_ep_r_1, mux_ep_r_2, mux_ep_r_3, mux_ep_r_4, mux_ep_r_5, mux_ep_r_6, mux_ep_r_7, mux_ep_r_8);
    i14 : fifo_itfc(fifo_ep_le)
}

proc ar_top(){
    pool p1 : read_transaction_pool;
    spawn ar_slave<1>[p1.i1];
    spawn ar_slave<2>[p1.i2];
    spawn ar_slave<3>[p1.i3];
    spawn ar_slave<4>[p1.i4];
    spawn ar_slave<5>[p1.i5];
    spawn ar_slave<6>[p1.i6];
    spawn ar_slave<7>[p1.i7];
    spawn ar_slave<8>[p1.i8];
    spawn ar_arbiter[p1.i9];
    spawn spill_reg_ar<1,ar_sel_pack_t>[p1.i10];
    spawn ar_master[p1.i11];
    spawn spill_reg_ar<2,r_pack_t>[p1.i12];
    spawn read_mux[p1.i13];
    spawn fifo<select_t, 8,3> [p1.i14];
    loop{
        cycle 1
    }
    loop{
        cycle 100 >>
        dfinish
    }

}