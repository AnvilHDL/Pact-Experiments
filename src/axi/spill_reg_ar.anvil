import "common_cells.anvilh"

chan  req_inp_ch<T : type> {
    right req : (T@#1)
}

chan reg_out_ch<T : type>{
    right spill : (T@#1)
}


interface spill_register_itfc(inp_ep : right req_inp_ch<T>, out_ep : left reg_out_ch<T>) = ((inp_ep.req >> #1) +  (&(inp_ep.req: #1, out_ep.spill: #1, *:#1)) + (out_ep.spill >> #1)) ;

proc spill_reg_ar<id: int , T : type> (spill_register_itfc){
    reg a : T;
    reg b : T;
    reg afull : logic;
    reg bfull : logic;
    reg cyc : logic[8];
    loop{
        // dprint "[Cycle %d] [Spill Reg %d] Afull: %b | Bfull: %b" (*cyc, id, *afull, *bfull) >>
        if (~ (*afull || *bfull)){
            dprint "[Cycle %d][Spill Reg %d] Receiving data into spill reg | Cant do anything else (empty)" (*cyc, id) >>
            let in_data = recv inp_ep.req >>
            set a := in_data;
            set afull := 1'b1;
            set bfull := 1'b0
        }
        else if (~ (*afull & *bfull)) {
            let out = if(*bfull){
                *b
            }
            else{
                *a
            } >>
            offer {
                in_data = recv inp_ep.req => (
                    let r = ready inp_ep.req >>
                    let a = probe inp_ep.req >>
                    // dprint "[Cycle %d] [Spill Reg %d] Receiving data into spill reg %b | %b" (*cyc, id, a, r) >>
                    set a := in_data;
                    set afull := 1'b1;
                    if ((~(probe out_ep.spill))&&(*afull == 1'b1)){
                        set b := *a;
                        set bfull := 1'b1
                    }
                    else{
                        cycle 1
                    }

                ),
                send out_ep.spill(out) => (
                    // dprint "[Cycle %d] [Spill Reg %d] Sending out data from spill reg" (*cyc, id) >>
                    if(*bfull){
                        set bfull := 1'b0
                    }
                    else{
                        set b := *a;
                        set afull := 1'b0;
                        set bfull := 1'b1
                    }
                ),
                # => (
                    // dprint "[Cycle %d] [Spill Reg %d] No activity, maintaining state" (*cyc, id) >>
                    (
                        let v = ready out_ep.spill >>
                        let r = probe out_ep.spill >>
                        // dprint "[Cycle %d] [Spill Reg %d] No activity,| vld for spill reg %b | ack %b" (*cyc, id, v, r) >>
                        if (*afull){
                            set afull := 1'b0;
                            set b := *a;
                            set bfull := 1'b1
                        }
                        else{
                            cycle 1
                        }
                    )
                )
            }
                
        }
        else {
            dprint "[Cycle %d][Spill Reg %d] Both full, only sending out data possible" (*cyc, id) >>
            send out_ep.spill(*b) >>
            //dprint "[Cycle %d] [Spill Reg %d] Sent out data from spill reg, moving a to b" (*cyc, id) >>
            set afull := 1'b0;
            set b := *a

        }
    }
    loop{
        set cyc := *cyc + 8'd1
    }
}

