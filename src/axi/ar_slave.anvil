import "common_cells.anvilh"

// interface slave_itfc(req_ep :left arbiter_slave_ch , res_ep : right reg_out_ch) = req_ep.req >> &(req_ep.gnt : res_ep.spill >> #1 , *  : #1) ;

chan slv_r_ch<T : type>{
    left res : (T@#1) >>
}

chan slave_w_ch<T : type, U : type>{
    right wr_req : (T@#1) >>
    left b : (U@#1) >>
}
    

interface slave_itfc(r_req_ep :left arbiter_slave_ch<T1> , w_req_ep : left arbiter_slave_ch<T2> , slv_r_ep : left slv_r_ch<r_pack_t> , slv_w_ep : left slave_w_ch<w_pack_t,b_pack_t>) = r_req_ep.req >> r_req_ep.gnt >> slv_r_ep.res >> w_req_ep.req >> w_req_ep.gnt >> slv_w_ep.wr_req >> slv_w_ep.b >> #1 ;

proc ar_slave<id : int, T1 : type, T2: type> (slave_itfc) {
    reg addr : A;
    reg cyc : logic[8];
    loop{
            dprint "[Cycle %d][Slave %d] Slave sending req" (*cyc, id) >>
            send req_ep.req(ar_pack_t::{addr = *addr; prot = 3'b000}) >>
            let _ = recv req_ep.gnt >>
            dprint "[Cycle %d][Slave %d] Received Gnt" (*cyc, id) >>
            let data = recv slv_r_ep.res >>
            dprint "[Cycle %d][Slave %d] Received Data: %d" (*cyc, id, data.data) >>
            set addr := *addr + 32'd4 >>
            send w_req_ep.req(wr_pack_t::{data = data.data + 32'd1; strb = 4'b1111}) >>
            let _ = recv w_req_ep.gnt >>
            dprint "[Cycle %d][Slave %d] Write Completed" (*cyc, id) >>
            set addr := *addr + 32'd4
    }
    loop{
        set cyc := *cyc + 8'd1
    }
}