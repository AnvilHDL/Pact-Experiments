import "common_cells.anvilh"

// interface slave_itfc(req_ep :left arbiter_slave_ch , res_ep : right reg_out_ch) = req_ep.req >> &(req_ep.gnt : res_ep.spill >> #1 , *  : #1) ;

chan slv_r_ch<T : type>{
    left res : (T@#1) >>
}

interface slave_itfc(req_ep :left arbiter_slave_ch<T1> , slv_r_ep : left slv_r_ch<r_pack_t>) = req_ep.req >> req_ep.gnt >> slv_r_ep.res >> #1 ;


proc ar_slave<id : int, T1 : type> (slave_itfc) {
    reg addr : A;
    reg cyc : logic[8];
    loop{
            dprint "[Cycle %d][Slave %d] Slave sending req" (*cyc, id) >>
            send req_ep.req(ar_pack_t::{addr = *addr; prot = 3'b000}) >>
            let _ = recv req_ep.gnt >>
            dprint "[Cycle %d][Slave %d] Received Gnt" (*cyc, id) >>
            let data = recv slv_r_ep.res >>
            dprint "[Cycle %d][Slave %d] Received Data: %d" (*cyc, id, data.data) >>
            set addr := *addr + 32'd4
        
            // offer {
            //      _ = recv req_ep.gnt => (
            //         let x = recv res_ep.spill >>
            //         dprint "[Cycle %d] Received Data: %d" (*cyc, x.data) >>
            //         set addr := *addr + 32'd4
            //      ),
            //      # => (cycle 1)
            // }
    }       
    loop{
        set cyc := *cyc + 8'd1
    }
}