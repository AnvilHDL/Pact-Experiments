import "common_cells.anvilh"

// interface slave_itfc(req_ep :left arbiter_slave_ch , res_ep : right reg_out_ch) = req_ep.req >> &(req_ep.gnt : res_ep.spill >> #1 , *  : #1) ;

interface slave_itfc(req_ep :left arbiter_slave_ch , res_ep_R : right reg_out_ch<r_pack_t>) = req_ep.req >> req_ep.gnt >> res_ep_R.spill >> #1 ;


proc ar_slave(slave_itfc) {
    reg addr : A;
    reg cyc : logic[8];
    loop{
            dprint "[Cycle %d] Slave sending req" (*cyc) >>
            send req_ep.req(ar_pack_t::{addr = *addr; prot = 3'b000}) >>
            let _ = recv req_ep.gnt >>
            let data = recv res_ep_R.spill >>
            dprint "[Cycle %d] Received Data: %d" (*cyc, data.data) >>
            set addr := *addr + 32'd4
        
            // offer {
            //      _ = recv req_ep.gnt => (
            //         let x = recv res_ep.spill >>
            //         dprint "[Cycle %d] Received Data: %d" (*cyc, x.data) >>
            //         set addr := *addr + 32'd4
            //      ),
            //      # => (cycle 1)
            // }
    }       
    loop{
        set cyc := *cyc + 8'd1
    }
}