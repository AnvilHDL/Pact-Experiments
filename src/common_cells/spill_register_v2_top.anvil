chan reg_inp_ch<Tp : type> {
    right req : (Tp@#1)
}

chan reg_out_ch<Tp : type> {
    right spill : (Tp@#1) <<
}


interface spill_register_itfc(inp_ep : right reg_inp_ch<Tp>, out_ep : left reg_out_ch<Tp>) = ((inp_ep.req >> #1) +  (&(inp_ep.req: #1, out_ep.spill: #1, *:#1)) + (out_ep.spill >> #1)) ;

proc spill_register_v2 <Tp: type> (spill_register_itfc){
    reg a : Tp;
    reg b : Tp;
    reg afull : logic;
    reg bfull : logic;
    loop{
        if (~ (*afull || *bfull)){
            let in_data = recv inp_ep.req >>
            set a := in_data;
            set afull := 1'b1;
            set bfull := 1'b0
        }
        else if (~ (*afull & *bfull)) {
            let out = if(*bfull){
                *b
            }
            else{
                *a
            } >>
            offer {
                in_data = recv inp_ep.req => (
                    set a := in_data;
                    set afull := 1'b1
                ),
                send out_ep.spill(out) => (
                    if(*bfull){
                        set bfull := 1'b0
                    }
                    else{
                        set b := *a;
                        set bfull := 1'b1
                    }
                ),
                # => (
                    set afull := 1'b0;
                    set bfull := 1'b1;
                    if (*afull){
                        set b := *a
                    }
                    else{
                        set b := *b
                    }
                )
            }
                
        }
        else {
            send out_ep.spill(*b) >>
            set afull := 1'b0;
            set b := *a
        }
    }
}

proc spill_register_v2_top(){
    chan inp_ep_le -- inp_ep_ri : reg_inp_ch<logic[32]>;
    chan out_ep_le -- out_ep_ri : reg_out_ch<logic[32]>;
    spawn spill_register_v2<logic[32]>(inp_ep_le, out_ep_le);

    loop{
        cycle 100 >>
        dfinish >>
        cycle 1
    }

}