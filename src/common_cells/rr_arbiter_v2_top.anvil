chan arbiter_slave_ch<Tp : type> {
    left gnt : (logic@#1) @#1 - @dyn,
    right req : (Tp@#1) @dyn - @#1
}
chan  arbiter_master_ch<Tp : type> {
    right req : (Tp@#1),
    right sel : (logic[3]@#1) @#req - @#req
}
interface rr_arbiter_itfc(slv_ep1 : right arbiter_slave_ch<Tp>, slv_ep2 : right arbiter_slave_ch<Tp>, slv_ep3 : right arbiter_slave_ch<Tp>, slv_ep4 : right arbiter_slave_ch<Tp>, slv_ep5 : right arbiter_slave_ch<Tp>, slv_ep6 : right arbiter_slave_ch<Tp>, slv_ep7 : right arbiter_slave_ch<Tp>, slv_ep8 : right arbiter_slave_ch<Tp>, mst_ep : left arbiter_master_ch<Tp>) =  

^( #slv_ep1.req : mst_ep.req >> #mst_ep.sel >> #slv_ep1.gnt,
   #slv_ep2.req : mst_ep.req >> #mst_ep.sel >> #slv_ep2.gnt,
   #slv_ep3.req : mst_ep.req >> #mst_ep.sel >> #slv_ep3.gnt,
   #slv_ep4.req : mst_ep.req >> #mst_ep.sel >> #slv_ep4.gnt,
   #slv_ep5.req : mst_ep.req >> #mst_ep.sel >> #slv_ep5.gnt,
   #slv_ep6.req : mst_ep.req >> #mst_ep.sel >> #slv_ep6.gnt,
   #slv_ep7.req : mst_ep.req >> #mst_ep.sel >> #slv_ep7.gnt,
   #slv_ep8.req : mst_ep.req >> #mst_ep.sel >> #slv_ep8.gnt, 
   *
   ) >> #1;


proc rr_arbiter_v2 < Tp : type >(rr_arbiter_itfc) {
    reg curr : logic[2];
    loop {
        xoffer {
            a = recv slv_ep1.req => (send mst_ep.req(a) >> send mst_ep.sel(3'd0) >> send slv_ep1.gnt(1'd1)) , 
            b = recv slv_ep2.req => (send mst_ep.req(b) >> send mst_ep.sel(3'd1) >> send slv_ep2.gnt(1'd1)) ,
            c = recv slv_ep3.req => (send mst_ep.req(c) >> send mst_ep.sel(3'd2) >> send slv_ep3.gnt(1'd1)) ,
            d = recv slv_ep4.req => (send mst_ep.req(d) >> send mst_ep.sel(3'd3) >> send slv_ep4.gnt(1'd1)) ,
            e = recv slv_ep5.req => (send mst_ep.req(e) >> send mst_ep.sel(3'd4) >> send slv_ep5.gnt(1'd1)) ,
            f = recv slv_ep6.req => (send mst_ep.req(f) >> send mst_ep.sel(3'd5) >> send slv_ep6.gnt(1'd1)) ,
            g = recv slv_ep7.req => (send mst_ep.req(g) >> send mst_ep.sel(3'd6) >> send slv_ep7.gnt(1'd1)) ,
            h = recv slv_ep8.req => (send mst_ep.req(h) >> send mst_ep.sel(3'd7) >> send slv_ep8.gnt(1'd1)) ,
            # => ()
        } >>
        cycle 1
    }
}



proc rr_arbiter_v2_top(){
    chan slv_ep1_le -- slv_ep1_ri : arbiter_slave_ch<logic[32]>;
    chan slv_ep2_le -- slv_ep2_ri : arbiter_slave_ch<logic[32]>;
    chan slv_ep3_le -- slv_ep3_ri : arbiter_slave_ch<logic[32]>;
    chan slv_ep4_le -- slv_ep4_ri : arbiter_slave_ch<logic[32]>;
    chan slv_ep5_le -- slv_ep5_ri : arbiter_slave_ch<logic[32]>;
    chan slv_ep6_le -- slv_ep6_ri : arbiter_slave_ch<logic[32]>;
    chan slv_ep7_le -- slv_ep7_ri : arbiter_slave_ch<logic[32]>;
    chan slv_ep8_le -- slv_ep8_ri : arbiter_slave_ch<logic[32]>;
    chan mst_ep_le -- mst_ep_ri : arbiter_master_ch<logic[32]>;
    spawn rr_arbiter_v2<logic[32]>(slv_ep1_le, slv_ep2_le, slv_ep3_le, slv_ep4_le, slv_ep5_le, slv_ep6_le, slv_ep7_le, slv_ep8_le, mst_ep_le);

    loop{
        cycle 100 >>
        dfinish >>
        cycle 1
    }

}