chan fifo_ch<Tp : type> {
    left push : (Tp@#1),
    right pop : (Tp@#1) <<,
    right full : (logic@#1) @#1 - @dyn,
    right empty : (logic@#1) @dyn - @#1
}

interface fifo_itfc(ep : left fifo_ch<data_t>) =  ((ep.full >> ep.pop) + (ep.empty >> ep.push) + &(ep.push, ep.pop)) >> #1;
proc fifo < data_t : type, depth: int, address_depth : int>(fifo_itfc) {
    reg mem : data_t[depth];
    reg head : logic[address_depth];
    reg tail : logic[address_depth];
    reg full : logic;

    loop{
        if (*full == 1'b0 && *head != *tail){
            // can recieve both push and pop
            offer{
                inp = recv ep.push => {
                    set mem[*tail] := inp;
                    set tail := *tail + 3'd1;
                    if(((*tail + 3'd1) == *head) && ~(probe ep.pop)){
                        set full := 1'b1
                    }
                    else{
                        set full := 1'b0
                    }
                },
                send ep.pop(*mem[*head]) => {
                    set head := *head + 3'd1
                }  
            }
        }
        else{
            if(*full == 1'b1){
                send ep.full(1'b1) >>
                send ep.pop(*mem[*head]) >>
                set head := *head + 3'd1;
                set full := 1'b0
            }
            else{
                send ep.empty(1'b1) >>
                let inp = recv ep.push >>
                set mem[*tail] := inp;
                set tail := *tail + 3'd1
            }
        }
    }
}


proc fifo_v2(){
    chan ep_le -- ep_ri : fifo_ch<logic[32]>;
    spawn fifo<logic[32],8,3>(ep_le);
    loop{
        cycle 10 >>
        dfinish
    }
}