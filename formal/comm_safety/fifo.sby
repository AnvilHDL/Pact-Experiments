[options]
mode prove
depth 500
expect pass

[engines]
smtbmc yices

[script]
plugin -i slang
read_slang --single-unit --top comm_fifo_formal -D FORMAL_COMM_SAFETY -D COMMON_CELLS_ASSERTS_OFF -Icommon_cells/include common_cells/src/fifo_v3.sv formal/comm_safety/sv/comm_safety_common.sv
prep -top comm_fifo_formal

[files]
common_cells/include common_cells/include
common_cells/src/fifo_v3.sv common_cells/src/fifo_v3.sv
formal/comm_safety/sv/comm_safety_common.sv formal/comm_safety/sv/comm_safety_common.sv
