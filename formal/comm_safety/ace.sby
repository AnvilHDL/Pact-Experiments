[options]
mode prove
depth 400
expect pass

[engines]
smtbmc yices

[script]
plugin -i slang
read_slang --single-unit --top comm_ace_formal -D FORMAL_COMM_SAFETY -D COMMON_CELLS_ASSERTS_OFF -Iaxi/include -Iace/include axi/src/axi_pkg.sv ace/src/ace_pkg.sv ace/src/snoop_pkg.sv ace/src/ccu_fsm.sv ace/src/ccu_fsm_tb.sv formal/comm_safety/sv/comm_safety_tb_wrappers.sv
prep -top comm_ace_formal

[files]
axi/include axi/include
ace/include ace/include
axi/src/axi_pkg.sv axi/src/axi_pkg.sv
ace/src/ace_pkg.sv ace/src/ace_pkg.sv
ace/src/snoop_pkg.sv ace/src/snoop_pkg.sv
ace/src/ccu_fsm.sv ace/src/ccu_fsm.sv
ace/src/ccu_fsm_tb.sv ace/src/ccu_fsm_tb.sv
formal/comm_safety/sv/comm_safety_tb_wrappers.sv formal/comm_safety/sv/comm_safety_tb_wrappers.sv
