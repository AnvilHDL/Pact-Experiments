[options]
mode prove
depth 500
expect pass

[engines]
smtbmc yices

[script]
plugin -i slang
read_slang --single-unit --top comm_arbiter_formal -D FORMAL_COMM_SAFETY -D FORMAL_COMM_ARBITER_FULL_DESIGN -D COMMON_CELLS_ASSERTS_OFF src/testbenches/arbiter_test.sv formal/comm_safety/sv/comm_safety_common.sv
prep -top comm_arbiter_formal

[files]
src/testbenches/arbiter_test.sv src/testbenches/arbiter_test.sv
formal/comm_safety/sv/comm_safety_common.sv formal/comm_safety/sv/comm_safety_common.sv
